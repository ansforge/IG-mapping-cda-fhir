       fhir:v "http://hl7.org/cda/stds/core/StructureDefinition/ClinicalDocument|2.0.0-sd"^^xsd:anyURI ;
       fhir:link <http://hl7.org/cda/stds/core/StructureDefinition/ClinicalDocument|2.0.0-sd>
     ] ;
