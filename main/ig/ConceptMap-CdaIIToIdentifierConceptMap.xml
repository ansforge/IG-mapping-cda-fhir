  <description value="Correspondances entre les éléments du datatype CDA II et les éléments FHIR Identifier et Reference."/>
  <jurisdiction>
    <coding>
      <system value="urn:iso:std:iso:3166"/>
      <code value="FR"/>
      <display value="France (la)"/>
    </coding>
  </jurisdiction>
  <group>
    <source value="http://hl7.org/cda/stds/core/StructureDefinition/II"/>
    <sourceVersion value="2.0.0-sd"/>
    <target value="http://hl7.org/fhir/StructureDefinition/Identifier"/>
    <targetVersion value="4.0.1"/>
    <element>
      <code value="II.extension"/>
      <display value="Extension"/>
      <target>
        <code value="Identifier.value"/>
        <display value="The value that is unique"/>
        <equivalence value="equivalent"/>
        <comment value="Lorsque II.extension est présent, il alimente directement Identifier.value."/>
      </target>
    </element>
    <element>
      <code value="II.root"/>
      <display value="Root"/>
      <target>
        <code value="Identifier.system"/>
        <display value="The namespace for the identifier value"/>
        <equivalence value="relatedto"/>
        <comment value="II.root alimente Identifier.system après transformation en URI, par exemple sous la forme urn:oid:[II.root] ou urn:uuid:[II.root]."/>
      </target>
      <target>
        <code value="Identifier.value"/>
        <display value="The value that is unique"/>
        <equivalence value="relatedto"/>
        <comment value="En l’absence de II.extension, Identifier.value peut être dérivé de II.root, notamment lorsqu’il porte directement l’identifiant."/>
      </target>
    </element>
    <element>
      <code value="II.assigningAuthorityName"/>
      <display value="Assigning Authority Name"/>
      <target>
        <code value="Identifier.assigner"/>
        <display value="Organization that issued id (may be just text)"/>
        <equivalence value="relatedto"/>
        <comment value="II.assigningAuthorityName permet de renseigner l’organisme ayant attribué l’identifiant dans Identifier.assigner."/>
      </target>
    </element>
    <element>
      <code value="II.displayable"/>
      <display value="Displayable"/>
      <target>
        <code value="Identifier.extension"/>
        <display value="Additional content defined by implementations"/>
        <equivalence value="relatedto"/>
        <comment value="La valeur II.displayable peut être conservée dans une extension FHIR spécifique portée par Identifier."/>
      </target>
    </element>
  </group>
  <group>
    <source value="http://hl7.org/cda/stds/core/StructureDefinition/II"/>
    <sourceVersion value="2.0.0-sd"/>
    <target value="http://hl7.org/fhir/StructureDefinition/Reference"/>
    <targetVersion value="4.0.1"/>
    <element>
      <code value="II.assigningAuthorityName"/>
      <display value="Assigning Authority Name"/>
      <target>
        <code value="Reference.display"/>
        <display value="Text alternative for the resource"/>
        <equivalence value="relatedto"/>
        <comment value="Le nom de l’autorité d’attribution CDA alimente Reference.display dans la référence Identifier.assigner."/>
      </target>
    </element>
  </group>
