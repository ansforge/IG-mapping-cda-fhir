or: navy\">)</span><b> as </b><span style=\"color: maroon\">criterionCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          high<span style=\"color: navy\"><b> -&gt; </b></span>criterionCode.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            high<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/immunization-recommendation-date-criterion'</span> <i>\"system\"</i><span style=\"color: navy\">;</span>#xD;\n            high<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <span style=\"color: blue\">'latest'</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n            high<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Latest Date'</span> <i>\"display\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"coding\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n        high<span style=\"color: navy\"><b> -&gt; </b></span>dateCriterion.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">dateValue</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">dateValue</span><span style=\"color: navy\">)</span> <i>\"value\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"dateHigh\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dateCriterion\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Commentaire.</span>#xD;\n    sa.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then </b>PSPlanCommentToRecommendationDescription<span style=\"color: navy\">(</span><span style=\"color: maroon\">er</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">rec</span><span style=\"color: navy\">)</span> <i>\"comment\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"recommendation\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Lien CarePlan.</span>#xD;\n  sa<span style=\"color: navy\"><b> -&gt; </b></span> carePlan.supportingInfo = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">supportRef</span><span style=\"color: navy\">, </span> supportRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %recommendation.id<span style=\"color: navy\">)</span> <i>\"supportingInfo\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">TEXTES, COMMENTAIRES ET ABSENCE DE DONNÉES</span>#xD;\n<b>group </b>PSPlanTextToNote<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">text</span>, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Note par référence.</span>#xD;\n  text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span> tgt.note = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Annotation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">note</span><span style=\"color: navy\">, </span> note.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"reference\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Note texte.</span>#xD;\n  text.xmlText<b> as </b><span style=\"color: maroon\">xml</span><b> where </b>text.reference.empty()<span style=\"color: navy\"><b> -&gt; </b></span> tgt.note = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Annotation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">note</span><span style=\"color: navy\">, </span> note.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">xml</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanCommentToNote<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">er</span>, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Commentaire.</span>#xD;\n  er.act<b> as </b><span style=\"color: maroon\">act</span><b> where </b>er.typeCode = 'SUBJ'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>    act.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.32'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>        act.text<b> as </b><span style=\"color: maroon\">text</span><b> then </b>PSPlanTextToNote<span style=\"color: navy\">(</span><span style=\"color: maroon\">text</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"note\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"comment\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"template\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanTextToRecommendationDescription<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">text</span>, <b>target</b> <span style=\"color: maroon\">rec</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Description par référence.</span>#xD;\n  text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>rec.description = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"reference\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Description texte.</span>#xD;\n  text.xmlText<b> as </b><span style=\"color: maroon\">xml</span><b> where </b>text.reference.empty()<span style=\"color: navy\"><b> -&gt; </b></span>rec.description = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">xml</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanCommentToRecommendationDescription<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">er</span>, <b>target</b> <span style=\"color: maroon\">rec</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Commentaire.</span>#xD;\n  er.act<b> as </b><span style=\"color: maroon\">act</span><b> where </b>er.typeCode = 'SUBJ'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>    act.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.32'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>        act.text<b> as </b><span style=\"color: maroon\">text</span><b> then </b>PSPlanTextToRecommendationDescription<span style=\"color: navy\">(</span><span style=\"color: maroon\">text</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">rec</span><span style=\"color: navy\">)</span> <i>\"description\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"comment\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"template\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanCodeableConceptAbsentReason<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">cc</span><span style=\"color: navy\"> : </span>CodeableConcept<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Data absent reason.</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>cc.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n    src<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">9. ANTÉCÉDENTS FAMILIAUX -&gt; FamilyMemberHistory</span>#xD;\n<b>group </b>PatientSummaryFamilyHistorySection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Entrées.</span>#xD;\n  section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    entry.organizer<b> as </b><span style=\"color: maroon\">familyOrganizer</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">familyEntry</span><span style=\"color: navy\">, </span> familyEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'FamilyMemberHistory'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">familyHistory</span><span style=\"color: navy\">, </span> familyHistory.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> familyEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %familyHistory.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">Statut.</span>#xD;\n      familyOrganizer<span style=\"color: navy\"><b> -&gt; </b></span>familyHistory.status = <span style=\"color: blue\">'completed'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n      familyOrganizer.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>familyHistory.status = <span style=\"color: blue\">'completed'</span> <i>\"statusCompleted\"</i><span style=\"color: navy\">;</span>#xD;\n        statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>familyHistory.status = <span style=\"color: blue\">'partial'</span> <i>\"statusActive\"</i><span style=\"color: navy\">;</span>#xD;\n        statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>familyHistory.status = <span style=\"color: blue\">'entered-in-error'</span> <i>\"statusAborted\"</i><span style=\"color: navy\">;</span>#xD;\n        statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>familyHistory.status = <span style=\"color: blue\">'entered-in-error'</span> <i>\"statusCancelled\"</i><span style=\"color: navy\">;</span>#xD;\n        statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'suspended'<span style=\"color: navy\"><b> -&gt; </b></span>familyHistory.status = <span style=\"color: blue\">'partial'</span> <i>\"statusSuspended\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant.</span>#xD;\n      familyOrganizer.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>familyHistory.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">Patient.</span>#xD;\n      familyOrganizer<span style=\"color: navy\"><b> -&gt; </b></span> familyHistory.patient = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patientRef</span><span style=\"color: navy\">, </span> patientRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"patient\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">Lien familial.</span>#xD;\n      familyOrganizer.subject<b> as </b><span style=\"color: maroon\">subject</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        subject.relatedSubject<b> as </b><span style=\"color: maroon\">relatedSubject</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          <span style=\"color: navy\">// </span><span style=\"color: green\">Relation.</span>#xD;\n          relatedSubject.code<b> as </b><span style=\"color: maroon\">relationshipCode</span><span style=\"color: navy\"><b> -&gt; </b></span>familyHistory.relationship = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">relationship</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">relationshipCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">relationship</span><span style=\"color: navy\">)</span> <i>\"relationshipCode\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">// </span><span style=\"color: green\">Personne apparentée.</span>#xD;\n          relatedSubject.subject<b> as </b><span style=\"color: maroon\">relatedPerson</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            <span style=\"color: navy\">// </span><span style=\"color: green\">Sexe.</span>#xD;\n            relatedPerson.administrativeGenderCode<b> as </b><span style=\"color: maroon\">genderCode</span>