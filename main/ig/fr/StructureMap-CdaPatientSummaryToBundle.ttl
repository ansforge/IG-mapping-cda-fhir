tyle=\"color: navy\">, </span> practitionerEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitioner.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    assignedEntity<b> then </b>MapCDAAssignedEntityToPractitioner<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">)</span> <i>\"practitionerBase\"</i><span style=\"color: navy\">;</span>#xD;\n    assignedEntity<b> then </b>MapCDAAssignedEntityToFrenchPractitioner<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">)</span> <i>\"practitionerFR\"</i><span style=\"color: navy\">;</span>#xD;\n    assignedEntity.representedOrganization<b> as </b><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">organizationEntry</span><span style=\"color: navy\">, </span> organizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">organization</span><span style=\"color: navy\">, </span> organization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> organizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %organization.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">roleEntry</span><span style=\"color: navy\">, </span> roleEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'PractitionerRole'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">practitionerRole</span><span style=\"color: navy\">, </span> practitionerRole.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> roleEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitionerRole.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      representedOrganization<b> then </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">organization</span><span style=\"color: navy\">)</span> <i>\"organizationBase\"</i><span style=\"color: navy\">;</span>#xD;\n      representedOrganization<b> then </b>MapCDAOrganizationToFrenchOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">organization</span><span style=\"color: navy\">)</span> <i>\"organizationFR\"</i><span style=\"color: navy\">;</span>#xD;\n      assignedEntity<b> then </b>MapCDAAssignedEntityToPractitionerRole<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitionerRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">organization</span><span style=\"color: navy\">)</span> <i>\"roleBase\"</i><span style=\"color: navy\">;</span>#xD;\n      assignedEntity<b> then </b>MapCDAAssignedEntityToFrenchPractitionerRole<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitionerRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">organization</span><span style=\"color: navy\">)</span> <i>\"roleFR\"</i><span style=\"color: navy\">;</span>#xD;\n      assignedEntity<span style=\"color: navy\"><b> -&gt; </b></span> fhirProcedure.performer<b> as </b><span style=\"color: maroon\">performer</span><span style=\"color: navy\">, </span> performer.actor = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">actorRef</span><span style=\"color: navy\">, </span> actorRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitionerRole.id<span style=\"color: navy\">)</span> <i>\"performerRole\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"withOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n    assignedEntity<b> where </b>assignedEntity.representedOrganization.empty()<span style=\"color: navy\"><b> -&gt; </b></span> fhirProcedure.performer<b> as </b><span style=\"color: maroon\">performer</span><span style=\"color: navy\">, </span> performer.actor = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">actorRef</span><span style=\"color: navy\">, </span> actorRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitioner.id<span style=\"color: navy\">)</span> <i>\"performerPractitionerOnly\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"performer\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">4. TRAITEMENTS</span>#xD;\n<b>group </b>PatientSummaryMedicationSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Section traitements.</span>#xD;\n  section.templateId<b> as </b><span style=\"color: maroon\">sectionTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    sectionTid.root<b> as </b><span style=\"color: maroon\">sectionRoot</span><b> where </b>sectionRoot = '1.2.250.1.213.1.1.2.143'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        entry.substanceAdministration<b> as </b><span style=\"color: maroon\">substanceAdministration</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          substanceAdministration.templateId<b> as </b><span style=\"color: maroon\">treatmentTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            treatmentTid.root<b> as </b><span style=\"color: maroon\">treatmentRoot</span><b> where </b>treatmentRoot = '1.2.250.1.213.1.1.3.42'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">medicationStatementEntry</span><span style=\"color: navy\">, </span> medicationStatementEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'MedicationStatement'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">, </span> medicationStatement.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> medicationStatementEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %medicationStatement.id<span style=\"color: navy\">)</span><b> then </b>PatientSummaryMedicationStatementFromSubstanceAdministration<span style=\"color: navy\">(</span><span style=\"color: maroon\">substanceAdministration</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"medicationStatement\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"treatmentTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"medicationSection\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"sectionTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Administration CDA -&gt; MedicationStatement</span>#xD;\n<b>group </b>PatientSummaryMedicationStatementFromSubstanceAdministration<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">substanceAdministration</span>, <b>target</b> <span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\"> : </span>MedicationStatement, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Statut, patient et catégorie.</span>#xD;\n  substanceAdministration<span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.status = <span style=\"color: blue\">'unknown'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then </b>MedicationStatementStatusFromCdaStatus<span style=\"color: navy\">(</span><span style=\"color: maroon\">statusCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">)</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration<span style=\"color: navy\"><b> -&gt; </b></span> medicationStatement.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration.code<b> as </b><span style=\"color: maroon\">treatmentCode</span><span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">treatmentCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">category</span><span style=\"color: navy\">)</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Médicament, période et posologie.</span>#xD;\n  substanceAdministration.consumable<b> as </b><span style=\"color: maroon\">consumable</span><b> then </b>MedicationResourceFromConsumable<span style=\"color: navy\">(</span><span style=\"color: maroon\">consumable</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"medication\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then </b>MedicationStatementEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">)</span> <i>\"effective\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration<b> then </b>MedicationMainDosageFromSubstanceAdministration<span style=\"color: navy\">(</span><span style=\"color: maroon\">substanceAdministration</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">)</span> <i>\"mainDosage\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Motif et commentaire.</span>#xD;\n  substanceAdministration.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then </b>MedicationEntryRelationship<span style=\"color: navy\">(</span><span style=\"color: maroon\">er</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Posologies subordonnées.</span>#xD;\n  substanceAdministration.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> where </b>er.typeCode = 'COMP'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>    er.substanceAdministration<b> as </b><span style=\"color: maroon\">childAdministration</span><span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.dosage<b> as </b><span style=\"color: maroon\">childDosage</span><b> then </b>MedicationChildDosageFromSubstanceAdministration<span style=\"color: navy\">(</span><span style=\"color: maroon\">childAdministration</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">substanceAdministration</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">childDosage</span><span style=\"color: navy\">)</span> <i>\"childDosage\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"childTreatment\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Référence dans la section FHIR.</span>#xD;\n  substanceAdministration<span style=\"color: navy\"><b> -&gt; </b></span> compSection.entry = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">sectionRef</span><span style=\"color: navy\">, </span> sectionRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %medicationStatement.id<span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Statut CDA -&gt; MedicationStatement.status</span>#xD;\n<b>group </b>MedicationStatementStatusFromCdaStatus<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">statusCode</span>, <b>target</b> <span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\"> : </span>MedicationStatement<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.status = <span style=\"color: blue\">'completed'</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.status = <span style=\"color: blue\">'active'</span> <i>\"active\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.status = <span style=\"color: blue\">'stopped'</span> <i>\"aborted\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.status = <span style=\"color: blue\">'stopped'</span> <i>\"cancelled\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'suspended'<span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.status = <span style=\"color: blue\">'on-hold'</span> <i>\"suspended\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Produit de santé CDA -&gt; Medication + référence depuis MedicationStatement</span>#xD;\n<b>group </b>MedicationResourceFromConsumable<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">consumable</span>, <b>target</b> <span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\"> : </span>MedicationStatement, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  consumable.manufacturedProduct<b> as </b><span style=\"color: maroon\">manufacturedProduct</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    manufacturedProduct.manufacturedMaterial<b> as </b><span style=\"color: maroon\">manufacturedMaterial</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">medicationEntry</span><span style=\"color: navy\">, </span> medicationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Medication'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">medication</span><span style=\"color: navy\">, </span> medication.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> medicationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %medication.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      manufacturedMaterial<b> then </b>MedicationFromManufacturedMaterial<span style=\"color: navy\">(</span><span style=\"color: maroon\">manufacturedMaterial</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medication</span><span style=\"color: navy\">)</span> <i>\"medicationContent\"</i><span style=\"color: navy\">;</span>#xD;\n      manufacturedMaterial<span style=\"color: navy\"><b> -&gt; </b></span> medicationStatement.medication = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">medicationRef</span><span style=\"color: navy\">, </span> medicationRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %medication.id<span style=\"color: navy\">)</span> <i>\"medicationReference\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"medication\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Contenu du médicament</span>#xD;\n<b>group </b>MedicationFromManufacturedMaterial<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">manufacturedMaterial</span>, <b>target</b> <span style=\"color: maroon\">medication</span><span style=\"color: navy\"> : </span>Medication<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  manufacturedMaterial.code<b> as </b><span style=\"color: maroon\">medicationCode</span><span style=\"color: navy\"><b> -&gt; </b></span>medication.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">code</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">medicationCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">code</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  manufacturedMaterial.name<b> as </b><span style=\"color: maroon\">medicationName</span><b> where </b>manufacturedMaterial.code.empty()<span style=\"color: navy\"><b> -&gt; </b></span>medication.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    medicationName.xmlText<b> as </b><span style=\"color: maroon\">nameText</span><span style=\"color: navy\"><b> -&gt; </b></span>code.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">nameText</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"codeText\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"nameOnly\"</i><span style=\"color: navy\">;</span>#xD;\n  manufacturedMaterial.pharm:formCode<b> as </b><span style=\"color: maroon\">formCode</span><span style=\"color: navy\"><b> -&gt; </b></span>medication.form = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">form</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">formCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">form</span><span style=\"color: navy\">)</span> <i>\"form\"</i><span style=\"color: navy\">;</span>#xD;\n  manufacturedMaterial.pharm:ingredient<b> as </b><span style=\"color: maroon\">ingredient</span><b> then </b>MedicationIngredientFromPharmIngredient<span style=\"color: navy\">(</span><span style=\"color: maroon\">ingredient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medication</span><span style=\"color: navy\">)</span> <i>\"ingredient\"</i><span style=\"c