<https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaPatientSummaryToBundle> a fhir:StructureMap ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "CdaPatientSummaryToBundle"] ;
  fhir:Resource.language [ fhir:value "fr"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"fr\" lang=\"fr\"><hr/><p><b>French</b></p><hr/><p class=\"res-header-id\"><b>Narratif généré : StructureMap CdaPatientSummaryToBundle</b></p><a name=\"CdaPatientSummaryToBundle\"> </a><a name=\"hcCdaPatientSummaryToBundle\"> </a><pre class=\"fml\">#xD;\n<b>map</b><span style=\"color: navy\"> \"</span>https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaPatientSummaryToBundle<span style=\"color: navy\">\" = \"</span>CdaPatientSummaryToBundle<span style=\"color: navy\">\"#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Mapping CDA Patient Summary vers FHIR - Étape 4 finale</span>#xD;\n#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-ClinicalDocument.html\" title=\"ClinicalDocument (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/ClinicalDocument|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>ClinicalDocument <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-PatientRole.html\" title=\"PatientRole (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/PatientRole|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>PatientRole <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-RelatedEntity.html\" title=\"RelatedEntity (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/RelatedEntity|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>RelatedEntity <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-EncompassingEncounter.html\" title=\"EncompassingEncounter (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/EncompassingEncounter|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>EncompassingEncounter <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-HealthCareFacility.html\" title=\"HealthCareFacility (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/HealthCareFacility|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>HealthCareFacility <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/bundle.html\" title=\"Bundle\">http://hl7.org/fhir/StructureDefinition/Bundle|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Bundle <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/composition.html\" title=\"Composition\">http://hl7.org/fhir/StructureDefinition/Composition|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Composition <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/patient.html\" title=\"Patient\">http://hl7.org/fhir/StructureDefinition/Patient|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Patient <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/organization.html\" title=\"Organization\">http://hl7.org/fhir/StructureDefinition/Organization|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Organization <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/practitioner.html\" title=\"Practitioner\">http://hl7.org/fhir/StructureDefinition/Practitioner|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Practitioner <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/practitionerrole.html\" title=\"PractitionerRole\">http://hl7.org/fhir/StructureDefinition/PractitionerRole|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>PractitionerRole <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/relatedperson.html\" title=\"RelatedPerson\">http://hl7.org/fhir/StructureDefinition/RelatedPerson|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>RelatedPerson <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/encounter.html\" title=\"Encounter\">http://hl7.org/fhir/StructureDefinition/Encounter|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Encounter <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/location.html\" title=\"Location\">http://hl7.org/fhir/StructureDefinition/Location|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Location <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/condition.html\" title=\"Condition\">http://hl7.org/fhir/StructureDefinition/Condition|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Condition <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/allergyintolerance.html\" title=\"AllergyIntolerance\">http://hl7.org/fhir/StructureDefinition/AllergyIntolerance|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>AllergyIntolerance <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/adverseevent.html\" title=\"AdverseEvent\">http://hl7.org/fhir/StructureDefinition/AdverseEvent|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>AdverseEvent <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/medication.html\" title=\"Medication\">http://hl7.org/fhir/StructureDefinition/Medication|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Medication <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/medicationstatement.html\" title=\"MedicationStatement\">http://hl7.org/fhir/StructureDefinition/MedicationStatement|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>MedicationStatement <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/procedure.html\" title=\"Procedure\">http://hl7.org/fhir/StructureDefinition/Procedure|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Procedure <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/immunization.html\" title=\"Immunization\">http://hl7.org/fhir/StructureDefinition/Immunization|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Immunization <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/observation.html\" title=\"Observation\">http://hl7.org/fhir/StructureDefinition/Observation|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Observation <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/careplan.html\" title=\"CarePlan\">http://hl7.org/fhir/StructureDefinition/CarePlan|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>CarePlan <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/documentreference.html\" title=\"DocumentReference\">http://hl7.org/fhir/StructureDefinition/DocumentReference|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>DocumentReference <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/diagnosticreport.html\" title=\"DiagnosticReport\">http://hl7.org/fhir/StructureDefinition/DiagnosticReport|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>DiagnosticReport <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/medicationrequest.html\" title=\"MedicationRequest\">http://hl7.org/fhir/StructureDefinition/MedicationRequest|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>MedicationRequest <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/servicerequest.html\" title=\"ServiceRequest\">http://hl7.org/fhir/StructureDefinition/ServiceRequest|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>ServiceRequest <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/immunizationrecommendation.html\" title=\"ImmunizationRecommendation\">http://hl7.org/fhir/StructureDefinition/ImmunizationRecommendation|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>ImmunizationRecommendation <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/familymemberhistory.html\" title=\"FamilyMemberHistory\">http://hl7.org/fhir/StructureDefinition/FamilyMemberHistory|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>FamilyMemberHistory <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Identifier\" title=\"Identifier\">http://hl7.org/fhir/StructureDefinition/Identifier|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Identifier <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#CodeableConcept\" title=\"CodeableConcept\">http://hl7.org/fhir/StructureDefinition/CodeableConcept|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>CodeableConcept <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Coding\" title=\"Coding\">http://hl7.org/fhir/StructureDefinition/Coding|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Coding <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/references.html#Reference\" title=\"Reference\">http://hl7.org/fhir/StructureDefinition/Reference|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Reference <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Period\" title=\"Period\">http://hl7.org/fhir/StructureDefinition/Period|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Period <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Attachment\" title=\"Attachment\">http://hl7.org/fhir/StructureDefinition/Attachment|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Attachment <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Narrative\" title=\"Narrative\">http://hl7.org/fhir/StructureDefinition/Narrative|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Narrative <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Timing\" title=\"Timing\">http://hl7.org/fhir/StructureDefinition/Timing|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Timing <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Range\" title=\"Range\">http://hl7.org/fhir/StructureDefinition/Range|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Range <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Quantity\" title=\"Quantity\">http://hl7.org/fhir/StructureDefinition/Quantity|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Quantity <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Ratio\" title=\"Ratio\">http://hl7.org/fhir/StructureDefinition/Ratio|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Ratio <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Annotation\" title=\"Annotation\">http://hl7.org/fhir/StructureDefinition/Annotation|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Annotation <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#code\" title=\"code\">http://hl7.org/fhir/StructureDefinition/code|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>code <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#date\" title=\"date\">http://hl7.org/fhir/StructureDefinition/date|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>date <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#dateTime\" title=\"dateTime\">http://hl7.org/fhir/StructureDefinition/dateTime|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>dateTime <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#boolean\" title=\"boolean\">http://hl7.org/fhir/StructureDefinition/boolean|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>boolean <b>as </b><b>target</b>#xD;\n#xD;\n<b>imports</b><span style=\"color: navy\"> \"</span><a href=\"StructureMap-CdaToFHIRTypes.html\" title=\"Mapping de CDA vers les FHIR Types (A partir des sources de Oliver Egger)\">https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaToFHIRTypes|0.1.0</a><span style=\"color: navy\">\"#xD;\n</span><b>imports</b><span style=\"color: navy\"> \"</span><a href=\"StructureMap-CdaToBundle.html\" title=\"Mapping CDA vers FHIR - Étape 2 socle générique orienté CDA\">https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaToBundle</a><span style=\"color: navy\">\"#xD;\n</span><b>imports</b><span style=\"color: navy\"> \"</span><a href=\"StructureMap-CdaFrToBundle.html\" title=\"Mapping CDA-FR vers FHIR - Socle enrichi français\">https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaFrToBundle|0.1.0</a><span style=\"color: navy\">\"#xD;\n</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE D’ENTRÉE — CRÉATION DU BUNDLE FINAL PATIENT SUMMARY</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe crée le Bundle final avec Composition et Patient. Ces ressources</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   sont toujours nécessaires dans un document FHIR de type document.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Les autres ressources administratives sont créées plus loin, uniquement si le</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   bloc CDA correspondant existe</span>#xD;\n<b>group </b>TransformPatientSummaryClinicalDocumentToFHIRDocument<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">cda</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  cda<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">compositionEntry</span><span style=\"color: navy\">, </span> compositionEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Composition'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span> composition.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> compositionEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %composition.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">patientEntry</span><span style=\"color: navy\">, </span> patientEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Patient'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span> patient.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> patientEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span><b> then </b>OrchestrateClinicalDocumentFinalTransformation<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"main\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE D’ORCHESTRATION FINALE — SOCLE FRANÇAIS + MÉTIER PATIENT SUMMARY</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe applique deux traitements successifs :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - MapClinicalDocumentHeaderWithFrenchRules, importé depuis l’étape 3, traite</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     l’en-tête CDA, crée les ressources administratives nécessaires, applique le</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     socle générique de l’étape 2 et l’enrichissement français ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - MapPatientSummaryBody traite ensuite les sections Patient Summary et crée</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     les ressources métier à partir des entries CDA.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Les ressources optionnelles ne sont donc pas créées au début : elles sont</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   créées uniquement dans les groupes associés aux blocs CDA présents</span>#xD;\n<b>group </b>OrchestrateClinicalDocumentFinalTransformation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">cda</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument.header -&gt; socle générique + enrichissement français + création interne des ressources administratives</span>#xD;\n  cda<b> then </b>MapClinicalDocumentHeaderWithFrenchRules<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"headerFrenchBase\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA structuredBody Patient Summary -&gt; FHIR Composition.section + entries métier</span>#xD;\n  cda<b> then </b>MapPatientSummaryBody<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"patientSummaryBody\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CORPS PATIENT SUMMARY — SECTIONS + ENTRIES MÉTIER</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Pour chaque section CDA :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - MapCDASectionToCompositionSection, importé depuis l’étape 2, crée le</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     squelette commun de la Composition.section avec title, code et text ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - MapPatientSummarySectionEntries crée ensuite les ressources métier selon</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     le code LOINC de la section</span>#xD;\n<b>group </b>MapPatientSummaryBody<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.component<b> as </b><span style=\"color: maroon\">cdaComponent</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    cdaComponent.structuredBody<b> as </b><span style=\"color: maroon\">structuredBody</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      structuredBody.component<b> as </b><span style=\"color: maroon\">bodyComponent</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        bodyComponent.section<b> as </b><span style=\"color: maroon\">section</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.section<b> as </b><span style=\"color: maroon\">compSection</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section.title/code/text -&gt; FHIR Composition.section</span>#xD;\n          section<b> then </b>MapCDASectionToCompositionSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">)</span> <i>\"sectionBase\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section.entry -&gt; FHIR ressources métier Patient Summary</span>#xD;\n          section<b> then </b>MapPatientSummarySectionEntries<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"patientSummaryEntries\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"bodyComponent\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">DISPATCH DES ENTRIES MÉTIER PATIENT SUMMARY</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   CDA section.code LOINC -&gt; groupe métier FHIR correspondant</span>#xD;\n<b>group </b>MapPatientSummarySectionEntries<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Problèmes actifs -&gt; FHIR Condition</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '11450-4'<b> then </b>PatientSummaryConditionSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"activeProblems\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Antécédents médicaux -&gt; FHIR Condition</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '11348-0'<b> then </b>PatientSummaryConditionSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"medicalHistory\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Allergies / hypersensibilités -&gt; FHIR AllergyIntolerance</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '48765-2'<b> then </b>PatientSummaryAllergySection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"allergies\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Traitements -&gt; FHIR MedicationStatement</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '10160-0'<b> then </b>PatientSummaryMedicationSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"medications\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Historique des actes -&gt; FHIR Procedure</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '47519-4'<b> then </b>PatientSummaryProcedureSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"procedureHistory\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Effets indésirables médicamenteux -&gt; AdverseEvent + MedicationStatement + Condition.</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '44939-7'<b> then </b>PatientSummaryAdverseDrugReactionSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"adverseDrugReactions\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Vaccinations -&gt; FHIR Immunization</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '11369-6'<b> then </b>PatientSummaryImmunizationSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"immunizations\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Statut fonctionnel -&gt; FHIR Observation</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '47420-5'<b> then </b>PatientSummaryFunctionalStatusSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"functionalStatus\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Constantes -&gt; FHIR Observation</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '8716-3'<b> then </b>PatientSummaryVitalSignsSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"vitalSigns\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Mode de vie -&gt; FHIR Observation</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '29762-2'<b> then </b>PatientSummaryLifestyleSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"lifestyle\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Facteurs de risques professionnels -&gt; Observation si entrée structurée, sinon narratif seul.</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '10161-8'<b> then </b>PatientSummaryProfessionalRisksSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"professionalRisks\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Résultats -&gt; FHIR Observation</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '30954-2'<b> then </b>PatientSummaryResultsSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"results\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Plan de soins -&gt; FHIR CarePlan</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '18776-5'<b> then </b>PatientSummaryCarePlanSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"carePlan\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section Antécédents familiaux -&gt; FHIR FamilyMemberHistory</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">secCode</span><b> where </b>secCode.code = '10157-6'<b> then </b>PatientSummaryFamilyHistorySection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"familyHistory\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Dispositifs médicaux : section conservée en narratif uniquement pour l’instant.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Le mapping structuré sera traité plus tard avec Device / DeviceUseStatement.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Points de vigilance : section conservée en narratif uniquement pour l’instant.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Le mapping structuré sera traité plus tard avec Flag, DetectedIssue ou Observation selon le contenu.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Directives anticipées : section conservée en narratif uniquement pour l’instant.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Le mapping structuré sera traité plus tard avec Consent, Observation ou DocumentReference selon le contenu.</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">1. PROBLÈMES ACTIFS ET ANTÉCÉDENTS MÉDICAUX</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Section CDA problèmes / antécédents -&gt; Conditions FHIR</span>#xD;\n<b>group </b>PatientSummaryConditionSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Entrées CDA -&gt; observations de problèmes -&gt; Condition.</span>#xD;\n  section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    entry.act<b> as </b><span style=\"color: maroon\">problemConcernAct</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      problemConcernAct.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        er.observation<b> as </b><span style=\"color: maroon\">problemObservation</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">conditionEntry</span><span style=\"color: navy\">, </span> conditionEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Condition'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">condition</span><span style=\"color: navy\">, </span> condition.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> conditionEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %condition.id<span style=\"color: navy\">)</span><b> then </b>PatientSummaryConditionFromProblemObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">problemObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">condition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"conditionFromProblemObservation\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"problemEntryRelationship\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"problemConcernAct\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Observation CDA de problème -&gt; Condition FHIR</span>#xD;\n<b>group </b>PatientSummaryConditionFromProblemObservation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">observation</span>, <b>target</b> <span style=\"color: maroon\">condition</span><span style=\"color: navy\"> : </span>Condition, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Patient concerné.</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span> condition.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant du problème.</span>#xD;\n  observation.id<b> as </b><span style=\"color: maroon\">problemId</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">problemId</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Catégorie / type du problème.</span>#xD;\n  observation.code<b> as </b><span style=\"color: maroon\">problemType</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    problemType<b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">problemType</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">category</span><span style=\"color: navy\">)</span> <i>\"categoryCoding\"</i><span style=\"color: navy\">;</span>#xD;\n    observation.text<b> as </b><span style=\"color: maroon\">txt</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      txt.reference<b> as </b><span style=\"color: maroon\">ref</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        ref.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>category.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"categoryText\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Problème médical.</span>#xD;\n  observation.value<b> as </b><span style=\"color: maroon\">problemValue</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">code</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">problemValue</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">code</span><span style=\"color: navy\">)</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Dates de début et de fin.</span>#xD;\n  observation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.onset = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">onsetDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">onsetDateTime</span><span style=\"color: navy\">)</span> <i>\"onsetDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.abatement = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">abatementDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">abatementDateTime</span><span style=\"color: navy\">)</span> <i>\"abatementDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Sous-observations : sévérité, statut, stade et certitude.</span>#xD;\n  observation.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">Sévérité -&gt; Condition.severity.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">severityObs</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      severityObs.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.29'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          severityObs.value<b> as </b><span style=\"color: maroon\">severityValue</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.severity = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">severity</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">severityValue</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">severity</span><span style=\"color: navy\">)</span> <i>\"severity\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"severity\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"severityTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"severityBlock\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Statut du problème -&gt; Condition.clinicalStatus.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">problemStatusObs</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      problemStatusObs.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.30'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          problemStatusObs.value<b> as </b><span style=\"color: maroon\">statusValue</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.clinicalStatus = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">clinicalStatus</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            statusValue.displayName<b> as </b><span style=\"color: maroon\">display</span><span style=\"color: navy\"><b> -&gt; </b></span>clinicalStatus.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">display</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"clinicalStatusText\"</i><span style=\"color: navy\">;</span>#xD;\n            statusValue.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>clinicalStatus.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>              statusValue<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/condition-clinical'</span> <i>\"clinicalStatusSystem\"</i><span style=\"color: navy\">;</span>#xD;\n              code<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"clinicalStatusCode\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Active'</span> <i>\"clinicalStatusDisplayActive\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'recurrence'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Recurrence'</span> <i>\"clinicalStatusDisplayRecurrence\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'relapse'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Relapse'</span> <i>\"clinicalStatusDisplayRelapse\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'inactive'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Inactive'</span> <i>\"clinicalStatusDisplayInactive\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'remission'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Remission'</span> <i>\"clinicalStatusDisplayRemission\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'resolved'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Resolved'</span> <i>\"clinicalStatusDisplayResolved\"</i><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span> <i>\"clinicalStatusCoding\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"clinicalStatus\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"clinicalStatus\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"clinicalStatusTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"clinicalStatusBlock\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">État / stade clinique -&gt; Condition.stage.summary.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">healthStatusObs</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      healthStatusObs.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.31'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          healthStatusObs.value<b> as </b><span style=\"color: maroon\">healthStatusValue</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.stage<b> as </b><span style=\"color: maroon\">stage</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            healthStatusValue<span style=\"color: navy\"><b> -&gt; </b></span>stage.summary = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">summary</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">healthStatusValue</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">summary</span><span style=\"color: navy\">)</span> <i>\"stageSummary\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"stage\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"stageSummary\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"stageSummaryTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"stageSummaryBlock\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Certitude -&gt; Condition.verificationStatus.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">certaintyObs</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      certaintyObs.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.171'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          certaintyObs.value<b> as </b><span style=\"color: maroon\">certaintyValue</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.verificationStatus = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">verificationStatus</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            certaintyValue.displayName<b> as </b><span style=\"color: maroon\">display</span><span style=\"color: navy\"><b> -&gt; </b></span>verificationStatus.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">display</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"verificationStatusText\"</i><span style=\"color: navy\">;</span>#xD;\n            certaintyValue.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>verificationStatus.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>              certaintyValue<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/condition-ver-status'</span> <i>\"verificationStatusSystem\"</i><span style=\"color: navy\">;</span>#xD;\n              code<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"verificationStatusCode\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'unconfirmed'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Unconfirmed'</span> <i>\"verificationStatusDisplayUnconfirmed\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'provisional'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Provisional'</span> <i>\"verificationStatusDisplayProvisional\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'differential'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Differential'</span> <i>\"verificationStatusDisplayDifferential\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'confirmed'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Confirmed'</span> <i>\"verificationStatusDisplayConfirmed\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'refuted'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Refuted'</span> <i>\"verificationStatusDisplayRefuted\"</i><span style=\"color: navy\">;</span>#xD;\n              code<b> where </b>code = 'entered-in-error'<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Entered in Error'</span> <i>\"verificationStatusDisplayEnteredInError\"</i><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span> <i>\"verificationStatusCoding\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"verificationStatus\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"verificationStatus\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"verificationStatusTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"verificationStatusBlock\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"entryRelationships\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Document externe lié au problème -&gt; DocumentReference + evidence.</span>#xD;\n  observation.reference<b> as </b><span style=\"color: maroon\">cdaReference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    cdaReference.externalDocument<b> as </b><span style=\"color: maroon\">externalDocument</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">documentReferenceEntry</span><span style=\"color: navy\">, </span> documentReferenceEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'DocumentReference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">documentReference</span><span style=\"color: navy\">, </span> documentReference.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> documentReferenceEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %documentReference.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      externalDocument<span style=\"color: navy\"><b> -&gt; </b></span>documentReference.status = <span style=\"color: blue\">'current'</span> <i>\"documentReferenceStatus\"</i><span style=\"color: navy\">;</span>#xD;\n      externalDocument<span style=\"color: navy\"><b> -&gt; </b></span> documentReference.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"documentReferenceSubject\"</i><span style=\"color: navy\">;</span>#xD;\n      externalDocument.id<b> as </b><span style=\"color: maroon\">externalId</span><span style=\"color: navy\"><b> -&gt; </b></span>documentReference.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">externalId</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"documentReferenceIdentifier\"</i><span style=\"color: navy\">;</span>#xD;\n      externalDocument.text<b> as </b><span style=\"color: maroon\">externalText</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        externalText.reference<b> as </b><span style=\"color: maroon\">externalRef</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          externalRef.value<b> as </b><span style=\"color: maroon\">url</span><span style=\"color: navy\"><b> -&gt; </b></span>documentReference.content<b> as </b><span style=\"color: maroon\">content</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            url<span style=\"color: navy\"><b> -&gt; </b></span>content.attachment = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Attachment'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">attachment</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>              url<span style=\"color: navy\"><b> -&gt; </b></span>attachment.url = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">url</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"attachmentUrl\"</i><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span> <i>\"attachment\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"content\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"externalTextReference\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"externalText\"</i><span style=\"color: navy\">;</span>#xD;\n      externalDocument<span style=\"color: navy\"><b> -&gt; </b></span>condition.evidence<b> as </b><span style=\"color: maroon\">evidence</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        externalDocument<span style=\"color: navy\"><b> -&gt; </b></span> evidence.detail = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">detailRef</span><span style=\"color: navy\">, </span> detailRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %documentReference.id<span style=\"color: navy\">)</span> <i>\"evidenceDetail\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"evidence\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"externalDocumentReference\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"externalReference\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Référence de la Condition dans la Composition.section.</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span> compSection.entry = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">sectionRef</span><span style=\"color: navy\">, </span> sectionRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %condition.id<span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">2. ALLERGIES / HYPERSENSIBILITÉS</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Section CDA allergies / hypersensibilités -&gt; AllergyIntolerance</span>#xD;\n<b>group </b>PatientSummaryAllergySection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Section allergies.</span>#xD;\n  section.templateId<b> as </b><span style=\"color: maroon\">sectionTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    sectionTid.root<b> as </b><span style=\"color: maroon\">sectionRoot</span><b> where </b>sectionRoot = '1.2.250.1.213.1.1.2.137'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        entry.act<b> as </b><span style=\"color: maroon\">allergyConcernAct</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          allergyConcernAct.templateId<b> as </b><span style=\"color: maroon\">actTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            actTid.root<b> as </b><span style=\"color: maroon\">actRoot</span><b> where </b>actRoot = '1.2.250.1.213.1.1.3.40'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>              allergyConcernAct.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>                er.observation<b> as </b><span style=\"color: maroon\">allergyObservation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>                  allergyObservation.templateId<b> as </b><span style=\"color: maroon\">obsTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>                    obsTid.root<b> as </b><span style=\"color: maroon\">obsRoot</span><b> where </b>obsRoot = '1.2.250.1.213.1.1.3.41'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">allergyEntry</span><span style=\"color: navy\">, </span> allergyEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'AllergyIntolerance'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">allergy</span><span style=\"color: navy\">, </span> allergy.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> allergyEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %allergy.id<span style=\"color: navy\">)</span><b> then </b>AllergyFromCdaObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">allergyObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">allergy</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"allergyFromCdaObservation\"</i><span style=\"color: navy\">;</span>#xD;\n                  <span style=\"color: navy\">}</span> <i>\"allergyObservationTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n                <span style=\"color: navy\">}</span> <i>\"allergyObservation\"</i><span style=\"color: navy\">;</span>#xD;\n              <span style=\"color: navy\">}</span> <i>\"allergyEntryRelationship\"</i><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span> <i>\"frAllergyConcernAct\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"allergyConcernActTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"allergyConcernAct\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"frAllergySection\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"sectionTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Observation CDA d’allergie -&gt; AllergyIntolerance</span>#xD;\n<b>group </b>AllergyFromCdaObservation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">observation</span>, <b>target</b> <span style=\"color: maroon\">allergy</span><span style=\"color: navy\"> : </span>AllergyIntolerance, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant et patient.</span>#xD;\n  observation.id<b> as </b><span style=\"color: maroon\">allergyId</span><span style=\"color: navy\"><b> -&gt; </b></span>allergy.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">allergyId</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span> allergy.patient = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patientRef</span><span style=\"color: navy\">, </span> patientRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"patient\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Agent responsable.</span>#xD;\n  observation.participant<b> as </b><span style=\"color: maroon\">participant</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    participant.participantRole<b> as </b><span style=\"color: maroon\">participantRole</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      participantRole.playingEntity<b> as </b><span style=\"color: maroon\">playingEntity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        playingEntity.code<b> as </b><span style=\"color: maroon\">allergenCode</span><span style=\"color: navy\"><b> -&gt; </b></span>allergy.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">code</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">allergenCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">code</span><span style=\"color: navy\">)</span> <i>\"allergenCode\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Type et catégorie.</span>#xD;\n  observation.code<b> as </b><span style=\"color: maroon\">allergyTypeCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    allergyTypeCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = '416098002'<span style=\"color: navy\"><b> -&gt; </b></span> allergy.type = <span style=\"color: blue\">'allergy'</span><span style=\"color: navy\">, </span> allergy.category = <span style=\"color: blue\">'medication'</span> <i>\"medicationAllergyByCode\"</i><span style=\"color: navy\">;</span>#xD;\n    allergyTypeCode.displayName<b> as </b><span style=\"color: maroon\">display</span><b> where </b>display.lower().contains('intolérance') or display.lower().contains('intolerance')<span style=\"color: navy\"><b> -&gt; </b></span>allergy.type = <span style=\"color: blue\">'intolerance'</span> <i>\"typeIntolerance\"</i><span style=\"color: navy\">;</span>#xD;\n    allergyTypeCode.displayName<b> as </b><span style=\"color: maroon\">display</span><b> where </b>(allergyTypeCode.code != '416098002') and (display.lower().contains('allergie') or display.lower().contains('hypersensibilité') or display.lower().contains('hypersensibilite')) and display.lower().contains('intolérance').not() and display.lower().contains('intolerance').not()<span style=\"color: navy\"><b> -&gt; </b></span>allergy.type = <span style=\"color: blue\">'allergy'</span> <i>\"typeAllergy\"</i><span style=\"color: navy\">;</span>#xD;\n    allergyTypeCode.displayName<b> as </b><span style=\"color: maroon\">display</span><b> where </b>(allergyTypeCode.code != '416098002') and (display.lower().contains('médicament') or display.lower().contains('medicament') or display.lower().contains('médicamenteuse') or display.lower().contains('medicamenteuse'))<span style=\"color: navy\"><b> -&gt; </b></span>allergy.category = <span style=\"color: blue\">'medication'</span> <i>\"categoryMedicationByDisplay\"</i><span style=\"color: navy\">;</span>#xD;\n    allergyTypeCode.displayName<b> as </b><span style=\"color: maroon\">display</span><b> where </b>display.lower().contains('alimentaire') or display.lower().contains('aliment') or display.lower().contains('nourriture')<span style=\"color: navy\"><b> -&gt; </b></span>allergy.category = <span style=\"color: blue\">'food'</span> <i>\"categoryFood\"</i><span style=\"color: navy\">;</span>#xD;\n    allergyTypeCode.displayName<b> as </b><span style=\"color: maroon\">display</span><b> where </b>display.lower().contains('environnement') or display.lower().contains('pollen') or display.lower().contains('poussière') or display.lower().contains('poussiere') or display.lower().contains('latex')<span style=\"color: navy\"><b> -&gt; </b></span>allergy.category = <span style=\"color: blue\">'environment'</span> <i>\"categoryEnvironment\"</i><span style=\"color: navy\">;</span>#xD;\n    allergyTypeCode.displayName<b> as </b><span style=\"color: maroon\">display</span><b> where </b>display.lower().contains('biologique') or display.lower().contains('vaccin') or display.lower().contains('sérum') or display.lower().contains('serum')<span style=\"color: navy\"><b> -&gt; </b></span>allergy.category = <span style=\"color: blue\">'biologic'</span> <i>\"categoryBiologic\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"typeAndCategory\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Date de début.</span>#xD;\n  observation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>allergy.onset = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">onsetDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">onsetDateTime</span><span style=\"color: navy\">)</span> <i>\"onsetDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Sous-observations.</span>#xD;\n  observation.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">Statut clinique.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">statusObs</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      statusObs.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.30'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          statusObs.value<b> as </b><span style=\"color: maroon\">statusValue</span><span style=\"color: navy\"><b> -&gt; </b></span>allergy.clinicalStatus = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">clinicalStatus</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            statusValue.originalText<b> as </b><span style=\"color: maroon\">originalText</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>              originalText.reference<b> as </b><span style=\"color: maroon\">ref</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>                ref.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>clinicalStatus.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"textFromOriginalTextReference\"</i><span style=\"color: navy\">;</span>#xD;\n              <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n              originalText.xmlText<b> as </b><span style=\"color: maroon\">txt</span><b> where </b>originalText.reference.empty()<span style=\"color: navy\"><b> -&gt; </b></span>clinicalStatus.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">txt</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"textFromOriginalText\"</i><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n            statusValue.displayName<b> as </b><span style=\"color: maroon\">display</span><b> where </b>statusValue.originalText.empty()<span style=\"color: navy\"><b> -&gt; </b></span>clinicalStatus.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">display</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"textFromDisplayName\"</i><span style=\"color: navy\">;</span>#xD;\n            statusValue.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>(code = 'active') or (code = 'actif')<span style=\"color: navy\"><b> -&gt; </b></span>clinicalStatus.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"colo