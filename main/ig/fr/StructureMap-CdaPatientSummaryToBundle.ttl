pan> <i>\"categoryDisplay\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"categoryCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">obsCode</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">obsCode</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation.text<b> as </b><span style=\"color: maroon\">text</span><b> then </b>ResultObservationNoteFromText<span style=\"color: navy\">(</span><span style=\"color: maroon\">text</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">)</span> <i>\"textNote\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then </b>ObservationEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation<b> where </b>observation.effectiveTime.empty()<span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observation<span style=\"color: navy\"><b> -&gt; </b></span>effectiveDateTime.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"effectiveTimeAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.value<b> as </b><span style=\"color: maroon\">value</span><b> then </b>ResultObservationValueFromCdaValue<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation.interpretationCode<b> as </b><span style=\"color: maroon\">interpretationCode</span><span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.interpretation = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">interpretation</span><b> then </b>CDCodeableConcept<span style=\"color: 