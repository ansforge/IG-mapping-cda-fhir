oon\">code</span><b> where </b>value.unit.empty()<span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">)</span> <i>\"valueCodeableConcept\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'true')<span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"valueBooleanTrue\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'false')<span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"valueBooleanFalse\"</i><span style=\"color: navy\">;</span>#xD;\n  value.originalText<b> as </b><span style=\"color: maroon\">originalText</span><b> where </b>value.unit.empty() and value.code.empty()<b> then</b><span style=\"color: navy\"> {#xD;\n</span>    originalText.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      reference.value<b> as </b><span style=\"color: maroon\">text</span><span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">text</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"valueStringFromOriginalText\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ResultObservationNoteFromText<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">text</span>, <b>target</b> <span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span> resultObservation.note = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Annotation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">note</span><span style=\"color: navy\">, </span> note.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"noteReference\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  text.xmlText<b> as </b><span style=\"color: maroon\">xml</span><b> where </b>text.reference.empty()<span style=\"color: navy\"><b> -&gt; </b></span> resultObservation.note = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Annotation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">note</span><span style=\"color: navy\">, </span> note.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">xml</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"noteText\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ResultObservationEntryRelationship<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">er</span>, <b>target</b> <span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  er.act<b> as </b><span style=\"color: maroon\">commentAct</span><b> then </b>ResultObservationNoteFromCommentAct<span style=\"color: navy\">(</span><span style=\"color: maroon\">commentAct</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">)</span> <i>\"comment\"</i><span style=\"color: navy\">;</span>#xD;\n  er.observation<b> as </b><span style=\"color: maroon\">memberObservation</span><b> where </b>er.typeCode = 'COMP'<span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.hasMember = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">memberRef</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    memberObservation.id<b> as </b><span style=\"color: maroon\">id</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      id.extension<b> as </b><span style=\"color: maroon\">extension</span><span style=\"color: navy\"><b> -&gt; </b></span>memberRef.reference = <span style=\"color: navy\">(</span>'#' + extension<span style=\"color: navy\">)</span> <i>\"memberReferenceExtension\"</i><span style=\"color: navy\">;</span>#xD;\n      id.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>id.extension.empty()<span style=\"color: navy\"><b> -&gt; </b></span>memberRef.reference = <span style=\"color: navy\">(</span>'urn:oid:' + root<span style=\"color: navy\">)</span> <i>\"memberReferenceRoot\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"memberId\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"hasMember\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ResultObservationNoteFromCommentAct<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">commentAct</span>, <b>target</b> <span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  commentAct.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.32'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      commentAct.text<b> as </b><span style=\"color: maroon\">text</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span> resultObservation.note = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Annotation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">note</span><span style=\"color: navy\">, </span> note.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"noteReference\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"commentTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ResultObservationReferenceRangeFromCdaReferenceRange<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">referenceRange</span>, <b>target</b> <span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  referenceRange.observationRange<b> as </b><span style=\"color: maroon\">observationRange</span><span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.referenceRange<b> as </b><span style=\"color: maroon\">fhirReferenceRange</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observationRange.text<b> as </b><span style=\"color: maroon\">text</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      text.xmlText<b> as </b><span style=\"color: maroon\">xml</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirReferenceRange.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">xml</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"referenceRangeText\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    observationRange.value<b> as </b><span style=\"color: maroon\">value</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      value.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirReferenceRange.low = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">lowQuantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        low.value<b> as </b><span style=\"color: maroon\">lowValue</span><span style=\"color: navy\"><b> -&gt; </b></span>lowQuantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">lowValue</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"lowValue\"</i><span style=\"color: navy\">;</span>#xD;\n        low.unit<b> as </b><span style=\"color: maroon\">lowUnit</span><span style=\"color: navy\"><b> -&gt; </b></span>lowQuantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">lowUnit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"lowUnit\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      value.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirReferenceRange.high = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">highQuantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        high.value<b> as </b><span style=\"color: maroon\">highValue</span><span style=\"color: navy\"><b> -&gt; </b></span>highQuantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">highValue</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"highValue\"</i><span style=\"color: navy\">;</span>#xD;\n        high.unit<b> as </b><span style=\"color: maroon\">highUnit</span><span style=\"color: navy\"><b> -&gt; </b></span>highQuantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">highUnit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"highUnit\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"referenceRange\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">7.5 FACTEURS DE RISQUES PROFESSIONNELS</span>#xD;\n<b>group </b>PatientSummaryProfessionalRisksSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    entry.observation<b> as </b><span style=\"color: maroon\">observation</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">observationEntry</span><span style=\"color: navy\">, </span> observationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Observation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span> fhirObservation.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> observationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %fhirObservation.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<b> then </b>PatientSummaryProfessionalRiskObservationFromObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"professionalRiskObservation\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<b> then </b>ObservationAddToSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"directObservation\"</i><span style=\"color: navy\">;</span>#xD;\n    entry.organizer<b> as </b><span style=\"color: maroon\">organizer</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      organizer.component<b> as </b><span style=\"color: maroon\">component</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        component.observation<b> as </b><span style=\"color: maroon\">observation</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">observationEntry</span><span style=\"color: navy\">, </span> observationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Observation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span> fhirObservation.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> observationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %fhirObservation.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          observation<b> then </b>PatientSummaryProfessionalRiskObservationFromObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"professionalRiskComponentObservation\"</i><span style=\"color: navy\">;</span>#xD;\n          observation<b> then </b>ObservationAddToSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"componentObservation\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PatientSummaryProfessionalRiskObservationFromObservation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">observation</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  observation<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.status = <span style=\"color: blue\">'final'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then </b>ObservationStatusFromCdaStatus<span style=\"color: navy\">(</span><span style=\"color: maroon\">statusCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span> fhirObservation.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observation<span style=\"color: navy\"><b> -&gt; </b></span>category.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/observation-category'</span> <i>\"categorySystem\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <span style=\"color: blue\">'social-history'</span> <i>\"categoryCode\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Social History'</span> <i>\"categoryDisplay\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"categoryCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">obsCode</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">obsCode</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation.code<b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code.qualifier<b> as </b><span style=\"color: maroon\">qualifier</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.component<b> as </b><span style=\"color: maroon\">component</span><b> then </b>ProfessionalRiskObservationComponentFromQualifier<span style=\"color: navy\">(</span><span style=\"color: maroon\">qualifier</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">component</span><span style=\"color: navy\">)</span> <i>\"qualifierComponent\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"qualifiers\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.text<b> as </b><span style=\"color: maroon\">text</span><b> then </b>ProfessionalRiskObservationNoteFromText<span style=\"color: navy\">(</span><span style=\"color: maroon\">text</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span> <i>\"textNote\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then </b>ObservationEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation<b> where </b>observation.effectiveTime.empty()<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observation<span style=\"color: navy\"><b> -&gt; </b></span>effectiveDateTime.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"effectiveTimeAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.value<b> as </b><span style=\"color: maroon\">value</span><b> then </b>ProfessionalRiskObservationValueFromCdaValue<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation.interpretationCode<b> as </b><span style=\"color: maroon\">interpretationCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.interpretation = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">interpretation</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">interpretationCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">interpretation</span><span style=\"color: navy\">)</span> <i>\"interpretation\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.methodCode<b> as </b><span style=\"color: maroon\">methodCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.method = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">method</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">methodCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">method</span><span style=\"color: navy\">)</span> <i>\"method\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.targetSiteCode<b> as </b><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.bodySite = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">bodySite</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bodySite</span><span style=\"color: navy\">)</span> <i>\"bodySite\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then </b>ObservationCommentFromEntryRelationship<span style=\"color: navy\">(</span><span style=\"color: maroon\">er</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span> <i>\"comments\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ProfessionalRiskObservationValueFromCdaValue<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">value</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  value.unit<b> as </b><span style=\"color: maroon\">unit</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">quantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    value.value<b> as </b><span style=\"color: maroon\">v</span><span style=\"color: navy\"><b> -&gt; </b></span>quantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"quantityValue\"</i><span style=\"color: navy\">;</span>#xD;\n    unit<span style=\"color: navy\"><b> -&gt; </b></span>quantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"quantityUnit\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"valueQuantity\"</i><span style=\"color: navy\">;</span>#xD;\n  value.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>value.unit.empty()<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">)</span> <i>\"valueCodeableConcept\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'true')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"valueBooleanTrue\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'false')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"valueBooleanFalse\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ProfessionalRiskObservationComponentFromQualifier<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">qualifier</span>, <b>target</b> <span style=\"color: maroon\">component</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  qualifier.name<b> as </b><span style=\"color: maroon\">name</span><span style=\"color: navy\"><b> -&gt; </b></span>component.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">componentCode</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">name</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">componentCode</span><span style=\"color: navy\">)</span> <i>\"componentCode\"</i><span style=\"color: navy\">;</span>#xD;\n  qualifier.value<b> as </b><span style=\"color: maroon\">value</span><b> then </b>ProfessionalRiskObservationComponentValueFromCdaValue<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">component</span><span style=\"color: navy\">)</span> <i>\"componentValue\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ProfessionalRiskObservationComponentValueFromCdaValue<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">value</span>, <b>target</b> <span style=\"color: maroon\">component</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  value.unit<b> as </b><span style=\"color: maroon\">unit</span><span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">quantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    value.value<b> as </b><span style=\"color: maroon\">v</span><span style=\"color: navy\"><b> -&gt; </b></span>quantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"quantityValue\"</i><span style=\"color: navy\">;</span>#xD;\n    unit<span style=\"color: navy\"><b> -&gt; </b></span>quantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"quantityUnit\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"componentValueQuantity\"</i><span style=\"color: navy\">;</span>#xD;\n  value.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>value.unit.empty()<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">)</span> <i>\"componentValueCodeableConcept\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'true')<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"componentValueBooleanTrue\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'false')<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"componentValueBooleanFalse\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ProfessionalRiskObservationNoteFromText<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">text</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span> fhirObservation.note = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Annotation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">note</span><span style=\"color: navy\">, </span> note.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"noteReference\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  text.xmlText<b> as </b><span style=\"color: maroon\">xml</span><b> where </b>text.reference.empty()<span style=\"color: navy\"><b> -&gt; </b></span> fhirObservation.note = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Annotation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">note</span><span style=\"color: navy\">, </span> note.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">xml</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"noteText\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">8. PLAN DE SOINS</span>#xD;\n<b>group </b>PatientSummaryCarePlanSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CarePlan.</span>#xD;\n  section<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">carePlanEntry</span><span style=\"color: navy\">, </span> carePlanEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CarePlan'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span> carePlan.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> carePlanEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %carePlan.id<span style=\"color: navy\">)</span><b> then </b>PSPlanCarePlan<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"carePlan\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanCarePlan<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Statut.</span>#xD;\n  section<span style=\"color: navy\"><b> -&gt; </b></span>carePlan.status = <span style=\"color: blue\">'active'</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Intention.</span>#xD;\n  section<span style=\"color: navy\"><b> -&gt; </b></span>carePlan.intent = <span style=\"color: blue\">'plan'</span> <i>\"intent\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Patient.</span>#xD;\n  section<span style=\"color: navy\"><b> -&gt; </b></span> carePlan.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant.</span>#xD;\n  section.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>carePlan.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Catégorie.</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>carePlan.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">category</span><span style=\"color: navy\">)</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Titre.</span>#xD;\n  section.title<b> as </b><span style=\"color: maroon\">title</span><span style=\"color: navy\"><b> -&gt; </b></span>carePlan.title = <span style=\"color: navy\">(</span>title.xmlText<span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Période.</span>#xD;\n  section.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>carePlan.created = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">created</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">created</span><span style=\"color: navy\">)</span> <i>\"created\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>carePlan.period = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">period</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      low<span style=\"color: navy\"><b> -&gt; </b></span>period.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"start\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>period.end = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">end</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">end</span><span style=\"color: navy\">)</span> <i>\"end\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"period\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Entrées du plan.</span>#xD;\n  section.entry<b> as </b><span style=\"color: maroon\">sectionEntry</span><b> then </b>PSPlanEntryDispatcher<span style=\"color: navy\">(</span><span style=\"color: maroon\">sectionEntry</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"entries\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Référence section.</span>#xD;\n  section<span style=\"color: navy\"><b> -&gt; </b></span> compSection.entry = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">sectionRef</span><span style=\"color: navy\">, </span> sectionRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %carePlan.id<span style=\"color: navy\">)</span> <i>\"sectionEntryCarePlan\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanEntryDispatcher<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">sectionEntry</span>, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Traitement prévu.</span>#xD;\n  sectionEntry.substanceAdministration<b> as </b><span style=\"color: maroon\">sa</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    sa.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.42'<b> then </b>PSPlanMedicationRequestEntry<span style=\"color: navy\">(</span><span style=\"color: maroon\">sa</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"medicationRequest\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"templateTreatment\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"treatment\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Demande d’examen.</span>#xD;\n  sectionEntry.observation<b> as </b><span style=\"color: maroon\">obs</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    obs.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.27'<b> then </b>PSPlanServiceRequestEntry<span style=\"color: navy\">(</span><span style=\"color: maroon\">obs</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"serviceRequest\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"templateServiceRequest\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"serviceRequest\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Acte prévu.</span>#xD;\n  sectionEntry.procedure<b> as </b><span style=\"color: maroon\">proc</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    proc.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.62'<b> then </b>PSPlanProcedureEntry<span style=\"color: navy\">(</span><span style=\"color: maroon\">proc</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"procedure\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"templateProcedure\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Rencontre prévue.</span>#xD;\n  sectionEntry.encounter<b> as </b><span style=\"color: maroon\">enc</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    enc.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.58'<b> then </b>PSPlanEncounterEntry<span style=\"color: navy\">(</span><span style=\"color: maroon\">enc</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"encounter\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"templateEncounter\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Vaccin recommandé.</span>#xD;\n  sectionEntry.substanceAdministration<b> as </b><span style=\"color: maroon\">sa</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    sa.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.47'<b> then </b>PSPlanImmunizationRecommendationEntry<span style=\"color: navy\">(</span><span style=\"color: maroon\">sa</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"immunizationRecommendation\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"templateVaccineRecommendation\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"vaccineRecommendation\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">TRAITEMENT PRÉVU -&gt; MedicationRequest</span>#xD;\n<b>group </b>PSPlanMedicationRequestEntry<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">sa</span>, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">MedicationRequest.</span>#xD;\n  sa<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">medicationRequestEntry</span><span style=\"color: navy\">, </span> medicationRequestEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'MedicationRequest'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">medicationRequest</span><span style=\"color: navy\">, </span> medicationRequest.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> medicationRequestEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %medicationRequest.id<span style=\"color: navy\">)</span><b> then </b>PSPlanMedicationRequest<span style=\"color: navy\">(</span><span style=\"color: maroon\">sa</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationRequest</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"medicationRequest\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanMedicationRequest<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">sa</span>, <b>target</b> <span style=\"color: maroon\">medicationRequest</span><span style=\"color: navy\"> : </span>MedicationRequest, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Statut.</span>#xD;\n  sa<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.status = <span style=\"color: blue\">'active'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  sa.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.status = <span style=\"color: blue\">'active'</span> <i>\"active\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.status = <span style=\"color: blue\">'completed'</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.status = <span style=\"color: blue\">'stopped'</span> <i>\"aborted\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.status = <span style=\"color: blue\">'cancelled'</span> <i>\"cancelled\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'suspended'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.status = <span style=\"color: blue\">'on-hold'</span> <i>\"suspended\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Intention.</span>#xD;\n  sa<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.intent = <span style=\"color: blue\">'plan'</span> <i>\"intentDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  sa.moodCode<b> as </b><span style=\"color: maroon\">moodCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    moodCode<b> where </b>moodCode = 'INT'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.intent = <span style=\"color: blue\">'plan'</span> <i>\"intent\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'GOL'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.intent = <span style=\"color: blue\">'plan'</span> <i>\"goal\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'PRP'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.intent = <span style=\"color: blue\">'proposal'</span> <i>\"proposal\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'RQO'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.intent = <span style=\"color: blue\">'order'</span> <i>\"order\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'ARQ'<span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.intent = <span style=\"color: blue\">'order'</span> <i>\"appointmentRequest\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"intent\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant.</span>#xD;\n  sa.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Patient.</span>#xD;\n  sa<span style=\"color: navy\"><b> -&gt; </b></span> medicationRequest.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Médicament.</span>#xD;\n  sa.consumable<b> as </b><span style=\"color: maroon\">consumable</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    consumable.manufacturedProduct<b> as </b><span style=\"color: maroon\">manufacturedProduct</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      manufacturedProduct.manufacture