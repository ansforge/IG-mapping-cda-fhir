\n  organizer.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then </b>DiagnosticReportEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  organizer.component<b> as </b><span style=\"color: maroon\">component</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    component.observation<b> as </b><span style=\"color: maroon\">observation</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">observationEntry</span><span style=\"color: navy\">, </span> observationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Observation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">, </span> resultObservation.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> observationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %resultObservation.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<b> then </b>PatientSummaryResultObservationFromObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"resultObservation\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span> diagnosticReport.result = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</spa