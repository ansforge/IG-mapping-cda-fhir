.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>value.unit.empty()<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">)</span> <i>\"componentValueCodeableConcept\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'true')<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"componentValueBooleanTrue\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'false')<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"componentValueBooleanFalse\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>FunctionalStatusNoteFromCommentAct<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">commentAct</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span s