fectiveTime</span><b> then </b>DiagnosticReportEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">observationEntry</span><span style=\"color: navy\">, </span> observationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Observation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">, </span> resultObservation.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> observationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %resultObservation.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observation<b> then </b>PatientSummaryResultObservationFromObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"resultObservation\"</i><span style=\"color: navy\">;</span>#xD;\n    observation<span style=\"color: navy\"><b> -&gt; </b></span> diagnosticReport.result = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">resultRef</span><span style=\"color: navy\">, </span> resultRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %resultObservation.id<span style=\"color: navy\">)</span> <i>\"resultReference\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"resultObservationEntry\"</i><span style=\"color: navy\">;</span>#xD;\n  observation<b> then </b>DiagnosticReportAddToSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>DiagnosticReportStatusFromCdaStatus<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">statusCode</span>, <b>target</b> <span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\"> : </span>DiagnosticReport<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>diagnosticReport.status = <span style=\"color: blue\">'final'</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>diagnosticReport.status = <span style=\"color: blue\">'preliminary'</span> <i>\"active\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>diagnosticReport.status = <span style=\"color: blue\">'cancelled'</span> <i>\"aborted\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>diagnosticReport.status = <span style=\"color: blue\">'cancelled'</span> <i>\"cancelled\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>DiagnosticReportEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">effectiveTime</span>, <b>target</b> <span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\"> : </span>DiagnosticReport<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>diagnosticReport.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">effectiveDateTime</span><span style=\"color: navy\">)</span> <i>\"effectiveDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><b> where </b>effectiveTime.high.empty()<span style=\"color: navy\"><b> -&gt; </b></span>diagnosticReport.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">effectiveDateTime</span><span style=\"color: navy\">)</span> <i>\"effectiveLowAsDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><b> where </b>effectiveTime.high.exists()<span style=\"color: navy\"><b> -&gt; </b></span>diagnosticReport.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectivePeriod</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    low<span style=\"color: navy\"><b> -&gt; </b></span>effectivePeriod.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"start\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>effectivePeriod.end = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">end</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">end</span><span style=\"color: navy\">)</span> <i>\"end\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"effectivePeriod\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>DiagnosticReportAddToSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\"> : </span>DiagnosticReport, <b>target</b> <span style=\"color: maroon\">compSection</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span> compSection.entry = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">sectionRef</span><span style=\"color: navy\">, </span> sectionRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %diagnosticReport.id<span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Observation de résultat</span>#xD;\n<b>group </b>PatientSummaryResultObservationFromObservation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">observation</span>, <b>target</b> <span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\"> : </span>Observation, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  observation<span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.status = <span style=\"color: blue\">'final'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then </b>ObservationStatusFromCdaStatus<span style=\"color: navy\">(</span><span style=\"color: maroon\">statusCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">resultObservation</span><span style=\"color: navy\">)</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>resultObservation.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</