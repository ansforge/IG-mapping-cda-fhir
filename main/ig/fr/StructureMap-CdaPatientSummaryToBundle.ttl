\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"innerIngredient\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Dosage de l’ingrédient</span>#xD;\n<b>group </b>MedicationIngredientStrengthFromPharmQuantity<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">quantity</span>, <b>target</b> <span style=\"color: maroon\">fhirIngredient</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  quantity.numerator<b> as </b><span style=\"color: maroon\">numerator</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirIngredient.strength = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Ratio'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">strength</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    numerator<span style=\"color: navy\"><b> -&gt; </b></span>strength.numerator = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">numeratorQuantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      numerator.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>numeratorQuantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"numeratorValue\"</i><span style=\"color: navy\">;</span>#xD;\n      numerator.unit<b> as </b><span style=\"color: maroon\">unit</span><span style=\"color: navy\"><b> -&gt; </b></span>numeratorQuantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"numeratorUnit\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"numerator\"</i><span style=\"color: navy\">;</span>#xD;\n    quantity.denominator<b> as </b><span style=\"color: maroon\">denominator</span><span style=\"color: navy\"><b> -&gt; </b></span>strength.denominator = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">denominatorQuantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      denominator.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>denominatorQuantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"denominatorValue\"</i><span style=\"color: navy\">;</span>#xD;\n      denominator.unit<b> as </b><span style=\"color: maroon\">unit</span><span style=\"color: navy\"><b> -&gt; </b></span>denominatorQuantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"denominatorUnit\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"strength\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Période du traitement</span>#xD;\n<b>group </b>MedicationStatementEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">effectiveTime</span>