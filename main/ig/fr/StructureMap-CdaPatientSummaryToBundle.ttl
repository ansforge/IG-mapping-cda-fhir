\n  sa.doseQuantity<b> as </b><span style=\"color: maroon\">doseQuantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    doseQuantity.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.dosageInstruction<b> as </b><span style=\"color: maroon\">dosage</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      doseQuantity<span style=\"color: navy\"><b> -&gt; </b></span> dosage.doseAndRate<b> as </b><span style=\"color: maroon\">doseAndRate</span><span style=\"color: navy\">, </span> doseAndRate.dose = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Range'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">doseRange</span><b> then </b>MedicationRangeFromLowHigh<span style=\"color: navy\">(</span><span style=\"color: maroon\">doseQuantity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">doseRange</span><span style=\"color: navy\">)</span> <i>\"doseRange\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dose\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Débit.</span>#xD;\n  sa.rateQuantity<b> as </b><span style=\"color: maroon\">rateQuantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    rateQuantity.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>medicationRequest.dosageInstruction<b> as </b><span style=\"color: maroon\">dosage</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      rateQuantity<span style=\"color: navy\"><b> -&gt; </b></span> dosage.doseAndRate<b> as </b><span style=\"color: maroon\">doseAndRate</span><span style=\"color: navy\">, </span> doseAndRate.rate = <b>create</b><span style=\"color: navy\">(</sp