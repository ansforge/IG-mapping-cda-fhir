y\">}</span><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"reactionSubstance\"</i><span style=\"color: navy\">;</span>#xD;\n          reactionObs.value<b> as </b><span style=\"color: maroon\">manifestationValue</span><span style=\"color: navy\"><b> -&gt; </b></span>reaction.manifestation = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">manifestation</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">manifestationValue</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">manifestation</span><span style=\"color: navy\">)</span> <i>\"manifestation\"</i><span style=\"color: navy\">;</span>#xD;\n          reactionObs.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>reaction.onset = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">onsetDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">onsetDateTime</span><span style=\"color: navy\">)</span> <i>\"reactionOnset\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"reactionEffectiveTime\"</i><span style=\"color: navy\">;</span>#xD;\n          reactionObs.entryRelationship<b> as </b><span style=\"color: maroon\">reactionEr</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            reactionEr.observation<b> as </b><span style=\"color: maroon\">severityObs</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>              severityObs.templateId<b> as </b><span style=\"color: maroon\">severityTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>                severityTid.root<b> as </b><span style=\"color: maroon\">severityRoot</span><b> where </b>severityRoot = '1.2.250.1.213.1.1.3.29'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>                  severityObs.value<b> as </b><span style=\"color: maroon\">severityValue</span><b> where </b>severityValue.code = '255604002'<span style=\"color: navy\"><b> -&gt; </b></span>reaction.severity = <span style=\"color: blue\">'mild'</span> <i>\"severityMild\"</i><span style=\"color: navy\">;</span>#xD;\n                  severityObs.value<b> as </b><span style=\"color: maroon\">severityValue</span><b> where </b>severityValue.code = '6736007'<span style=\"color: navy\"><b> -&gt; </b></span>reaction.severity = <span style=\"color: blue\">'moderate'</span> <i>\"severityModerate\"</i><span style=\"color: navy\">;</span>#xD;\n                  severityObs.value<b> as </b><span style=\"color: maroon\">severityValue</span><b> where </b>severityValue.code = '24484000'<span style=\"color: navy\"><b> -&gt; </b></span>reaction.severity = <span style=\"color: blue\">'severe'</span> <i>\"severitySevere\"</i><span style=\"color: navy\">;</span>#xD;\n                <span style=\"color: navy\">}</span> <i>\"reactionSeverity\"</i><span style=\"color: navy\">;</span>#xD;\n              <span style=\"color: navy\">}</span> <i>\"severityTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span> <i>\"severityObservation\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"reactionEntryRelationships\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"reaction\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"reactionTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"reactionBlock\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"entryRelationships\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Référence dans la section FHIR.</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span> compSection.entry = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">sectionRef</span><span style=\"color: navy\">, </span> sectionRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %allergy.id<span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">3. PROCÉDURES / ACTES</span>#xD;\n<b>group </b>PatientSummaryProcedureSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Section actes / procédures.</span>#xD;\n  section.templateId<b> as </b><span style=\"color: maroon\">sectionTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    sectionTid.root<b> as </b><span style=\"color: maroon\">sectionRoot</span><b> where </b>sectionRoot = '1.2.250.1.213.1.1.2.136'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        entry.procedure<b> as </b><span style=\"color: maroon\">cdaProcedure</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          cdaProcedure.templateId<b> as </b><span style=\"color: maroon\">procTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            procTid.root<b> as </b><span style=\"color: maroon\">procRoot</span><b> where </b>procRoot = '1.2.250.1.213.1.1.3.62'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">procedureEntry</span><span style=\"color: navy\">, </span> procedureEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Procedure'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\">, </span> fhirProcedure.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> procedureEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %fhirProcedure.id<span style=\"color: navy\">)</span><b> then </b>PatientSummaryProcedureFromProcedure<span style=\"color: navy\">(</span><span style=\"color: maroon\">cdaProcedure</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"procedure\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"procedureTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"cdaProcedure\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"historyActsSection\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"sectionTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Acte CDA -&gt; Procedure FHIR</span>#xD;\n<b>group </b>PatientSummaryProcedureFromProcedure<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">procedure</span>, <b>target</b> <span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\"> : </span>Procedure, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Statut.</span>#xD;\n  procedure<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'unknown'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  procedure.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'completed'</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'in-progress'</span> <i>\"active\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'stopped'</span> <i>\"aborted\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'not-done'</span> <i>\"cancelled\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'suspended'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'on-hold'</span> <i>\"suspended\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  procedure.moodCode<b> as </b><span style=\"color: maroon\">mood</span><b> where </b>mood = 'INT'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'preparation'</span> <i>\"statusIntent\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant, patient et code de l’acte.</span>#xD;\n  procedure.id<b> as </b><span style=\"color: maroon\">procedureId</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">procedureId</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  procedure<span style=\"color: navy\"><b> -&gt; </b></span> fhirProcedure.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  procedure.code<b> as </b><span style=\"color: maroon\">procedureCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">code</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">procedureCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">code</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Date ou période de réalisation.</span>#xD;\n  procedure.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.performed = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">performedDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">performedDateTime</span><span style=\"color: navy\">)</span> <i>\"performedDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.performed = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">performedPeriod</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      low<span style=\"color: navy\"><b> -&gt; </b></span>performedPeriod.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"start\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>performedPeriod.end = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">end</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">end</span><span style=\"color: navy\">)</span> <i>\"end\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"performedPeriod\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"performed\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Site anatomique.</span>#xD;\n  procedure.targetSiteCode<b> as </b><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.bodySite = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">bodySite</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bodySite</span><span style=\"color: navy\">)</span> <i>\"targetSite\"</i><span style=\"color: navy\">;</span>#xD;\n  procedure.approachSiteCode<b> as </b><span style=\"color: maroon\">approachSiteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.bodySite = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">approachSite</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">approachSiteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">approachSite</span><span style=\"color: navy\">)</span> <i>\"approachSite\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Auteur et exécutant.</span>#xD;\n  procedure.author<b> as </b><span style=\"color: maroon\">author</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    author.assignedAuthor<b> as </b><span style=\"color: maroon\">assignedAuthor</span><b> then </b>ProcedureRecorderFromAssignedAuthor<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedAuthor</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"recorder\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  procedure.performer<b> as </b><span style=\"color: maroon\">performer</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    performer.assignedEntity<b> as </b><span style=\"color: maroon\">assignedEntity</span><b> then </b>ProcedurePerformerFromAssignedEntity<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"performer\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Informations complémentaires.</span>#xD;\n  procedure.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">Motif de l’acte.</span>#xD;\n    er.act<b> as </b><span style=\"color: maroon\">reasonAct</span><b> where </b>er.typeCode = 'RSON'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      reasonAct.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.36'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          reasonAct.code<b> as </b><span style=\"color: maroon\">reasonCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.reasonCode = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">reason</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">reasonCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">reason</span><span style=\"color: navy\">)</span> <i>\"reasonCode\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"reason\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"reasonTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"reasonAct\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Commentaire non mappé pour l’instant.</span>#xD;\n    er.act<b> as </b><span style=\"color: maroon\">commentAct</span><b> where </b>er.typeCode = 'SUBJ'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      commentAct.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.32' <i>\"commentNotMapped\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"commentTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"commentAct\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Dispositif médical utilisé.</span>#xD;\n    er.act<b> as </b><span style=\"color: maroon\">deviceReferenceAct</span><b> where </b>er.typeCode = 'REFR'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      deviceReferenceAct.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.36'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          deviceReferenceAct.id<b> as </b><span style=\"color: maroon\">deviceId</span><span style=\"color: navy\"><b> -&gt; </b></span> fhirProcedure.usedReference = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">usedRef</span><span style=\"color: navy\">, </span> usedRef.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">deviceId</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"usedReference\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"deviceReference\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"deviceReferenceTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"deviceReferenceAct\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Observation liée à l’acte.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">linkedObservation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      linkedObservation.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.48'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">obsEntry</span><span style=\"color: navy\">, </span> obsEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Observation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: 