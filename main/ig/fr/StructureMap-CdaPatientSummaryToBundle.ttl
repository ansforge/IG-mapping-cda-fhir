pan><b> as </b><span style=\"color: maroon\">reason</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">reasonCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">reason</span><span style=\"color: navy\">)</span> <i>\"reasonCode\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Posologie subordonnée</span>#xD;\n<b>group </b>MedicationChildDosageFromSubstanceAdministration<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">childAdministration</span>, <b>source</b> <span style=\"color: maroon\">parentAdministration</span>, <b>target</b> <span style=\"color: maroon\">childDosage</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  childAdministration.effectiveTime<b> as </b><span style=\"color: maroon\">childEffectiveTime</span><b> then </b>MedicationChildTimingFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">childEffectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">childDosage</span><span style=\"color: navy\">)</span> <i>\"childTiming\"</i><span style=\"color: navy\">;</span>#xD;\n  parentAdministration.routeCode<b> as </b><span style=\"color: maroon\">routeCode</span><span style=\"color: navy\"><b> -&gt; </b></span>childDosage.route = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">route</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">routeCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">route</span><span style=\"color: navy\">)</span> <i>\"childRoute\"</i><span style=\"color: navy\">;</span>#xD;\n  childAdministration.doseQuantity<b> as </b><spa