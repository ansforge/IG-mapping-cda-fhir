n><span style=\"color: blue\">'Observation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span> fhirObservation.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> observationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %fhirObservation.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          observation<b> then </b>PatientSummaryVitalSignObservationFromObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"vitalSignObservation\"</i><span style=\"color: navy\">;</span>#xD;\n          observation<b> then </b>ObservationPanelHasMember<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">panel</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span> <i>\"hasMember\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"memberObservation\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"observationTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  organizer<b> then </b>ObservationAddToSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">organizer</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">panel</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PatientSummaryVitalSignObservationFromObservation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">observation</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  observation<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.status = <span style=\"color: blue\">'final'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then </b>ObservationStatusFromCdaStatus<span style=\"color: navy\">(</span><span style=\"color: maroon\">statusCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span> fhirObservation.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observation<span style=\"color: navy\"><b> -&gt; </b></span>category.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/observation-category'</span> <i>\"categorySystem\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <span style=\"color: blue\">'vital-signs'</span> <i>\"categoryCode\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Vital Signs'</span> <i>\"categoryDisplay\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"categoryCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">obsCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code<b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">obsCode</span><span style=\"color: navy\">)</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n    observation.text<b> as </b><span style=\"color: maroon\">text</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>obsCode.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"codeText\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"observationCode\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then </b>ObservationEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation<b> where </b>observation.effectiveTime.empty()<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observation<span style=\"color: navy\"><b> -&gt; </b></span>effectiveDateTime.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"effectiveTimeAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.value<b> as </b><span style=\"color: maroon\">value</span><b> then </b>VitalSignObservationValueFromCdaValue<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation.interpretationCode<b> as </b><span style=\"color: maroon\">interpretationCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.interpretation = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">interpretation</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">interpretationCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">interpretation</span><span style=\"color: navy\">)</span> <i>\"interpretation\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.methodCode<b> as </b><span style=\"color: maroon\">methodCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.method = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">method</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">methodCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">method</span><span style=\"color: navy\">)</span> <i>\"method\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.targetSiteCode<b> as </b><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.bodySite = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">bodySite</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bodySite</span><span style=\"color: navy\">)</span> <i>\"bodySite\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then </b>ObservationCommentFromEntryRelationship<span style=\"color: navy\">(</span><span style=\"color: maroon\">er</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span> <i>\"comments\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Valeur spécifique des signes vitaux</span>#xD;\n<b>group </b>VitalSignObservationValueFromCdaValue<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">value</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation, <b>source</b> <span style=\"color: maroon\">observation</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  value.unit<b> as </b><span style=\"color: maroon\">unit</span><b> where </b>(unit = 'm') and (observation.code.code = '8302-2')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">quantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    value.value<b> as </b><span style=\"color: maroon\">v</span><span style=\"color: navy\"><b> -&gt; </b></span>quantity.value = <span style=\"color: navy\">(</span>v * 100<span style=\"color: navy\">)</span> <i>\"heightValueCm\"</i><span style=\"color: navy\">;</span>#xD;\n    unit<span style=\"color: navy\"><b> -&gt; </b></span>quantity.unit = <span style=\"color: blue\">'cm'</span> <i>\"heightUnitCm\"</i><span style=\"color: navy\">;</span>#xD;\n    value<span style=\"color: navy\"><b> -&gt; </b></span>quantity.system = <span style=\"color: blue\">'http://unitsofmeasure.org'</span> <i>\"heightSystemUCUM\"</i><span style=\"color: navy\">;</span>#xD;\n    unit<span style=\"color: navy\"><b> -&gt; </b></span>quantity.code = <span style=\"color: blue\">'cm'</span> <i>\"heightCodeCm\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"heightValueQuantityCm\"</i><span style=\"color: navy\">;</span>#xD;\n  value.unit<b> as </b><span style=\"color: maroon\">unit</span><b> where </b>(observation.code.code != '8302-2') or (unit != 'm')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">quantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    value.value<b> as </b><span style=\"color: maroon\">v</span><span style=\"color: navy\"><b> -&gt; </b></span>quantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"quantityValue\"</i><span style=\"color: navy\">;</span>#xD;\n    unit<span style=\"color: navy\"><b> -&gt; </b></span>quantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"quantityUnit\"</i><span style=\"color: navy\">;</span>#xD;\n    value<span style=\"color: navy\"><b> -&gt; </b></span>quantity.system = <span style=\"color: blue\">'http://unitsofmeasure.org'</span> <i>\"quantitySystem\"</i><span style=\"color: navy\">;</span>#xD;\n    unit<span style=\"color: navy\"><b> -&gt; </b></span>quantity.code = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"quantityCode\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"valueQuantity\"</i><span style=\"color: navy\">;</span>#xD;\n  value.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>value.unit.empty()<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">)</span> <i>\"valueCodeableConcept\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'true')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"valueBooleanTrue\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'false')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"valueBooleanFalse\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">7.2 MODE DE VIE / HABITUS</span>#xD;\n<b>group </b>PatientSummaryLifestyleSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    entry.observation<b> as </b><span style=\"color: maroon\">observation</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">observationEntry</span><span style=\"color: navy\">, </span> observationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Observation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span> fhirObservation.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> observationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %fhirObservation.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<b> then </b>PatientSummaryLifestyleObservationFromObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"lifestyleObservation\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<b> then </b>ObservationAddToSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">observation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">, </spa