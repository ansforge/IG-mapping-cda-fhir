ization-recommendation-status'</span> <i>\"system\"</i><span style=\"color: navy\">;</span>#xD;\n          statusCode<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <span style=\"color: blue\">'complete'</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n          statusCode<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Complete'</span> <i>\"display\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"coding\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n      statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>(code != 'active') and (code != 'completed')<span style=\"color: navy\"><b> -&gt; </b></span>rec.forecastStatus = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">forecastStatus</span><b> then </b>PSPlanCodeableConceptAbsentReason<span style=\"color: navy\">(</span><span style=\"color: maroon\">statusCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">forecastStatus</span><span style=\"color: navy\">)</span> <i>\"unknown\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"forecastStatus\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Statut absent.</span>#xD;\n    sa<b> where </b>sa.statusCode.empty()<span style=\"color: navy\"><b> -&gt; </b></span>rec.forecastStatus = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">forecastStatus</span><b> then </b>PSPlanCodeableConceptAbsentReason<span style=\"color: navy\">(</span><spa