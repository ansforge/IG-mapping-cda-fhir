avy\">;</span>#xD;\n    reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span> reaction.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n    reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>reaction.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>category.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/observation-category'</span> <i>\"categorySystem\"</i><span style=\"color: navy\">;</span>#xD;\n        reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <span style=\"color: blue\">'exam'</span> <i>\"categoryCode\"</i><span style=\"color: navy\">;</span>#xD;\n        reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Exam'</span> <i>\"categoryDisplay\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"categoryCoding\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n    reactionObservation.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>reaction.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">cc</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      code<b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">cc</span><span style=\"color: navy\">)</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n      reactionObservation.text<b> as </b><span style=\"color: maroon\">text</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>cc.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"text\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"textBlock\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"reactionCode\"</i><span style=\"color: navy\">;</span>#xD;\n    reactionObservation.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>reaction.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Date de l’Observation.</span>#xD;\n    reactionObservation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>reaction.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">effectiveDateTime</span><span style=\"color: navy\">)</span> <i>\"effectiveDateTimeValue\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><b> where </b>effectiveTime.value.empty()<span style=\"color: navy\"><b> -&gt; </b></span>reaction.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">effectiveDateTime</span><span style=\"color: navy\">)</span> <i>\"effectiveDateTimeLow\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><b> where </b>effectiveTime.value.empty() and effectiveTime.low.empty()<span style=\"color: navy\"><b> -&gt; </b></span>reaction.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">effectiveDateTime</span><span style=\"color: navy\">)</span> <i>\"effectiveDateTimeHigh\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime<b> where </b>effectiveTime.value.empty() and effectiveTime.low.empty() and effectiveTime.high.empty()<span style=\"color: navy\"><b> -&gt; </b></span>reaction.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        effectiveTime<span style=\"color: navy\"><b> -&gt; </b></span>effectiveDateTime.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          effectiveTime<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n          effectiveTime<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"effectiveTimePresentWithoutValue\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    reactionObservation<b> where </b>reactionObservation.effectiveTime.empty()<span style=\"color: navy\"><b> -&gt; </b></span>reaction.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>effectiveDateTime.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n        reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"effectiveTimeAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Lien avec Immunization.reaction.</span>#xD;\n    reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span>immunization.reaction<b> as </b><span style=\"color: maroon\">immunizationReaction</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      reactionObservation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>immunizationReaction.date = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">reactionDate</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">reactionDate</span><span style=\"color: navy\">)</span> <i>\"reactionDate\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"reactionDateBlock\"</i><span style=\"color: navy\">;</span>#xD;\n      reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span> immunizationReaction.detail = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">detailRef</span><span style=\"color: navy\">, </span> detailRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %reaction.id<span style=\"color: navy\">)</span> <i>\"reactionDetail\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"immunizationReaction\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"reaction\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">7. OBSERVATIONS</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Sections concernées :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Constantes / signes vitaux</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Mode de vie / habitus</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Statut fonctionnel</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Résultats</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Facteurs de risques professionnels</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">BASE COMMUNE DES OBSERVATIONS</span>#xD;\n<b>group </b>PatientSummaryObservationBase<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">observation</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  observation<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.status = <span style=\"color: blue\">'final'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then </b>ObservationStatusFromCdaStatus<span style=\"color: navy\">(</span><span style=\"color: maroon\">statusCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span> fhirObservation.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  observation<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observation<span style=\"color: navy\"><b> -&gt; </b></span>category.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"categoryAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">obsCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code<b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">obsCode</span><span style=\"color: navy\">)</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n    observation.text<b> as </b><span style=\"color: maroon\">text</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>obsCode.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"codeText\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"observationCode\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then </b>ObservationEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation<b> where </b>observation.effectiveTime.empty()<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    observation<span style=\"color: navy\"><b> -&gt; </b></span>effectiveDateTime.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      observation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"effectiveTimeAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.value<b> as </b><span style=\"color: maroon\">value</span><b> then </b>ObservationValueFromCdaValue<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  observation.interpretationCode<b> as </b><span style=\"color: maroon\">interpretationCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.interpretation = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">interpretation</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">interpretationCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">interpretation</span><span style=\"color: navy\">)</span> <i>\"interpretation\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.methodCode<b> as </b><span style=\"color: maroon\">methodCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.method = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">method</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">methodCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">method</span><span style=\"color: navy\">)</span> <i>\"method\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.targetSiteCode<b> as </b><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.bodySite = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">bodySite</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bodySite</span><span style=\"color: navy\">)</span> <i>\"bodySite\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.code<b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code.qualifier<b> as </b><span style=\"color: maroon\">qualifier</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.component<b> as </b><span style=\"color: maroon\">component</span><b> then </b>ObservationComponentFromQualifier<span style=\"color: navy\">(</span><span style=\"color: maroon\">qualifier</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">component</span><span style=\"color: navy\">)</span> <i>\"qualifierComponent\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"qualifiers\"</i><span style=\"color: navy\">;</span>#xD;\n  observation.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then </b>ObservationCommentFromEntryRelationship<span style=\"color: navy\">(</span><span style=\"color: maroon\">er</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\">)</span> <i>\"comments\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Statut CDA -&gt; Observation.status</span>#xD;\n<b>group </b>ObservationStatusFromCdaStatus<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">statusCode</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.status = <span style=\"color: blue\">'final'</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.status = <span style=\"color: blue\">'registered'</span> <i>\"active\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.status = <span style=\"color: blue\">'cancelled'</span> <i>\"aborted\"</i><span style=\"color: navy\">;</span>#xD;\n  statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.status = <span style=\"color: blue\">'cancelled'</span> <i>\"cancelled\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">effectiveTime CDA -&gt; Observation.effective[x]</span>#xD;\n<b>group </b>ObservationEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">effectiveTime</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">effectiveDateTime</span><span style=\"color: navy\">)</span> <i>\"effectiveDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><b> where </b>effectiveTime.high.empty()<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">effectiveDateTime</span><span style=\"color: navy\">)</span> <i>\"effectiveLowAsDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><b> where </b>effectiveTime.high.exists()<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectivePeriod</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    low<span style=\"color: navy\"><b> -&gt; </b></span>effectivePeriod.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"start\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>effectivePeriod.end = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">end</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">end</span><span style=\"color: navy\">)</span> <i>\"end\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"effectivePeriod\"</i><span style=\"color: navy\">;</span>#xD;\n  effectiveTime<b> where </b>effectiveTime.value.empty() and effectiveTime.low.empty() and effectiveTime.high.empty()<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.effective = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">effectiveDateTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime<span style=\"color: navy\"><b> -&gt; </b></span>effectiveDateTime.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      effectiveTime<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"effectiveTimePresentWithoutValue\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Valeur CDA -&gt; Observation.value[x]</span>#xD;\n<b>group </b>ObservationValueFromCdaValue<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">value</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  value.unit<b> as </b><span style=\"color: maroon\">unit</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">quantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    value.value<b> as </b><span style=\"color: maroon\">v</span><span style=\"color: navy\"><b> -&gt; </b></span>quantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"quantityValue\"</i><span style=\"color: navy\">;</span>#xD;\n    unit<span style=\"color: navy\"><b> -&gt; </b></span>quantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"quantityUnit\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"valueQuantity\"</i><span style=\"color: navy\">;</span>#xD;\n  value.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">)</span> <i>\"valueCodeableConcept\"</i><span style=\"color: navy\">;</span>#xD;\n  value.originalText<b> as </b><span style=\"color: maroon\">originalText</span><b> where </b>value.code.empty() and value.unit.empty()<b> then</b><span style=\"color: navy\"> {#xD;\n</span>    originalText.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      reference.value<b> as </b><span style=\"color: maroon\">text</span><span style=\"color: navy\"><b> -&gt; </b></span> fhirObservation.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">, </span> valueCodeableConcept.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">text</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"valueCodeableConceptText\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"originalTextOnly\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'true')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"valueBooleanTrue\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'false')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"valueBooleanFalse\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v != 'true') and (v != 'false')<span style=\"color: navy\"><b> -&gt; </b></span>fhirObservation.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"valueString\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Qualifier CDA -&gt; Observation.component</span>#xD;\n<b>group </b>ObservationComponentFromQualifier<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">qualifier</span>, <b>target</b> <span style=\"color: maroon\">component</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  qualifier.name<b> as </b><span style=\"color: maroon\">name</span><span style=\"color: navy\"><b> -&gt; </b></span>component.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">componentCode</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">name</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">componentCode</span><span style=\"color: navy\">)</span> <i>\"componentCode\"</i><span style=\"color: navy\">;</span>#xD;\n  qualifier.value<b> as </b><span style=\"color: maroon\">value</span><b> then </b>ObservationComponentValueFromCdaValue<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">component</span><span style=\"color: navy\">)</span> <i>\"componentValue\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Valeur CDA -&gt; Observation.component.value[x]</span>#xD;\n<b>group </b>ObservationComponentValueFromCdaValue<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">value</span>, <b>target</b> <span style=\"color: maroon\">component</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  value.unit<b> as </b><span style=\"color: maroon\">unit</span><span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Quantity'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">quantity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    value.value<b> as </b><span style=\"color: maroon\">v</span><span style=\"color: navy\"><b> -&gt; </b></span>quantity.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"quantityValue\"</i><span style=\"color: navy\">;</span>#xD;\n    unit<span style=\"color: navy\"><b> -&gt; </b></span>quantity.unit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"quantityUnit\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"componentValueQuantity\"</i><span style=\"color: navy\">;</span>#xD;\n  value.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">valueCodeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">valueCodeableConcept</span><span style=\"color: navy\">)</span> <i>\"componentValueCodeableConcept\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'true')<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"componentValueBooleanTrue\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v = 'false')<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span> <i>\"componentValueBooleanFalse\"</i><span style=\"color: navy\">;</span>#xD;\n  value.value<b> as </b><span style=\"color: maroon\">v</span><b> where </b>value.unit.empty() and value.code.empty() and (v != 'true') and (v != 'false')<span style=\"color: navy\"><b> -&gt; </b></span>component.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"componentValueString\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Commentaire CDA -&gt; Observation.note</span>#xD;\n<b>group </b>ObservationCommentFromEntryRelationship<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">er</span>, <b>target</b> <span style=\"color: maroon\">fhirObservation</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  er.act<b> as </b><span style=\"color: maroon\">commentAct</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    commentAct.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.32'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>        commentAct.text<b> as </b><span style=\"color: maroon\">text</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span> fhirObservation.note = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Annotation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">note</span><span style=\"color: navy\">, </span> note.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"note\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"commentTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"commentAct\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Panel Observation</span>#xD;\n<b>group </b>PatientSummaryObservationPanelBase<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">organizer</span>, <b>target</b> <span style=\"color: maroon\">panel</span><span style=\"color: navy\"> : </span>Observation, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  organizer<span style=\"color: navy\"><b> -&gt; </b></span>panel.status = <span style=\"color: blue\">'final'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  organizer.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then </b>ObservationStatusFromCdaStatus<span style=\"color: navy\">(</span><span style=\"color: maroon\">statusCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">panel</span><span style=\"color: navy\">)</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  organizer.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>panel.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  organizer<span style=\"color: navy\"><b> -&gt; </b></span> panel.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  organizer<span style=\"color: navy\"><b> -&gt; </b></span>panel.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    organizer<span style=\"color: navy\"><b> -&gt; </b></span>category.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      organizer<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/observation-category'</span> <i>\"categorySystem\"</i><span style=\"color: navy\">;</span>#xD;\n      organizer<span style=\"color: navy\