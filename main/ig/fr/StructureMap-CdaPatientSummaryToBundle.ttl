</b><span style=\"color: maroon\">reportEntry</span><span style=\"color: navy\">, </span> reportEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'DiagnosticReport'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\">, </span> diagnosticReport.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> reportEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %diagnosticReport.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      organizer<b> then </b>PatientSummaryDiagnosticReportFromOrganizer<span style=\"color: navy\">(</span><span style=\"color: maroon\">organizer</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"diagnosticReport\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"organizerEntry\"</i><span style=\"color: navy\">;</span>#xD;\n    entry.observation<b> as </b><span style=\"color: maroon\">observation</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">reportEntry</span><span style=\"color: navy\">, </span> reportEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'DiagnosticReport'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">diagnosticReport</span><span style=\"color: navy\">, </span> diagnosticReport.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style