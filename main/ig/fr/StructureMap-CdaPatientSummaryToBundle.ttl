te</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      organizer<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      organizer<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"effectiveTimeAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>ObservationPanelHasMember<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">panel</span><span style=\"color: navy\"> : </span>Observation, <b>target</b> <span style=\"color: maroon\">member</span><span style=\"color: navy\"> : </span>Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span> panel.hasMember = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">memberRef</span><span style=\"color: navy\">, </span> memberRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %member.id<span style=\"color: navy\">)</span> <i>\"hasMember\"</i><span style=\"color: navy\">;</span>#x