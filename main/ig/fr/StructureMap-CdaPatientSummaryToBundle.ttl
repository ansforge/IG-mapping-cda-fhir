ncounter.status = <span style=\"color: blue\">'planned'</span> <i>\"plannedINT\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'EVN'<span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.status = <span style=\"color: blue\">'finished'</span> <i>\"finished\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant.</span>#xD;\n  enc.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Patient.</span>#xD;\n  enc<span style=\"color: navy\"><b> -&gt; </b></span> plannedEncounter.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Classe.</span>#xD;\n  enc.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.class = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">classCoding</span><b> then </b>CDCoding<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">classCoding</span><span style=\"color: navy\">)</span> <i>\"class\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Type.</span>#xD;\n  enc.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.type = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">encounterType</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">encounterType</span><span style=\"color: navy\">)</span> <i>\"type\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Période.</span>#xD;\n  enc.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.period = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">period</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      effectiveTime<span style=\"color: navy\"><b> -&gt; </b></span>period.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"start\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.period = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">period</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      low<span style=\"color: navy\"><b> -&gt; </b></span>period.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"start\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>period.end = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">end</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">end</span><span style=\"color: navy\">)</span> <i>\"end\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"interval\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"period\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Professionnel.</span>#xD;\n  enc.performer<b> as </b><span style=\"color: maroon\">performer</span><b> then </b>PSPlanEncounterPerformer<span style=\"color: navy\">(</span><span style=\"color: maroon\">performer</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">plannedEncounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Lieu.</span>#xD;\n  enc.participant<b> as </b><span style=\"color: maroon\">participant</span><b> then </b>PSPlanEncounterLocation<span style=\"color: navy\">(</span><span style=\"color: maroon\">participant</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">plannedEncounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"location\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Lien CarePlan.</span>#xD;\n  enc<span style=\"color: navy\"><b> -&gt; </b></span> carePlan.encounter = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">encounterRef</span><span style=\"color: navy\">, </span> encounterRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %plannedEncounter.id<span style=\"color: navy\">)</span> <i>\"carePlanEncounter\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanEncounterPerformer<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">performer</span>, <b>target</b> <span style=\"color: maroon\">plannedEncounter</span><span style=\"color: navy\"> : </span>Encounter, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Practitioner.</span>#xD;\n  performer.assignedEntity<b> as </b><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">practitionerEntry</span><span style=\"color: navy\">, </span> practitionerEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Practitioner'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">, </span> practitioner.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> practitionerEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitioner.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    assignedEntity<b> then </b>MapCDAAssignedEntityToPractitioner<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">)</span> <i>\"practitionerBase\"</i><span style=\"color: navy\">;</span>#xD;\n    assignedEntity<b> then </b>MapCDAAssignedEntityToFrenchPractitioner<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">)</span> <i>\"practitionerFR\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">PractitionerRole.</span>#xD;\n    assignedEntity.representedOrganization<b> as </b><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">organizationEntry</span><span style=\"color: navy\">, </span> organizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">organization</span><span style=\"color: navy\">, </span> organization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> organizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %organization.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">roleEntry</span><span style=\"color: navy\">, </span> roleEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'PractitionerRole'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">practitionerRole</span><span style=\"color: navy\">, </span> practitionerRole.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> roleEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitionerRole.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      representedOrganization<b> then </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">organization</span><span style=\"color: navy\">)</span> <i>\"organizationBase\"</i><span style=\"color: navy\">;</span>#xD;\n      representedOrganization<b> then </b>MapCDAOrganizationToFrenchOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">organization</span><span style=\"color: navy\">)</span> <i>\"organizationFR\"</i><span style=\"color: navy\">;</span>#xD;\n      assignedEntity<b> then </b>MapCDAAssignedEntityToPractitionerRole<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitionerRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">organization</span><span style=\"color: navy\">)</span> <i>\"roleBase\"</i><span style=\"color: navy\">;</span>#xD;\n      assignedEntity<b> then </b>MapCDAAssignedEntityToFrenchPractitionerRole<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitionerRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">practitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">organization</span><span style=\"color: navy\">)</span> <i>\"roleFR\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">Participant avec rôle.</span>#xD;\n      assignedEntity<span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.participant<b> as </b><span style=\"color: maroon\">participant</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        assignedEntity<span style=\"color: navy\"><b> -&gt; </b></span> participant.individual = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">individualRef</span><span style=\"color: navy\">, </span> individualRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitionerRole.id<span style=\"color: navy\">)</span> <i>\"roleRef\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"participantRole\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"withOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Participant sans organisation.</span>#xD;\n    assignedEntity<b> where </b>assignedEntity.representedOrganization.empty()<span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.participant<b> as </b><span style=\"color: maroon\">participant</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      assignedEntity<span style=\"color: navy\"><b> -&gt; </b></span> participant.individual = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">individualRef</span><span style=\"color: navy\">, </span> individualRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitioner.id<span style=\"color: navy\">)</span> <i>\"practitionerRef\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"participantPractitioner\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"performer\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanEncounterLocation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">participant</span>, <b>target</b> <span style=\"color: maroon\">plannedEncounter</span><span style=\"color: navy\"> : </span>Encounter, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Location.</span>#xD;\n  participant.participantRole<b> as </b><span style=\"color: maroon\">participantRole</span><b> where </b>participant.typeCode = 'LOC'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">locationEntry</span><span style=\"color: navy\">, </span> locationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Location'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">location</span><span style=\"color: navy\">, </span> location.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> locationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %location.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant.</span>#xD;\n    participantRole.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>location.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Type.</span>#xD;\n    participantRole.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>location.type = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">locationType</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">locationType</span><span style=\"color: navy\">)</span> <i>\"type\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Adresse.</span>#xD;\n    participantRole.addr<b> as </b><span style=\"color: maroon\">addr</span><span style=\"color: navy\"><b> -&gt; </b></span>location.address = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Address'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">address</span><b> then </b>ADAddress<span style=\"color: navy\">(</span><span style=\"color: maroon\">addr</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">address</span><span style=\"color: navy\">)</span> <i>\"address\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Télécom.</span>#xD;\n    participantRole.telecom<b> as </b><span style=\"color: maroon\">telecom</span><span style=\"color: navy\"><b> -&gt; </b></span>location.telecom = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'ContactPoint'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">contactPoint</span><b> then </b>TELContactPoint<span style=\"color: navy\">(</span><span style=\"color: maroon\">telecom</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">contactPoint</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Nom.</span>#xD;\n    participantRole.playingEntity<b> as </b><span style=\"color: maroon\">playingEntity</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      playingEntity.name<b> as </b><span style=\"color: maroon\">name</span><span style=\"color: navy\"><b> -&gt; </b></span>location.name = <span style=\"color: navy\">(</span>name.xmlText<span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Lien Encounter.</span>#xD;\n    participantRole<span style=\"color: navy\"><b> -&gt; </b></span>plannedEncounter.location<b> as </b><span style=\"color: maroon\">encounterLocation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      participantRole<span style=\"color: navy\"><b> -&gt; </b></span> encounterLocation.location = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">locationRef</span><span style=\"color: navy\">, </span> locationRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %location.id<span style=\"color: navy\">)</span> <i>\"locationRef\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"encounterLocation\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"location\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">VACCIN RECOMMANDÉ -&gt; ImmunizationRecommendation</span>#xD;\n<b>group </b>PSPlanImmunizationRecommendationEntry<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">sa</span>, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">ImmunizationRecommendation.</span>#xD;\n  sa<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">recommendationEntry</span><span style=\"color: navy\">, </span> recommendationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'ImmunizationRecommendation'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">recommendation</span><span style=\"color: navy\">, </span> recommendation.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> recommendationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %recommendation.id<span style=\"color: navy\">)</span><b> then </b>PSPlanImmunizationRecommendation<span style=\"color: navy\">(</span><span style=\"color: maroon\">sa</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">recommendation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"recommendation\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanImmunizationRecommendation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">sa</span>, <b>target</b> <span style=\"color: maroon\">recommendation</span><span style=\"color: navy\"> : </span>ImmunizationRecommendation, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant.</span>#xD;\n  sa.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>recommendation.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Patient.</span>#xD;\n  sa<span style=\"color: navy\"><b> -&gt; </b></span> recommendation.patient = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patientRef</span><span style=\"color: navy\">, </span> patientRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"patient\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Date.</span>#xD;\n  sa.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>recommendation.date = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">recommendationDate</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">recommendationDate</span><span style=\"color: navy\">)</span> <i>\"dateValue\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><b> where </b>effectiveTime.value.empty()<span style=\"color: navy\"><b> -&gt; </b></span>recommendation.date = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">recommendationDate</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">recommendationDate</span><span style=\"color: navy\">)</span> <i>\"dateLow\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><b> where </b>effectiveTime.value.empty() and effectiveTime.low.empty()<span style=\"color: navy\"><b> -&gt; </b></span>recommendation.date = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">recommendationDate</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">recommendationDate</span><span style=\"color: navy\">)</span> <i>\"dateHigh\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime<b> where </b>effectiveTime.value.empty() and effectiveTime.low.empty() and effectiveTime.high.empty()<span style=\"color: navy\"><b> -&gt; </b></span>recommendation.date = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span 