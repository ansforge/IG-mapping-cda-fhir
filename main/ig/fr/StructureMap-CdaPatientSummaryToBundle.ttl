></span>repeat.bounds = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">boundsPeriod</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          low<span style=\"color: navy\"><b> -&gt; </b></span>boundsPeriod.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"boundsStart\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"bounds\"</i><span style=\"color: navy\">;</span>#xD;\n        comp.period<b> as </b><span style=\"color: maroon\">period</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          period.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>repeat.period = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'decimal'</span><span style=\"color: navy\">)</span> <i>\"periodValue\"</i><span style=\"color: navy\">;</span>#xD;\n          period.unit<b> as </b><span style=\"color: maroon\">unit</span><span style=\"color: navy\"><b> -&gt; </b></span>repeat.periodUnit = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">unit</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"periodUnit\"</i><span style=\"color: navy\">;</span>#xD;\n          period.translation<b> as </b><span style=\"color: maroon\">translation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            translation.originalText<b> as </b><span style=\"color: maroon\">originalText</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>              originalText.reference<b> as </b><span style=\"color: maroon\">ref</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>                ref.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>childDosage.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"childDosageText\"</i><span style=\"color: navy\">;</span>#xD;\n              <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"repeat\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"timing\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">5. EFFETS INDÉSIRABLES MÉDICAMENTEUX</span>#xD;\n<b>group </b>PatientSummaryAdverseDrugReactionSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Section effets indésirables.</span>#xD;\n  section.templateId<b> as </b><span style=\"color: maroon\">sectionTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    sectionTid.root<b> as </b><span style=\"color: maroon\">sectionRoot</span><b> where </b>sectionRoot = '1.2.250.1.213.1.1.2.247'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        entry.observation<b> as </b><span style=\"color: maroon\">adverseObservation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          adverseObservation.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.210'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">adverseEntry</span><span style=\"color: navy\">, </span> adverseEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'AdverseEvent'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">adverseEvent</span><span style=\"color: navy\">, </span> adverseEvent.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> adverseEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %adverseEvent.id<span style=\"color: navy\">)</span><b> then </b>PatientSummaryAdverseEventFromObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">adverseObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">adverseEvent</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"adverseEvent\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"adverseTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"adverseObservation\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"adverseSection\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"sectionTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Observation CDA -&gt; AdverseEvent</span>#xD;\n<b>group </b>PatientSummaryAdverseEventFromObservation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">adverseObservation</span>, <b>target</b> <span style=\"color: maroon\">adverseEvent</span><span style=\"color: navy\"> : </span>AdverseEvent, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Statut, identifiant et patient.</span>#xD;\n  adverseObservation<span style=\"color: navy\"><b> -&gt; </b></span>adverseEvent.actuality = <span style=\"color: blue\">'actual'</span> <i>\"actualityDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  adverseObservation.moodCode<b> as </b><span style=\"color: maroon\">mood</span><b> where </b>mood = 'INT'<span style=\"color: navy\"><b> -&gt; </b></span>adverseEvent.actuality = <span style=\"color: blue\">'potential'</span> <i>\"actualityPotential\"</i><span style=\"color: navy\">;</span>#xD;\n  adverseObservation.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>adverseEvent.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  adverseObservation<span style=\"color: navy\"><b> -&gt; </b></span> adverseEvent.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Catégorie de l’effet indésirable.</span>#xD;\n  adverseObservation.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>adverseEvent.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code<b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">category</span><span style=\"color: navy\">)</span> <i>\"categoryCoding\"</i><span style=\"color: navy\">;</span>#xD;\n    adverseObservation.text<b> as </b><span style=\"color: maroon\">text</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>category.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"categoryText\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Dates.</span>#xD;\n  adverseObservation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>adverseEvent.date = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">date</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">date</span><span style=\"color: navy\">)</span> <i>\"date\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      high.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>adverseEvent.detected = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">detected</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">detected</span><span style=\"color: navy\">)</span> <i>\"detected\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"detected\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"dates\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Informations complémentaires.</span>#xD;\n  adverseObservation.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">Traitement suspect.</span>#xD;\n    er.substanceAdministration<b> as </b><span style=\"color: maroon\">treatment</span><b> where </b>er.typeCode = 'COMP'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      treatment.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.42'<b> then </b>AdverseEventSuspectMedicationFromTreatment<span style=\"color: navy\">(</span><span style=\"color: maroon\">treatment</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">adverseObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">adverseEvent</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"suspectMedication\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"treatmentTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"treatment\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Réaction observée.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">reactionObservation</span><b> where </b>er.typeCode = 'MFST'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      reactionObservation.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.37'<b> then </b>AdverseEventResultingConditionFromReaction<span style=\"color: navy\">(</span><span style=\"color: maroon\">reactionObservation</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">adverseEvent</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"reaction\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"reactionTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"reaction\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Gravité.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">seriousnessObservation</span><b> where </b>er.typeCode = 'SUBJ'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      seriousnessObservation.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.212'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          seriousnessObservation.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>adverseEvent.seriousness = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">seriousness</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">seriousness</span><span style=\"color: navy\">)</span> <i>\"seriousness\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"seriousness\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"seriousnessTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"seriousness\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Évolution.</span>#xD;\n    er.observation<b> as </b><span style=\"color: maroon\">outcomeObservation</span><b> where </b>er.typeCode = 'SUBJ'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      outcomeObservation.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.213'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          outcomeObservation.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>adverseEvent.outcome = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">outcome</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">outcome</span><span style=\"color: navy\">)</span> <i>\"outcome\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"outcome\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"outcomeTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"outcome\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Commentaire non mappé pour l’instant.</span>#xD;\n    er.act<b> as </b><span style=\"color: maroon\">commentAct</span><b> where </b>er.typeCode = 'SUBJ'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      commentAct.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.32' <i>\"commentNotMapped\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"commentTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"comment\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Référence dans la section FHIR.</span>#xD;\n  adverseObservation<span style=\"color: navy\"><b> -&gt; </b></span> compSection.entry = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">sectionRef</span><span style=\"color: navy\">, </span> sectionRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %adverseEvent.id<span style=\"color: navy\">)</span> <i>\"sectionEntry\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Traitement suspect -&gt; MedicationStatement + suspectEntity</span>#xD;\n<b>group </b>AdverseEventSuspectMedicationFromTreatment<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">treatment</span>, <b>source</b> <span style=\"color: maroon\">adverseObservation</span>, <b>target</b> <span style=\"color: maroon\">adverseEvent</span><span style=\"color: navy\"> : </span>AdverseEvent, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  treatment<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">medicationStatementEntry</span><span style=\"color: navy\">, </span> medicationStatementEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'MedicationStatement'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">, </span> medicationStatement.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> medicationStatementEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %medicationStatement.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">MedicationStatement lié au médicament suspect.</span>#xD;\n    treatment<span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.status = <span style=\"color: blue\">'unknown'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n    treatment.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then </b>MedicationStatementStatusFromCdaStatus<span style=\"color: navy\">(</span><span style=\"color: maroon\">statusCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">)</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n    treatment.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n    treatment<span style=\"color: navy\"><b> -&gt; </b></span> medicationStatement.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n    treatment.code<b> as </b><span style=\"color: maroon\">treatmentCode</span><span style=\"color: navy\"><b> -&gt; </b></span>medicationStatement.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">treatmentCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">category</span><span style=\"color: navy\">)</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n    treatment.consumable<b> as </b><span style=\"color: maroon\">consumable</span><b> then </b>MedicationResourceFromConsumable<span style=\"color: navy\">(</span><span style=\"color: maroon\">consumable</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"medication\"</i><span style=\"color: navy\">;</span>#xD;\n    treatment.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then </b>MedicationStatementEffectiveFromEffectiveTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">)</span> <i>\"effective\"</i><span style=\"color: navy\">;</span>#xD;\n    treatment<b> then </b>MedicationMainDosageFromSubstanceAdministration<span style=\"color: navy\">(</span><span style=\"color: maroon\">treatment</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">medicationStatement</span><span style=\"color: navy\">)</span> <i>\"dosage\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Lien avec AdverseEvent.suspectEntity.</span>#xD;\n    treatment<span style=\"color: navy\"><b> -&gt; </b></span> adverseEvent.suspectEntity<b> as </b><span style=\"color: maroon\">suspectEntity</span><span style=\"color: navy\">, </span> suspectEntity.instance = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">instanceRef</span><span style=\"color: navy\">, </span> instanceRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %medicationStatement.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">Imputabilité.</span>#xD;\n      adverseObservation.entryRelationship<b> as </b><span style=\"color: maroon\">causalityEr</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        causalityEr.observation<b> as </b><span style=\"color: maroon\">causalityObservation</span><b> where </b>causalityEr.typeCode = 'SUBJ'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>          causalityObservation.templateId<b> as </b><span style=\"color: maroon\">tid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            tid.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>root = '1.2.250.1.213.1.1.3.211'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>              causalityObservation.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span> suspectEntity.causality<b> as </b><span style=\"color: maroon\">causality</span><span style=\"color: navy\">, </span> causality.assessment = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">assessment</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">assessment</span><span style=\"color: navy\">)</span> <i>\"causalityAssessment\"</i><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span> <i>\"causality\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"causalityTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"causalityObservation\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"causality\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"suspectEntity\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"suspectMedication\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Réaction observée -&gt; Condition + resultingCondition</span>#xD;\n<b>group </b>AdverseEventResultingConditionFromReaction<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">reactionObservation</span>, <b>target</b> <span style=\"color: maroon\">adverseEvent</span><span style=\"color: navy\"> : </span>AdverseEvent, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">conditionEntry</span><span style=\"color: navy\">, </span> conditionEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Condition'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">condition</span><span style=\"color: navy\">, </span> condition.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> conditionEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %condition.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">Condition liée à la réaction.</span>#xD;\n    reactionObservation.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n    reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span> condition.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n    reactionObservation.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.category = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">category</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">category</span><span style=\"color: navy\">)</span> <i>\"category\"</i><span style=\"color: navy\">;</span>#xD;\n    reactionObservation.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">conditionCode</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">conditionCode</span><span style=\"color: navy\">)</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n    reactionObservation.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.onset = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">onset</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">onset</span><span style=\"color: navy\">)</span> <i>\"onset\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        high.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>condition.abatement = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">abatement</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">abatement</span><span style=\"color: navy\">)</span> <i>\"abatement\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"abatement\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">Lien avec AdverseEvent.resultingCondition.</span>#xD;\n    reactionObservation<span style=\"color: navy\"><b> -&gt; </b></span> adverseEvent.resultingCondition = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">conditionRef</span><span style=\"color: navy\">, </span> conditionRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %condition.id<span style=\"color: navy\">)</span> <i>\"resultingCondition\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"reactionCondition\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">6. VACCINATIONS</span>#xD;\n<b>group </b>PatientSummaryImmunizationSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Section vaccinations.</span>#xD;\n  section.templateId<b> as </b><span style=\"color: maroon\">sectionTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    sectionTid.root<b> as </b><span style=\"color: maroon\">sectionRoot</span><b> where </b>sectionRoot = '1.2.250.1.213.1.1.2.147'<b> then</b><span style=\"color: navy\"> {#xD;\n</span>      section.entry<b> as </b><span style=\"color: maroon\">entry</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        entry.substanceAdministration<b> as </b><span style=\"color: maroon\">substanceAdministration</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          substanceAdministration.templateId<b> as </b><span style=\"color: maroon\">immunizationTid</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            immunizationTid.root<b> as </b><span style=\"color: maroon\">immunizationRoot</span><b> where </b>immunizationRoot = '1.2.250.1.213.1.1.3.45'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">immunizationEntry</span><span style=\"color: navy\">, </span> immunizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Immunization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">immunization</span><span style=\"color: navy\">, </span> immunization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> immunizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %immunization.id<span style=\"color: navy\">)</span><b> then </b>PatientSummaryImmunizationFromSubstanceAdministration<span style=\"color: navy\">(</span><span style=\"color: maroon\">substanceAdministration</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">immunization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"immunization\"</i><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span> <i>\"immunizationTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"vaccinationSection\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"sectionTemplate\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">substanceAdministration CDA -&gt; Immunization</span>#xD;\n<b>group </b>PatientSummaryImmunizationFromSubstanceAdministration<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">substanceAdministration</span>, <b>target</b> <span style=\"color: maroon\">immunization</span><span style=\"color: navy\"> : </span>Immunization, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Statut, identifiant, patient et date.</span>#xD;\n  substanceAdministration<span style=\"color: navy\"><b> -&gt; </b></span>immunization.status = <span style=\"color: blue\">'completed'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration.negationInd<b> as </b><span style=\"color: maroon\">negation</span><b> where </b>negation = 'true'<span style=\"color: navy\"><b> -&gt; </b></span>immunization.status = <span style=\"color: blue\">'not-done'</span> <i>\"statusNotDoneByNegation\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>immunization.status = <span style=\"color: blue\">'completed'</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>immunization.status = <span style=\"color: blue\">'not-done'</span> <i>\"aborted\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>immunization.status = <span style=\"color: blue\">'not-done'</span> <i>\"cancelled\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>immunization.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration<span style=\"color: navy\"><b> -&gt; </b></span> immunization.patient = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patientRef</span><span style=\"color: navy\">, </span> patientRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"patient\"</i><span style=\"color: navy\">;</span>#xD;\n  substanceAdministration.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\"><b> -&gt; </b></span>immunization.occurrence = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">occurrenceDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">occurrenceDateTime</span><span style=\"color: navy\">)</span> <i>\"occurrenceDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Vaccin et numéro de lot.</span>#xD;\n  substanceAdministration.consumable<b> as </b><span style=\"color: maroon\">consumable</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    consumable.manufacturedProduct<b> as </b><span style=\"color: maroon\">manufacturedProduct</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      manufacturedProduct.manufacturedMaterial<b> as </b><span style=\"color: maroon\">manufacturedMaterial</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        manufacturedMaterial.code<b> as </b><span style=\"color: maroon\">vaccineCode</span><span style=\"color: navy\"><b> -&gt; </b></span>immunization.vaccineCode = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          vaccineCode<b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">vaccineCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">code</span><span style=\"color: navy\">)</span> <i>\"vaccineCoding\"</i><span style=\"color: navy\">;</span>#xD;\n          substanceAdministration.text<b> as </b><span style=\"color: maroon\">text</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            text.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>              reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>code.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"vaccineText\"</i><span style=\"color: navy\">;</span>#xD;\n            <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"vaccineCode\"</i><span style=\"color: navy\">;</span>#xD;\n        manufacturedMaterial.lotNumberText<b> as </b><span style=\"color: maroon\">lotNumberText</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          lotNumberText.xmlText<b> as </b><span style=\"color: maroon\">lot</span><span style=\"color: navy\"><b> -&gt; </b></span>immunization.lotNumber = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">lot</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"lotNumber\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"vaccine\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Voie d’administration.</span>#xD;\n  substanceAdministration.routeCode<b> as </b><span style=\"color: maroon\">routeCode</span><span style=\"color: navy\"><b> -&gt; </b></span>immunization.route = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">route</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    routeCode<b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">routeCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">route</span><span style=\"color: navy\">)</span> <i>\"routeCode\"</i><span style=\"color: navy\">;</span>#xD;\n    routeCode.originalText<b> as </b><span style=\"color: maroon\">originalText</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      originalText.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>route.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"routeText\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"route\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Site d’administration.</span>#xD;\n  substanceAdministration.approachSiteCode<b> as </b><span style=\"color: maroon\">siteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>immunization.site = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">site</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    siteCode<b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">siteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">site</span><span style=\"color: navy\">)</span> <i>\"siteCode\"</i><span style=\"color: navy\">;</span>#xD;\n    siteCode.originalText<b> as </b><span style=\"color: maroon\">originalText</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      originalText.reference<b> as </b><span style=\"color: maroon\">reference</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        reference.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>site.text = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"siteText\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"site\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Protocole vaccinal.</span>#xD;\n  substanceAdministration.code<b> as </b><span style=\"color: maroon\">seriesCode</span><span style=\"color: navy\"><b> -&gt; </b></span>immunization.protocolApplied<b> as </b><span style=\"color: maroon\">protocol</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    seriesCode.displayName<b> as </b><span style=\"c