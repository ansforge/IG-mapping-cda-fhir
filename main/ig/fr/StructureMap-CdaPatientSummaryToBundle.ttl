navy\">(</span>'urn:uuid:' + %serviceRequest.id<span style=\"color: navy\">)</span><b> then </b>PSPlanServiceRequest<span style=\"color: navy\">(</span><span style=\"color: maroon\">obs</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">serviceRequest</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"serviceRequest\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanServiceRequest<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">obs</span>, <b>target</b> <span style=\"color: maroon\">serviceRequest</span><span style=\"color: navy\"> : </span>ServiceRequest, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Statut.</span>#xD;\n  obs<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.status = <span style=\"color: blue\">'active'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  obs.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.status = <span style=\"color: blue\">'active'</span> <i>\"active\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.status = <span style=\"color: blue\">'completed'</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.status = <span style=\"color: blue\">'revoked'</span> <i>\"aborted\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.status = <span style=\"color: blue\">'revoked'</span> <i>\"cancelled\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'suspended'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.status = <span style=\"color: blue\">'on-hold'</span> <i>\"suspended\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Intention.</span>#xD;\n  obs<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.intent = <span style=\"color: blue\">'plan'</span> <i>\"intentDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  obs.moodCode<b> as </b><span style=\"color: maroon\">moodCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    moodCode<b> where </b>moodCode = 'INT'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.intent = <span style=\"color: blue\">'plan'</span> <i>\"intent\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'GOL'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.intent = <span style=\"color: blue\">'plan'</span> <i>\"goal\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'PRP'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.intent = <span style=\"color: blue\">'proposal'</span> <i>\"proposal\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'RQO'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.intent = <span style=\"color: blue\">'order'</span> <i>\"order\"</i><span style=\"color: navy\">;</span>#xD;\n    moodCode<b> where </b>moodCode = 'ARQ'<span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.intent = <span style=\"color: blue\">'order'</span> <i>\"appointmentRequest\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"intent\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant.</span>#xD;\n  obs.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Patient.</span>#xD;\n  obs<span style=\"color: navy\"><b> -&gt; </b></span> serviceRequest.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Code.</span>#xD;\n  obs.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">codeableConcept</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">codeableConcept</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Note.</span>#xD;\n  obs.text<b> as </b><span style=\"color: maroon\">text</span><b> then </b>PSPlanTextToNote<span style=\"color: navy\">(</span><span style=\"color: maroon\">text</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">serviceRequest</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Commentaire.</span>#xD;\n  obs.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then </b>PSPlanCommentToNote<span style=\"color: navy\">(</span><span style=\"color: maroon\">er</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">serviceRequest</span><span style=\"color: navy\">)</span> <i>\"comment\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Période.</span>#xD;\n  obs.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.occurrence = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">occurrenceDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">occurrenceDateTime</span><span style=\"color: navy\">)</span> <i>\"dateTime\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.occurrence = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">period</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      low<span style=\"color: navy\"><b> -&gt; </b></span>period.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"start\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>period.end = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">end</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">end</span><span style=\"color: navy\">)</span> <i>\"end\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"period\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"occurrence\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Détail.</span>#xD;\n  obs.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.orderDetail = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">orderDetail</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">value</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">orderDetail</span><span style=\"color: navy\">)</span> <i>\"orderDetail\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Site.</span>#xD;\n  obs.targetSiteCode<b> as </b><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>serviceRequest.bodySite = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">bodySite</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bodySite</span><span style=\"color: navy\">)</span> <i>\"bodySite\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Lien CarePlan.</span>#xD;\n  obs<span style=\"color: navy\"><b> -&gt; </b></span> carePlan.supportingInfo = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">supportRef</span><span style=\"color: navy\">, </span> supportRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %serviceRequest.id<span style=\"color: navy\">)</span> <i>\"supportingInfo\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">ACTE PRÉVU -&gt; Procedure</span>#xD;\n<b>group </b>PSPlanProcedureEntry<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">proc</span>, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Procedure.</span>#xD;\n  proc<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">procedureEntry</span><span style=\"color: navy\">, </span> procedureEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Procedure'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\">, </span> fhirProcedure.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> procedureEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %fhirProcedure.id<span style=\"color: navy\">)</span><b> then </b>PSPlanProcedure<span style=\"color: navy\">(</span><span style=\"color: maroon\">proc</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">carePlan</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"procedure\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>PSPlanProcedure<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">proc</span>, <b>target</b> <span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\"> : </span>Procedure, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Statut.</span>#xD;\n  proc<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'preparation'</span> <i>\"statusDefault\"</i><span style=\"color: navy\">;</span>#xD;\n  proc.statusCode<b> as </b><span style=\"color: maroon\">statusCode</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'active'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'preparation'</span> <i>\"active\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'completed'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'completed'</span> <i>\"completed\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'aborted'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'stopped'</span> <i>\"aborted\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'cancelled'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'stopped'</span> <i>\"cancelled\"</i><span style=\"color: navy\">;</span>#xD;\n    statusCode.code<b> as </b><span style=\"color: maroon\">code</span><b> where </b>code = 'suspended'<span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.status = <span style=\"color: blue\">'on-hold'</span> <i>\"suspended\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Identifiant.</span>#xD;\n  proc.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Patient.</span>#xD;\n  proc<span style=\"color: navy\"><b> -&gt; </b></span> fhirProcedure.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Code.</span>#xD;\n  proc.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">procedureCode</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">procedureCode</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Note.</span>#xD;\n  proc.text<b> as </b><span style=\"color: maroon\">text</span><b> then </b>PSPlanTextToNote<span style=\"color: navy\">(</span><span style=\"color: maroon\">text</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Commentaire.</span>#xD;\n  proc.entryRelationship<b> as </b><span style=\"color: maroon\">er</span><b> then </b>PSPlanCommentToNote<span style=\"color: navy\">(</span><span style=\"color: maroon\">er</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">fhirProcedure</span><span style=\"color: navy\">)</span> <i>\"comment\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Date.</span>#xD;\n  proc.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    effectiveTime.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.performed = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">performedDateTime</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">performedDateTime</span><span style=\"color: navy\">)</span> <i>\"dateTime\"</i><span style=\"color: navy\">;</span>#xD;\n    effectiveTime.low<b> as </b><span style=\"color: maroon\">low</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.performed = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">period</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      low<span style=\"color: navy\"><b> -&gt; </b></span>period.start = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">start</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">low</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">start</span><span style=\"color: navy\">)</span> <i>\"start\"</i><span style=\"color: navy\">;</span>#xD;\n      effectiveTime.high<b> as </b><span style=\"color: maroon\">high</span><span style=\"color: navy\"><b> -&gt; </b></span>period.end = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">end</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">high</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">end</span><span style=\"color: navy\">)</span> <i>\"end\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"period\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"performed\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Site cible.</span>#xD;\n  proc.targetSiteCode<b> as </b><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.bodySite = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">bodySite</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">targetSiteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bodySite</span><span style=\"color: navy\">)</span> <i>\"targetSite\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Voie d’abord.</span>#xD;\n  proc.approachSiteCode<b> as </b><span style=\"color: maroon\">approachSiteCode</span><span style=\"color: navy\"><b> -&gt; </b></span>fhirProcedure.bodySite = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">bodySite</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">approachSiteCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bodySite</span><span style=\"color: navy\">)</span> <i>\"approachSite\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Lien CarePlan.</span>#xD;\n  proc<span style=\"color: navy\"><b> -&gt; </b></span> carePlan.supportingInfo = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">supportRef</span><span style=\"color: navy\">, </span> supportRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %fhirProcedure.id<span style=\"color: navy\">)</span> <i>\"supportingInfo\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">RENCONTRE PRÉVUE -&gt; Encounter</span>#xD;\n<b>group </b>PSPlanEncounterEntry<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">enc</span>, <b>target</b> <span style=\"color: maroon\">carePlan</span><span style=\"color: navy\"> : </span>CarePlan, <b>target</b> <span style=\"color: maroon\">compSection</span>, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Encounter.</span>#xD;\n  enc<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">encounterEntry</span><span style=\"color: navy\">, </span> encounterEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Encounter'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">plannedEncounter</span><span style=\"color: navy\">, </span> plannedEncounter.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> encounterEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %plannedEncounter.id<span style=\"color: navy\">)</span><b> then </b>PSPlanEncounter<span style=\"color: navy\">(</span><span style=\"color: maroo