  <span style="color: #b36b00" title="Cet élément nétait pas défini avant R5">// ob.value as v -&gt; obs.value = cast(v, 'string');</span>
  ob.value<b> as </b><span style="color: maroon">ObsValue</span><span style="color: navy"><b> -&gt; </b></span>obs.value = <b>create</b><span style="color: navy">(</span><span style="color: blue">'Quantity'</span><span style="color: navy">)</span><b> as </b><span style="color: maroon">quant</span><b> then </b>PQQuantity<span style="color: navy">(</span><span style="color: maroon">ObsValue</span><span style="color: navy">, </span><span style="color: maroon">quant</span><span style="color: navy">)</span> <i>&quot;numerator&quot;</i><span style="color: navy">;</span>
  <span style="color: #b36b00" title="Cet élément nétait pas défini avant R5">// ob.value as obValue then {</span>
  <span style="color: navy">// </span><span style="color: green">obValue.value as numerator -&gt; obs.value as targetNumerator then PQQuantity(numerator, targetNumerator) &quot;numerator&quot;;</span>
  <span style="color: navy">// </span><span style="color: green">} &quot;SetObsValue&quot;;</span>
  <span style="color: #b36b00" title="Cet élément nétait pas défini avant R5">// ob.statusCode as v -&gt; obs.value = v;</span>
  ob<span style="color: navy"><b> -&gt; </b></span> obs.subject = <b>create</b><span style="color: navy">(</span><span style="color: blue">'Reference'</span><span style="color: navy">)</span><b> as </b><span style="color: maroon">reference</span><span style="color: navy">, </span> reference.reference = <span style="color: navy">(</span>'urn:uuid:' + %patient.id<span style="color: navy">)</span> <i>&quot;setObsSubject&quot;</i><span style="color: navy">;</span>
<span style="color: navy">}

