</span>  <span style="color: navy">// </span><span style="color: green">Ajout du statusCode</span>
  <span style="color: #b36b00" title="Cet élément nétait pas défini avant R5">// ob.statusCode as c then {</span>
  <span style="color: navy">// </span><span style="color: green">c.code as statCode -&gt; obs.value = cast(statCode, 'string') &quot;AjoutValueString&quot;;</span>
  <span style="color: navy">// </span><span style="color: green">} &quot;SetObsValue&quot;;</span>
