xD;\n</span><b>group </b>MapCDAEncompassingEncounterToFrenchEncounter<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>EncompassingEncounter, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Encounter, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter -&gt; FHIR Encounter.meta.profile</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.meta<b> as </b><span style=\"color: maroon\">metaBlock</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>metaBlock.profile = <span style=\"color: blue\">'https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-encounter'</span> <i>\"profile\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"meta\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter.code -&gt; FHIR Encounter.type NOS</span>#xD;\n  src.code<b> as </b><span style=\"color: maroon\">srcCode</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.type = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">cc</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    srcCode.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>cc.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      code<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'https://mos.esante.gouv.fr/NOS/TRE_R304-HL7v3ActCode/FHIR/TRE-R304-HL7v3ActCode'</span> <i>\"typeSystem\"</i><span style=\"color: navy\">;</span>#xD;\n      code<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">code</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"typeCode\"</i><span style=\"color: navy\">;</span>#xD;\n      srcCode.displayName<b> as </b><span style=\"color: maroon\">display</span><span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">display</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"typeDisplay\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"coding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"encounterType\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility -&gt; FHIR Location française</span>#xD;\n<b>group </b>MapCDAHealthCareFacilityToFrenchLocation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>HealthCareFacility, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Location, <b>target</b> <span style=\"color: maroon\">facilityOrganization</span><span style=\"color: navy\"> : </span>Organization<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility -&gt; FHIR Location.meta.profile</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.meta<b> as </b><span style=\"color: maroon\">metaBlock</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>metaBlock.profile = <span style=\"color: blue\">'https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-location'</span> <i>\"frCoreLocationProfile\"</i><span style=\"color: navy\">;</span>#xD;\n    src<span style=\"color: navy\"><b> -&gt; </b></span>metaBlock.profile = <span style=\"color: blue\">'https://interop.esante.gouv.fr/ig/fhir/annuaire/StructureDefinition/as-location'</span> <i>\"asLocationProfile\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"meta\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility.location.name -&gt; FHIR Location.name</span>#xD;\n  src.location<b> as </b><span style=\"color: maroon\">facilityLocation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    facilityLocation.name<b> as </b><span style=\"color: maroon\">locName</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      locName.item<b> as </b><span style=\"color: maroon\">item</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.name = <span style=\"color: navy\">(</span>item.xmlText<span style=\"color: navy\">)</span> <i>\"locationName\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"locationName\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"facilityLocation\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility sans location -&gt; FHIR Location.name data-absent-reason</span>#xD;\n  src<b> where </b>src.location.empty()<span style=\"color: navy\"><b> -&gt; </b></span>tgt.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">nameString</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>nameString.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      src<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      src<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"locationNameAbsentReasonNoLocation\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility.location sans name -&gt; FHIR Location.name data-absent-reason</span>#xD;\n  src.location<b> as </b><span style=\"color: maroon\">facilityLocation</span><b> where </b>facilityLocation.name.empty()<span style=\"color: navy\"><b> -&gt; </b></span>tgt.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">nameString</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    facilityLocation<span style=\"color: navy\"><b> -&gt; </b></span>nameString.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      facilityLocation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      facilityLocation<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"locationNameAbsentReasonNoName\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility.code -&gt; FHIR Location.type NOS</span>#xD;\n  src.code<b> as </b><span style=\"color: maroon\">srcCode</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.type = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">cc</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    srcCode.code<b> as </b><span style=\"color: maroon\">code</span><span style=\"color: navy\"><b> -&gt; </b></span>cc.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"col