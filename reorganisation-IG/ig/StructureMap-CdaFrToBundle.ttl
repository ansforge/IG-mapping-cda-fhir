span><span style=\"color: maroon\">relatedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">trustedPersonRelatedPerson</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"relatedPersonFR\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"relatedPersonNOK\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA guardian -&gt; création RelatedPerson + enrichissement français</span>#xD;\n<b>group </b>MapHeaderGuardianWithFrenchRules<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.recordTarget<b> as </b><span style=\"color: maroon\">recordTarget</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    recordTarget.patientRole<b> as </b><span style=\"color: maroon\">patientRole</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      patientRole.patient<b> as </b><span style=\"color: maroon\">patientCda</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        patientCda.guardian<b> as </b><span style=\"color: maroon\">guardian</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">guardianEntry</span><span style=\"color: navy\">, </span> guardianEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'RelatedPerson'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">guardianRelatedPerson</span><span style=\"color: navy\">, </span> guardianRelatedPerson.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> guardianEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %guardianRelatedPerson.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          guardian<span style=\"color: navy\"><b> -&gt; </b></span> guardianRelatedPerson.patient = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patientRef</span><span style=\"color: navy\">, </span> patientRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"patientRef\"</i><span style=\"color: navy\">;</span>#xD;\n          guardian.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>guardianRelatedPerson.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n          guardian.addr<b> as </b><span style=\"color: maroon\">addr</span><span style=\"color: navy\"><b> -&gt; </b></span>guardianRelatedPerson.address = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Address'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">address</span><b> then </b>ADAddress<span style=\"color: navy\">(</span><span style=\"color: maroon\">addr</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">address</span><span style=\"color: navy\">)</span> <i>\"address\"</i><span style=\"color: navy\">;</span>#xD;\n          guardian.telecom<b> as </b><span style=\"color: maroon\">telecom</span><span style=\"color: navy\"><b> -&gt; </b></span>guardianRelatedPerson.telecom = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'ContactPoint'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">contactPoint</span><b> then </b>TELContactPoint<span style=\"color: navy\">(</span><span style=\"color: maroon\">telecom</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">contactPoint</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n          guardian.guardianPerson<b> as </b><span style=\"color: maroon\">guardianPerson</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            guardianPerson.name<b> as </b><span style=\"color: maroon\">name</span><span style=\"color: navy\"><b> -&gt; </b></span>guardianRelatedPerson.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'HumanName'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">humanName</span><b> then </b>ENHumanName<span style=\"color: navy\">(</span><span style=\"color: maroon\">name</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">humanName</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n          guardian<b> then </b>MapCDAGuardianToFrenchRelatedPerson<span style=\"color: navy\">(</span><span style=\"color: maroon\">guardian</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">guardianRelatedPerson</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"guardianFR\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"guardianResource\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>MapCDARecordTargetToFrenchPatient<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>PatientRole, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole -&gt; FHIR Patient.meta.profile</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.meta<b> as </b><span style=\"color: maroon\">meta</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>meta.profile = <span style=\"color: blue\">'https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-patient-ins'</span> <i>\"patientINSProfile\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"meta\"</i><span style=\"color: navy\">;</span>#xD;\n  src.patient<b> as </b><span style=\"color: maroon\">patient</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patient.name -&gt; FHIR Patient.name officiel</span>#xD;\n    patient.name<b> as </b><span style=\"color: maroon\">patientName</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'HumanName'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">officialName</span><b> then </b>MapCDAPatientNameToFrenchOfficialName<span style=\"color: navy\">(</span><span style=\"color: maroon\">patientName</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">officialName</span><span style=\"color: navy\">)</span> <i>\"officialName\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patient.birthplace -&gt; FHIR Patient.extension birthPlace</span>#xD;\n    patient.birthplace<b> as </b><span style=\"color: maroon\">birthplace</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">birthPlaceExt</span><b> then </b>MapCDABirthPlaceToFHIRPatientExtension<span style=\"color: navy\">(</span><span style=\"color: maroon\">birthplace</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">birthPlaceExt</span><span style=\"color: navy\">)</span> <i>\"birthPlace\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"patientDataFR\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole.id -&gt; FHIR Patient.identifier INS</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> then </b>MapCDAIIToPatientINSIdentifiers<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"insIdentifiers\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole.id -&gt; FHIR Patient.identifier PI hors INS</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> then </b>MapCDAIIToPatientOtherIdentifiers<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"otherIdentifiers\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole.id INS-NIR -&gt; FHIR Patient.extension identity reliability VALI</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> where </b>id.root = '1.2.250.1.213.1.4.8'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identityReliability</span><b> then </b>MapCDAIIToIdentityReliabilityVALI<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identityReliability</span><span style=\"color: navy\">)</span> <i>\"identityReliabilityNIR\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole.id INS-NIA -&gt; FHIR Patient.extension identity reliability VALI</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> where </b>id.root = '1.2.250.1.213.1.4.9'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identityReliability</span><b> then </b>MapCDAIIToIdentityReliabilityVALI<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identityReliability</span><span style=\"color: navy\">)</span> <i>\"identityReliabilityNIA\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole.id INS-NIR-TEST -&gt; FHIR Patient.extension identity reliability VALI</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> where </b>id.root = '1.2.250.1.213.1.4.10'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identityReliability</span><b> then </b>MapCDAIIToIdentityReliabilityVALI<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identityReliability</span><span style=\"color: navy\">)</span> <i>\"identityReliabilityNIRTest\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole.id INS-NIR-DEMO -&gt; FHIR Patient.extension identity reliability VALI</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> where </b>id.root = '1.2.250.1.213.1.4.11'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identityReliability</span><b> then </b>MapCDAIIToIdentityReliabilityVALI<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identityReliability</span><span style=\"color: navy\">)</span> <i>\"identityReliabilityNIRDemo\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA PN patient.name -&gt; FHIR HumanName officiel</span>#xD;\n<b>group </b>MapCDAPatientNameToFrenchOfficialName<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>PN, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>HumanName<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patient.name -&gt; FHIR HumanName.use</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.use = <span style=\"color: blue\">'official'</span> <i>\"use\"</i><span style=\"color: navy\">;</span>#xD;\n  src.item<b> as </b><span style=\"color: maroon\">item</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA family qualifier=BR -&gt; FHIR HumanName.family</span>#xD;\n    item.family<b> as </b><span style=\"color: maroon\">family</span><b> where </b>family.qualifier = 'BR'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.family = <span style=\"color: navy\">(</span>family.xmlText<span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA given qualifier=BR -&gt; FHIR HumanName.given</span>#xD;\n    item.given<b> as </b><span style=\"color: maroon\">given</span><b> where </b>given.qualifier = 'BR'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.given = <span style=\"color: navy\">(</span>given.xmlText<span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA given sans qualifier -&gt; FHIR HumanName.extension liste des prénoms de naissance</span>#xD;\n    item.given<b> as </b><span style=\"color: maroon\">givenList</span><b> where </b>givenList.qualifier.empty()<span style=\"color: navy\"><b> -&gt; </b></span>tgt.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">ext</span><b> then </b>MapCDAGivenNameToBirthListGivenNameExtension<span style=\"color: navy\">(</span><span style=\"color: maroon\">givenList</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">ext</span><span style=\"color: navy\">)</span> <i>\"birthListGivenName\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"items\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA given sans qualifier -&gt; FHIR extension liste des prénoms de naissance</span>#xD;\n<b>group </b>MapCDAGivenNameToBirthListGivenNameExtension<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Extension<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA given -&gt; FHIR Extension.url</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.url = <span style=\"color: blue\">'https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-patient-birth-list-given-name'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA given.xmlText -&gt; FHIR Extension.valueString</span>#xD;\n  src.xmlText<b> as </b><span style=\"color: maroon\">txt</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">txt</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"valueString\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA patient.birthplace -&gt; FHIR Patient.extension birthPlace</span>#xD;\n<b>group </b>MapCDABirthPlaceToFHIRPatientExtension<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Extension<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA birthplace -&gt; FHIR Extension.url</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/patient-birthPlace'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA birthplace.place.addr -&gt; FHIR Extension.valueAddress</span>#xD;\n  src.place<b> as </b><span style=\"color: maroon\">place</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Address'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">addr</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    place.addr<b> as </b><span style=\"color: maroon\">placeAddr</span><b> then </b>ADAddress<span style=\"color: navy\">(</span><span style=\"color: maroon\">placeAddr</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">addr</span><span style=\"color: navy\">)</span> <i>\"baseAddress\"</i><span style=\"color: navy\">;</span>#xD;\n    place.addr<b> as </b><span style=\"color: maroon\">placeAddr</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      placeAddr.item<b> as </b><span style=\"color: maroon\">item</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        <span style=\"color: navy\">// </span><span style=\"color: green\">CDA county -&gt; FHIR Addr