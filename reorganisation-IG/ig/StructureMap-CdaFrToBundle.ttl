pan style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      guardian<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"relationshipAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span></pre></div><div xml:lang=\"en\" lang=\"en\"><hr/><p><b>English</b></p><hr/><p class=\"res-header-id\"><b>Generated Narrative: StructureMap CdaFrToBundle</b></p><a name=\"en-CdaFrToBundle\"> </a><a name=\"en-hcCdaFrToBundle\"> </a><pre class=\"fml\">#xD;\n<b>map</b><span style=\"color: navy\"> \"</span>https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaFrToBundle<span style=\"color: navy\">\" = \"</span>CdaFrToBundle<span style=\"color: navy\">\"#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Mapping CDA-FR vers FHIR - Socle enrichi français</span>#xD;\n#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-ClinicalDocument.html\" title=\"ClinicalDocument (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/ClinicalDocument|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>ClinicalDocument <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-PatientRole.html\" title=\"PatientRole (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/PatientRole|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>PatientRole <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-PN.html\" title=\"PN: PersonName (V3 Data Type)\">http://hl7.org/cda/stds/core/StructureDefinition/PN|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>PN <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-II.html\" title=\"II: InstanceIdentifier (V3 Data Type)\">http://hl7.org/cda/stds/core/StructureDefinition/II|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>II <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-RelatedEntity.html\" title=\"RelatedEntity (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/RelatedEntity|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>RelatedEntity <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-EncompassingEncounter.html\" title=\"EncompassingEncounter (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/EncompassingEncounter|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>EncompassingEncounter <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-HealthCareFacility.html\" title=\"HealthCareFacility (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/HealthCareFacility|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>HealthCareFacility <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/bundle.html\" title=\"Bundle\">http://hl7.org/fhir/StructureDefinition/Bundle|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Bundle <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/composition.html\" title=\"Composition\">http://hl7.org/fhir/StructureDefinition/Composition|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Composition <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/patient.html\" title=\"Patient\">http://hl7.org/fhir/StructureDefinition/Patient|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Patient <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#HumanName\" title=\"HumanName\">http://hl7.org/fhir/StructureDefinition/HumanName|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>HumanName <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/extensibility.html#Extension\" title=\"Extension\">http://hl7.org/fhir/StructureDefinition/Extension|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Extension <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Address\" title=\"Address\">http://hl7.org/fhir/StructureDefinition/Address|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Address <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Coding\" title=\"Coding\">http://hl7.org/fhir/StructureDefinition/Coding|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Coding <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Identifier\" title=\"Identifier\">http://hl7.org/fhir/StructureDefinition/Identifier|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Identifier <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#CodeableConcept\" title=\"CodeableConcept\">http://hl7.org/fhir/StructureDefinition/CodeableConcept|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>CodeableConcept <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/organization.html\" title=\"Organization\">http://hl7.org/fhir/StructureDefinition/Organization|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Organization <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/practitioner.html\" title=\"Practitioner\">http://hl7.org/fhir/StructureDefinition/Practitioner|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Practitioner <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/practitionerrole.html\" title=\"PractitionerRole\">http://hl7.org/fhir/StructureDefinition/PractitionerRole|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>PractitionerRole <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/relatedperson.html\" title=\"RelatedPerson\">http://hl7.org/fhir/StructureDefinition/RelatedPerson|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>RelatedPerson <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/encounter.html\" title=\"Encounter\">http://hl7.org/fhir/StructureDefinition/Encounter|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Encounter <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/location.html\" title=\"Location\">http://hl7.org/fhir/StructureDefinition/Location|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Location <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Meta\" title=\"Meta\">http://hl7.org/fhir/StructureDefinition/Meta|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Meta <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#code\" title=\"code\">http://hl7.org/fhir/StructureDefinition/code|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>code <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#string\" title=\"string\">http://hl7.org/fhir/StructureDefinition/string|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>string <b>as </b><b>target</b>#xD;\n#xD;\n<b>imports</b><span style=\"color: navy\"> \"</span><a href=\"StructureMap-CdaToFHIRTypes.html\" title=\"Mapping de CDA vers les FHIR Types (A partir des sources de Oliver Egger)\">https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaToFHIRTypes</a><span style=\"color: navy\">\"#xD;\n</span><b>imports</b><span style=\"color: navy\"> \"</span><a href=\"StructureMap-CdaToBundle.html\" title=\"Mapping CDA vers FHIR - Étape 2 socle générique orienté CDA\">https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaToBundle</a><span style=\"color: navy\">\"#xD;\n</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE D’ENTRÉE — CRÉATION DU SOCLE FRANÇAIS</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe crée le Bundle final de l’étape 3 avec Composition et Patient.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Les autres ressources administratives sont créées dans les groupes CDA qui</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   les justifient, afin d’éviter les ressources optionnelles vides</span>#xD;\n<b>group </b>TransformClinicalDocumentToFrenchFHIRDocument<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">cda</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  cda<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">compositionEntry</span><span style=\"color: navy\">, </span> compositionEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Composition'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span> composition.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> compositionEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %composition.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">patientEntry</span><span style=\"color: navy\">, </span> patientEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Patient'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span> patient.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> patientEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span><b> then </b>OrchestrateClinicalDocumentFrenchTransformation<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"main\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE D’ORCHESTRATION — SOCLE GÉNÉRIQUE + ENRICHISSEMENT FRANÇAIS</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe suit la structure du ClinicalDocument CDA.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Il appelle d’abord le traitement français de l’en-tête, où chaque ressource</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   optionnelle est créée dans le groupe correspondant au bloc CDA. Il appelle</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   ensuite le corps générique de l’étape 2 pour créer les sections narratives</span>#xD;\n<b>group </b>OrchestrateClinicalDocumentFrenchTransformation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">cda</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument.header -&gt; socle générique + enrichissement français</span>#xD;\n  cda<b> then </b>MapClinicalDocumentHeaderWithFrenchRules<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"headerFrenchBase\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument.structuredBody -&gt; FHIR Composition.section title/code/text</span>#xD;\n  cda<b> then </b>MapClinicalDocumentBody<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"body\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — EN-TÊTE CDA AVEC RÈGLES FRANÇAISES</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe reprend l’organisation de l’en-tête CDA. Les ressources optionnelles</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   sont créées dans les sous-groupes correspondant aux blocs CDA, puis remplies</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   avec les groupes génériques de l’étape 2 et enrichies avec les groupes français</span>#xD;\n<b>group </b>MapClinicalDocumentHeaderWithFrenchRules<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">cda</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument -&gt; profils généraux Bundle / Composition</span>#xD;\n  <span style=\"color: #b36b00\" title=\"This element was not defined prior to R5\">// cda -&gt; bundle.meta as bundleMeta then { cda -&gt; bundleMeta.profile = 'http://hl7.org/fhir/StructureDefinition/Bundle' \"bundleGenericProfile\"; } \"bundleMetaProfile\";</span>#xD;\n  <span style=\"color: #b36b00\" title=\"This element was not defined prior to R5\">// cda -&gt; composition.meta as compositionMeta then { cda -&gt; compositionMeta.profile = 'http://hl7.org/fhir/StructureDefinition/Composition' \"compositionGenericProfile\"; } \"compositionMetaProfile\";</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument -&gt; FHIR Bundle.meta.profile EU EPS</span>#xD;\n  cda<span style=\"color: navy\"><b> -&gt; </b></span>bundle.meta<b> as </b><span style=\"color: maroon\">bundleMeta</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    cda<span style=\"color: navy\"><b> -&gt; </b></span>bundleMeta.profile = <span style=\"color: blue\">'http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps'</span> <i>\"bundleEUEPSProfile\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"bundleMetaProfile\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument -&gt; FHIR Composition.meta.profile EU EPS</span>#xD;\n  cda<span style=\"color: navy\"><b> -&gt; </b></span>composition.meta<b> as </b><span style=\"color: maroon\">compositionMeta</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    cda<span style=\"color: navy\"><b> -&gt; </b></span>compositionMeta.profile = <span style=\"color: blue\">'http://hl7.eu/fhir/eps/StructureDefinition/composition-eu-eps'</span> <i>\"compositionEUEPSProfile\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"compositionMetaProfile\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA id/setId/versionNumber/effectiveTime -&gt; FHIR métadonnées Bundle + Composition</span>#xD;\n  cda<b> then </b>MapHeaderDocumentIdentity<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">)</span> <i>\"documentIdentity\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA languageCode/code/title/effectiveTime/confidentialityCode -&gt; FHIR description de la Composition</span>#xD;\n  cda<b> then </b>MapHeaderDocumentDescription<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"documentDescription\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA recordTarget.patientRole -&gt; Patient générique + enrichissement français</span>#xD;\n  cda<b> then </b>MapHeaderRecordTarget<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">)</span> <i>\"recordTargetBase\"</i><span style=\"color: navy\">;</span>#xD;\n  cda.recordTarget<b> as </b><span style=\"color: maroon\">recordTarget</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    recordTarget.patientRole<b> as </b><span style=\"color: maroon\">patientRole</span><b> then </b>MapCDARecordTargetToFrenchPatient<span style=\"color: navy\">(</span><span style=\"color: maroon\">patientRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"patientFR\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"recordTargetFR\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA custodian -&gt; Organization custodian générique + française</span>#xD;\n  cda<b> then </b>MapHeaderCustodianWithFrenchRules<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"custodian\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA author -&gt; Practitioner / Organization / PractitionerRole génériques + français</span>#xD;\n  cda<b> then </b>MapHeaderAuthorWithFrenchRules<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"author\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA legalAuthenticator -&gt; signataire légal générique + français</span>#xD;\n  cda<b> then </b>MapHeaderLegalAuthenticatorWithFrenchRules<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"c