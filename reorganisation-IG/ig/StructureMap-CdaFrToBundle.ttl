yle=\"color: blue\">'https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-identity-reliability'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA II -&gt; FHIR Extension.extension identityStatus</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">statusExt</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>statusExt.url = <span style=\"color: blue\">'identityStatus'</span> <i>\"statusUrl\"</i><span style=\"color: navy\">;</span>#xD;\n    src<span style=\"color: navy\"><b> -&gt; </b></span>statusExt.value = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      src<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'https://hl7.fr/ig/fhir/core/CodeSystem/fr-core-v2-0445'</span> <i>\"system\"</i><span style=\"color: navy\">;</span>#xD;\n      src<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <span style=\"color: blue\">'VALI'</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"valueCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"identityStatus\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">ORGANIZATION FR</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">CDA organization-like element -&gt; FHIR Organization profils et identifiants français</span>#xD;\n<b>group </b>MapCDAOrganizationToFrenchOrganization<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Organization<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA organization -&gt; FHIR Organization.meta.profile</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.meta<b> as </b><span style=\"color: maroon\">metaBlock</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>metaBlock.profile = <span style=\"color: blue\">'https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-organization'</span> <i>\"frCoreOrganizationProfile\"</i><span style=\"color: navy\">;</span>#xD;\n    src<span style=\"color: navy\"><b> -&gt; </b></span>metaBlock.profile = <span style=\"color: blue\">'https://interop.esante.gouv.fr/ig/fhir/annuaire/StructureDefinition/as-organization'</span> <i>\"asOrganizationProfile\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"meta\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA organization.id -&gt; FHIR Organization.identifier français</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> then </b>MapCDAIIToFrenchOrganizationIdentifiers<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"identifiers\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility -&gt; FHIR Organization facility française</span>#xD;\n<b>group </b>MapCDAHealthCareFacilityToFrenchOrganization<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>HealthCareFacility, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Organization<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">Cas principal : healthCareFacility.serviceProviderOrganization existe.</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">On réutilise le groupe français général des Organization pour éviter de</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">reprofiler manuellement ici.</span>#xD;\n  src.serviceProviderOrganization<b> as </b><span style=\"color: maroon\">serviceProviderOrganization</span><b> then </b>MapCDAOrganizationToFrenchOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">serviceProviderOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"serviceProviderOrganizationFR\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Cas complémentaire : si le healthCareFacility porte lui-même un identifiant,</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">on l’ajoute aussi à l’Organization de prise en charge.</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> then </b>MapCDAIIToFrenchOrganizationIdentifiers<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"facilityIdentifiers\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Cas de secours : si aucune serviceProviderOrganization n’existe, on applique</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">quand même les profils/identifiants français via le groupe général.</span>#xD;\n  src<b> where </b>src.serviceProviderOrganization.empty()<b> then </b>MapCDAOrganizationToFrenchOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"facilityFR\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility sans id ni organization -&gt; FHIR Organization.name data-absent-reason</span>#xD;\n  src<b> where </b>src.id.empty() and src.serviceProviderOrganization.empty()<span style=\"color: navy\"><b> -&gt; </b></span>tgt.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">nameString</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>nameString.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      src<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      src<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"facilityOrganizationNameAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA serviceProviderOrganization sans nom ni id -&gt; FHIR Organization.name data-absent-reason</span>#xD;\n  src.serviceProviderOrganization<b> as </b><span style=\"color: maroon\">serviceProviderOrganization</span><b> where </b>serviceProviderOrganization.name.empty() and serviceProviderOrganization.id.empty()<span style=\"color: navy\"><b> -&gt; </b></span>tgt.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">nameString</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    serviceProviderOrganization<span style=\"color: navy\"><b> -&gt; </b></span>nameString.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      serviceProviderOrganization<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      serviceProviderOrganization<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"serviceProviderOrganizationNameAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA II organization.id -&gt; FHIR Organization.identifier français</span>#xD;\n<b>group </b>MapCDAIIToFrenchOrganizationIdentifiers<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>II, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Organization<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA root IdNatSt -&gt; FHIR Organization.identifier</span>#xD;\n  src<b> where </b>src.root = '1.2.250.1.71.4.2.2'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">idNatStIdentifier</span><b> then </b>MapCDAIIToIdNatStIdentifier<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">idNatStIdentifier</span><span style=\"color: navy\">)</span> <i>\"idNatSt\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA root SNR -&gt; FHIR Organization.identifier</span>#xD;\n  src<b> where </b>src.root = '1.2.250.1.213.4.1'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">snrIdentifier</span><b> then </b>MapCDAIIToSNRIdentifier<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">snrIdentifier</span><span style=\"color: navy\">)</span> <i>\"snr\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA root COFRAC -&gt; FHIR Organization.identifier</span>#xD;\n  src<b> where </b>src.root = '1.2.250.1.213.6.3.1'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">cofracIdentifier</span><b> then </b>MapCDAIIToCOFRACIdentifier<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">cofracIdentifier</span><span style=\"color: navy\">)</span> <i>\"cofrac\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA II IdNatSt -&gt; FHIR Identifier</span>#xD;\n<b>group </b>MapCDAIIToIdNatStIdentifier<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>II, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Identifier<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"base\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA II SNR -&gt; FHIR Identifier</span>#xD;\n<b>group </b>MapCDAIIToSNRIdentifier<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>II, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Identifier<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.system = <span style=\"color: blue\">'urn:oid:1.2.250.1.213.4.1'</span> <i>\"system\"</i><span style=\"color: navy\">;</span>#xD;\n  src.extension<b> as </b><span style=\"color: maroon\">extension</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">extension</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"valueFromExtension\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> where </b>src.extension.empty()<span style=\"color: navy\"><b> -&gt; </b></span>tgt.value = <span style=\"color: blue\">'DMP-SNR'</span> <i>\"defaultValue\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA II COFRAC -&gt; FHIR Identifier</span>#xD;\n<b>group </b>MapCDAIIToCOFRACIdentifier<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>II, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Identifier<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"base\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.assigner<b> as </b><span style=\"color: maroon\">assigner</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>assigner.display = <span style=\"color: blue\">'COFRAC'</span> <i>\"assignerDisplay\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"assigner\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">PRACTITIONER / PRACTITIONERROLE FR</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity-like element -&gt; FHIR Practitioner français</span>#xD;\n<b>group </b>MapCDAAssignedEntityToFrenchPractitioner<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Practitioner<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity -&gt; FHIR Practitioner.meta.profile</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.meta<b> as </b><span style=\"color: maroon\">metaBlock</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>metaBlock.profile = <span style=\"color: blue\">'https://interop.esante.gouv.fr/ig/fhir/annuaire/StructureDefinition/as-practitioner'</span> <i>\"asPractitioner\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"meta\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity.id -&gt; FHIR Practitioner.identifier IDNPS</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> then </b>MapCDAIIToFrenchPractitionerIdentifiers<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"identifiers\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity.code -&gt; FHIR Practitioner.qualification</span>#xD;\n  src.code<b> as </b><span style=\"color: maroon\">roleCode</span><b> then </b>MapCDACodeToPractitionerQualification<span style=\"color: navy\">(</span><span style=\"color: maroon\">roleCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"qualification\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA II assignedEntity.id -&gt; FHIR Practitioner.identifier français</span>#xD;\n<b>group </b>MapCDAIIToFrenchPractitionerIdentifiers<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>II, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Practitioner<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA root IDNPS -&gt; FHIR Practitioner.identifier IDNPS</span>#xD;\n  src<b> where </b>src.root = '1.2.250.1.71.4.2.1'<span style=\"color: navy\"><b> -&gt; </b></span>tgt.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">idNatPsIdentifier</span><b> then </b>MapCDAIIToIDNPSIdentifier<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">idNatPsIdentifier</span><span style=\"color: navy\">)</span> <i>\"idNatPs\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA II IDNPS -&gt; FHIR Identifier IDNPS</span>#xD;\n<b>group </b>MapCDAIIToIDNPSIdentifier<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>II, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>Identifier<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"base\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.use = <span style=\"color: blue\">'official'</span> <i>\"use\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.type = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">idType</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>idType.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">idCoding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      src<span style=\"color: navy\"><b> -&gt; </b></span>idCoding.system = <span style=\"color: blue\">'https://hl7.fr/ig/fhir/core/CodeSystem/fr-core-cs-v2-0203'</span> <i>\"system\"</i><span style=\"color: navy\">;</span>#xD;\n      src<span style=\"color: navy\"><b> -&gt; </b></span>idCoding.code = <span styl