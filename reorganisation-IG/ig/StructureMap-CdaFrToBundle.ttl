 </span><span style=\"color: maroon\">legalRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalPractitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalOrganization</span><span style=\"color: navy\">)</span> <i>\"legalRoleFR\"</i><span style=\"color: navy\">;</span>#xD;\n          assignedEntity<span style=\"color: navy\"><b> -&gt; </b></span> attester.party = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">partyRef</span><span style=\"color: navy\">, </span> partyRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalRole.id<span style=\"color: navy\">)</span> <i>\"partyRole\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"legalWithOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n        assignedEntity<b> where </b>assignedEntity.representedOrganization.empty()<span style=\"color: navy\"><b> -&gt; </b></span> attester.party = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">partyRef</span><span style=\"color: navy\">, </span> partyRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalPractitioner.id<span style=\"color: navy\">)</span> <i>\"partyPractitioner\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"attester\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"legalPractitionerResource\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA componentOf.encompassingEncounter -&gt; création Encounter / Location / Organization + enrichissement français</span>#xD;\n<b>group </b>MapHeaderEncounterContextWithFrenchRules<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.componentOf<b> as </b><span style=\"color: maroon\">componentOf</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    componentOf.encompassingEncounter<b> as </b><span style=\"color: maroon\">encompassingEncounter</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">encounterEntry</span><span style=\"color: navy\">, </span> encounterEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Encounter'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">encounter</span><span style=\"color: navy\">, </span> encounter.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> encounterEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %encounter.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter -&gt; FHIR Composition.encounter</span>#xD;\n      encompassingEncounter<span style=\"color: navy\"><b> -&gt; </b></span> composition.encounter = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">encRef</span><span style=\"color: navy\">, </span> encRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %encounter.id<span style=\"color: navy\">)</span> <i>\"compositionEncounterRef\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">Cas 1 : healthCareFacility présent -&gt; Encounter + Location + Organization</span>#xD;\n      encompassingEncounter.location<b> as </b><span style=\"color: maroon\">srcLocation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        srcLocation.healthCareFacility<b> as </b><span style=\"color: maroon\">facility</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">locationEntry</span><span style=\"color: navy\">, </span> locationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Location'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">location</span><span style=\"color: navy\">, </span> location.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> locationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %location.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">facilityOrganizationEntry</span><span style=\"color: navy\">, </span> facilityOrganizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">facilityOrganization</span><span style=\"color: navy\">, </span> facilityOrganization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> facilityOrganizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %facilityOrganization.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          <span style=\"color: navy\">// </span><span style=\"color: green\">Groupe français d’orchestration :</span>#xD;\n          <span style=\"color: navy\">// </span><span style=\"color: green\">appelle le générique de l’étape 2 puis les enrichissements français de l’étape 3.</span>#xD;\n          encompassingEncounter<b> then </b>MapCDAEncounterContextToFrenchResources<span style=\"color: navy\">(</span><span style=\"color: maroon\">encompassingEncounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">facility</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">encounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">location</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">facilityOrganization</span><span style=\"color: navy\">)</span> <i>\"encounterContextFR\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"facilityResources\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">Cas 2 : encompassingEncounter présent mais sans location</span>#xD;\n      encompassingEncounter<b> where </b>encompassingEncounter.location.empty()<b> then </b>MapCDAEncounterOnlyToFrenchResources<span style=\"color: navy\">(</span><span style=\"color: maroon\">encompassingEncounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">encounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"encounterOnlyFR\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">Cas 3 : location présente mais sans healthCareFacility</span>#xD;\n      encompassingEncounter.location<b> as </b><span style=\"color: maroon\">srcLocation</span><b> where </b>srcLocation.healthCareFacility.empty()<b> then </b>MapCDAEncounterOnlyToFrenchResources<span style=\"color: navy\">(</span><span style=\"color: maroon\">encompassingEncounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">encounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"encounterOnlyFRWithoutFacility\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"encounterResource\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA informant ECON -&gt; création RelatedPerson + enrichissement français</span>#xD;\n<b>group </b>MapHeaderEmergencyContactWithFrenchRules<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.informant<b> as </b><span style=\"color: maroon\">informant</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    informant.relatedEntity<b> as </b><span style=\"color: maroon\">relatedEntity</span><b> where </b>relatedEntity.classCode = 'ECON'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">relatedPersonEntry</span><span style=\"color: navy\">, </span> relatedPersonEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'RelatedPerson'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">emergencyContactRelatedPerson</span><span style=\"color: navy\">, </span> emergencyContactRelatedPerson.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> relatedPersonEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %emergencyContactRelatedPerson.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      relatedEntity<b> then </b>MapCDARelatedEntityToRelatedPerson<span style=\"color: navy\">(</span><span style=\"color: maroon\">relatedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">emergencyContactRelatedPerson</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"relatedPersonBase\"</i><span style=\"color: navy\">;</span>#xD;\n      relatedEntity<b> then </b>MapCDAInformantToFrenchRelatedPerson<span style=\"color: navy\">(</span><span style=\"color: maroon\">relatedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">emergencyContactRelatedPerson</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"relatedPersonFR\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"relatedPersonECON\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA informant NOK -&gt; création RelatedPerson + enrichissement français</span>#xD;\n<b>group </b>MapHeaderTrustedPersonWithFrenchRules<span style=\"color: navy\