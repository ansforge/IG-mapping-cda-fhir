ssignedAuthor</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorPractitioner</span><span style=\"color: navy\">)</span> <i>\"authorPractitionerFR\"</i><span style=\"color: navy\">;</span>#xD;\n      assignedAuthor.representedOrganization<b> as </b><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">organizationEntry</span><span style=\"color: navy\">, </span> organizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">authorOrganization</span><span style=\"color: navy\">, </span> authorOrganization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> organizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorOrganization.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">roleEntry</span><span style=\"color: navy\">, </span> roleEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'PractitionerRole'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">authorRole</span><span style=\"color: navy\">, </span> authorRole.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> roleEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorRole.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        representedOrganization<b> then </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorOrganization</span><span style=\"color: navy\">)</span> <i>\"authorOrganizationBase\"</i><span style=\"color: navy\">;</span>#xD;\n        representedOrganization<b> then </b>MapCDAOrganizationToFrenchOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorOrganization</span><span style=\"color: navy\">)</span> <i>\"authorOrganizationFR\"</i><span style=\"color: navy\">;</span>#xD;\n        assignedAuthor<b> then </b>MapCDAAssignedEntityToPractitionerRole<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedAuthor</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorPractitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorOrganization</span><span style=\"color: navy\">)</span> <i>\"authorRoleBase\"</i><span style=\"color: navy\">;</span>#xD;\n        assignedAuthor<b> then </b>MapCDAAssignedEntityToFrenchPractitionerRole<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedAuthor</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorPractitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorOrganization</span><span style=\"color: navy\">)</span> <i>\"authorRoleFR\"</i><span style=\"color: navy\">;</span>#xD;\n        assignedAuthor<span style=\"color: navy\"><b> -&gt; </b></span> composition.author<b> as </b><span style=\"color: maroon\">authorRef</span><span style=\"color: navy\">, </span> authorRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorRole.id<span style=\"color: navy\">)</span> <i>\"compositionAuthorRoleRef\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"authorWithOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n      assignedAuthor<b> where </b>assignedAuthor.representedOrganization.empty()<span style=\"color: navy\"><b> -&gt; </b></span> composition.author<b> as </b><span style=\"color: maroon\">authorRef</span><span style=\"color: navy\">, </span> authorRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorPractitioner.id<span style=\"color: navy\">)</span> <i>\"compositionAuthorPractitionerRef\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"authorPractitionerResource\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA legalAuthenticator -&gt; création Practitioner / Organization / PractitionerRole + enrichissement français</span>#xD;\n<b>group </b>MapHeaderLegalAuthenticatorWithFrenchRules<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.legalAuthenticator<b> as </b><span style=\"color: maroon\">legalAuthenticator</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    legalAuthenticator.assignedEntity<b> as </b><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">practitionerEntry</span><span style=\"color: navy\">, </span> practitionerEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Practitioner'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">legalPractitioner</span><span style=\"color: navy\">, </span> legalPractitioner.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> practitionerEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalPractitioner.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      assignedEntity<b> then </b>MapCDAAssignedEntityToPractitioner<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalPractitioner</span><span style=\"color: navy\">)</span> <i>\"legalPractitionerBase\"</i><span style=\"color: navy\">;</span>#xD;\n      assignedEntity<b> then </b>MapCDAAssignedEntityToFrenchPractitioner<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalPractitioner</span><span style=\"color: navy\">)</span> <i>\"legalPractitionerFR\"</i><span style=\"color: navy\">;</span>#xD;\n      legalAuthenticator<span style=\"color: navy\"><b> -&gt; </b></span>composition.attester<b> as </b><span style=\"color: maroon\">attester</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        legalAuthenticator<span style=\"color: navy\"><b> -&gt; </b></span>attester.mode = <span style=\"color: blue\">'legal'</span> <i>\"mode\"</i><span style=\"color: navy\">;</span>#xD;\n        legalAuthenticator.time<b> as </b><span style=\"color: maroon\">time</span><span style=\"color: navy\"><b> -&gt; </b></span>attester.time = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">dt</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">time</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">dt</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n        assignedEntity.representedOrganization<b> as </b><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">organizationEntry</span><span style=\"color: navy\">, </span> organizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">legalOrganization</span><span style=\"color: navy\">, </span> legalOrganization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> organizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalOrganization.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">roleEntry</span><span style=\"color: navy\">, </span> roleEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'PractitionerRole'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">legalRole</span><span style=\"color: navy\">, </span> legalRole.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> roleEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalRole.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          representedOrganization<b> then </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalOrganization</span><span style=\"col