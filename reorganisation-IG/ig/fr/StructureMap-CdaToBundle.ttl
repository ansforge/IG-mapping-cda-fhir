@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaToBundle> a fhir:StructureMap ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "CdaToBundle"] ;
  fhir:Resource.language [ fhir:value "fr"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"fr\" lang=\"fr\"><hr/><p><b>French</b></p><hr/><p class=\"res-header-id\"><b>Narratif généré : StructureMap CdaToBundle</b></p><a name=\"CdaToBundle\"> </a><a name=\"hcCdaToBundle\"> </a><pre class=\"fml\">#xD;\n<b>map</b><span style=\"color: navy\"> \"</span>https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaToBundle<span style=\"color: navy\">\" = \"</span>CdaToBundle<span style=\"color: navy\">\"#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Mapping CDA vers FHIR - Étape 2 socle générique orienté CDA</span>#xD;\n#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-ClinicalDocument.html\" title=\"ClinicalDocument (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/ClinicalDocument|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>ClinicalDocument <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-PatientRole.html\" title=\"PatientRole (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/PatientRole|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>PatientRole <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-RelatedEntity.html\" title=\"RelatedEntity (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/RelatedEntity|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>RelatedEntity <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-EncompassingEncounter.html\" title=\"EncompassingEncounter (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/EncompassingEncounter|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>EncompassingEncounter <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/cda/stds/core/2.0.0-sd/StructureDefinition-HealthCareFacility.html\" title=\"HealthCareFacility (CDA Class)\">http://hl7.org/cda/stds/core/StructureDefinition/HealthCareFacility|2.0.0-sd</a><span style=\"color: navy\">\" </span><b>alias </b>HealthCareFacility <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/bundle.html\" title=\"Bundle\">http://hl7.org/fhir/StructureDefinition/Bundle|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Bundle <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/composition.html\" title=\"Composition\">http://hl7.org/fhir/StructureDefinition/Composition|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Composition <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/patient.html\" title=\"Patient\">http://hl7.org/fhir/StructureDefinition/Patient|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Patient <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/practitioner.html\" title=\"Practitioner\">http://hl7.org/fhir/StructureDefinition/Practitioner|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Practitioner <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/practitionerrole.html\" title=\"PractitionerRole\">http://hl7.org/fhir/StructureDefinition/PractitionerRole|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>PractitionerRole <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/organization.html\" title=\"Organization\">http://hl7.org/fhir/StructureDefinition/Organization|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Organization <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/relatedperson.html\" title=\"RelatedPerson\">http://hl7.org/fhir/StructureDefinition/RelatedPerson|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>RelatedPerson <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/encounter.html\" title=\"Encounter\">http://hl7.org/fhir/StructureDefinition/Encounter|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Encounter <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/location.html\" title=\"Location\">http://hl7.org/fhir/StructureDefinition/Location|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Location <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Identifier\" title=\"Identifier\">http://hl7.org/fhir/StructureDefinition/Identifier|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Identifier <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#CodeableConcept\" title=\"CodeableConcept\">http://hl7.org/fhir/StructureDefinition/CodeableConcept|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>CodeableConcept <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Coding\" title=\"Coding\">http://hl7.org/fhir/StructureDefinition/Coding|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Coding <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/references.html#Reference\" title=\"Reference\">http://hl7.org/fhir/StructureDefinition/Reference|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Reference <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#HumanName\" title=\"HumanName\">http://hl7.org/fhir/StructureDefinition/HumanName|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>HumanName <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Address\" title=\"Address\">http://hl7.org/fhir/StructureDefinition/Address|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Address <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#ContactPoint\" title=\"ContactPoint\">http://hl7.org/fhir/StructureDefinition/ContactPoint|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>ContactPoint <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Period\" title=\"Period\">http://hl7.org/fhir/StructureDefinition/Period|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Period <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/extensibility.html#Extension\" title=\"Extension\">http://hl7.org/fhir/StructureDefinition/Extension|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Extension <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#Narrative\" title=\"Narrative\">http://hl7.org/fhir/StructureDefinition/Narrative|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>Narrative <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#code\" title=\"code\">http://hl7.org/fhir/StructureDefinition/code|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>code <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#date\" title=\"date\">http://hl7.org/fhir/StructureDefinition/date|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>date <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#dateTime\" title=\"dateTime\">http://hl7.org/fhir/StructureDefinition/dateTime|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>dateTime <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#instant\" title=\"instant\">http://hl7.org/fhir/StructureDefinition/instant|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>instant <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#boolean\" title=\"boolean\">http://hl7.org/fhir/StructureDefinition/boolean|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>boolean <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#uri\" title=\"uri\">http://hl7.org/fhir/StructureDefinition/uri|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>uri <b>as </b><b>target</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/datatypes.html#string\" title=\"string\">http://hl7.org/fhir/StructureDefinition/string|4.0.1</a><span style=\"color: navy\">\" </span><b>alias </b>string <b>as </b><b>target</b>#xD;\n#xD;\n<b>imports</b><span style=\"color: navy\"> \"</span><a href=\"StructureMap-CdaToFHIRTypes.html\" title=\"Mapping de CDA vers les FHIR Types (A partir des sources de Oliver Egger)\">https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/StructureMap/CdaToFHIRTypes|0.1.0</a><span style=\"color: navy\">\"#xD;\n</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE D’ENTRÉE — INITIALISATION DU DOCUMENT FHIR À PARTIR DU CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   À partir de l’analyse du ClinicalDocument CDA, ce groupe initialise les</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   ressources FHIR nécessaires pour représenter les éléments CDA principaux :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Composition et Patient.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ces ressources sont créées vides avec un uuid(), ajoutées au Bundle, puis</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   transmises au groupe d’orchestration.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Les autres ressources seront créées ultérieurement, dans les groupes</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   correspondant aux blocs CDA traités.</span>#xD;\n<b>group </b>TransformClinicalDocumentToFHIRDocument<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">cda</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  cda<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">compositionEntry</span><span style=\"color: navy\">, </span> compositionEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Composition'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span> composition.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> compositionEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %composition.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">patientEntry</span><span style=\"color: navy\">, </span> patientEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Patient'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span> patient.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> patientEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span><b> then </b>OrchestrateClinicalDocumentTransformation<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"main\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE D’ORCHESTRATION — TRAITEMENT DU CLINICALDOCUMENT CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe permet de traiter le ClinicalDocument CDA en deux parties :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - l’en-tête CDA via l'appel du groupe MapClinicalDocumentHeader ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - le corps CDA via l'appelle du groupe MapClinicalDocumentBody.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Les ressources initialisées dans le groupe d’entrée, Bundle, Composition et</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Patient, servent de support de sortie pour le traitement CDA</span>#xD;\n<b>group </b>OrchestrateClinicalDocumentTransformation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">cda</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">ClinicalDocument.header CDA -&gt; Bundle / Composition / Patient + ressources administratives créées si les blocs CDA existent</span>#xD;\n  cda<b> then </b>MapClinicalDocumentHeader<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"header\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">ClinicalDocument.component.structuredBody CDA -&gt; Composition.section title/code/text</span>#xD;\n  cda<b> then </b>MapClinicalDocumentBody<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"body\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DE L’EN-TÊTE DU CLINICALDOCUMENT CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite l’en-tête du ClinicalDocument CDA bloc par bloc.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Pour chaque élément de l’en-tête CDA, il appelle le groupe spécialisé</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   correspondant :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - id, setId, versionNumber et effectiveTime sont transmis à</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     MapHeaderDocumentIdentity pour alimenter les métadonnées du Bundle et de</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     la Composition ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - languageCode, code, title, effectiveTime et confidentialityCode sont transmis</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     à MapHeaderDocumentDescription pour alimenter la description documentaire ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - recordTarget.patientRole est transmis à MapHeaderRecordTarget pour alimenter</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     le Patient et la référence Composition.subject ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - custodian est transmis à MapHeaderCustodian pour créer et alimenter</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     l’Organization responsable de la conservation du document ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - author est transmis à MapHeaderAuthor pour créer et alimenter le Practitioner,</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     l’Organization et le PractitionerRole de l’auteur ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - legalAuthenticator est transmis à MapHeaderLegalAuthenticator pour créer et</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     alimenter le signataire légal ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - documentationOf.serviceEvent est transmis à MapHeaderDocumentationOf pour</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     alimenter Composition.event ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - componentOf.encompassingEncounter est transmis à MapHeaderEncounterContext</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     pour créer et alimenter Encounter, Location et Organization si le bloc CDA</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     est présent ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - informant.relatedEntity classCode=ECON est transmis à MapHeaderEmergencyContact</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     pour créer la RelatedPerson correspondant à la personne à prévenir ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - informant.relatedEntity classCode=NOK est transmis à MapHeaderTrustedPerson</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     pour créer la RelatedPerson correspondant à la personne de confiance ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - recordTarget.patientRole.patient.guardian est transmis à MapHeaderGuardian</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     pour créer la RelatedPerson correspondant au guardian ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - relatedDocument est transmis à MapHeaderRelatedDocument pour alimenter</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">     Composition.relatesTo.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Les ressources optionnelles sont créées dans le groupe qui traite le bloc CDA</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   correspondant. Ainsi, une ressource FHIR n’est créée que lorsqu’un élément CDA</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   justifie son existence</span>#xD;\n<b>group </b>MapClinicalDocumentHeader<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">cda</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA id/setId/versionNumber/effectiveTime -&gt; FHIR métadonnées Bundle + Composition</span>#xD;\n  cda<b> then </b>MapHeaderDocumentIdentity<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">)</span> <i>\"documentIdentity\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA languageCode/code/title/effectiveTime/confidentialityCode -&gt; FHIR description de la Composition</span>#xD;\n  cda<b> then </b>MapHeaderDocumentDescription<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"documentDescription\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA recordTarget.patientRole -&gt; FHIR Patient + Composition.subject</span>#xD;\n  cda<b> then </b>MapHeaderRecordTarget<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">)</span> <i>\"recordTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA custodian -&gt; création et alimentation de l’Organization custodian</span>#xD;\n  cda<b> then </b>MapHeaderCustodian<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"custodian\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA author -&gt; création et alimentation du Practitioner / Organization / PractitionerRole auteur</span>#xD;\n  cda<b> then </b>MapHeaderAuthor<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"author\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA legalAuthenticator -&gt; création et alimentation du signataire légal</span>#xD;\n  cda<b> then </b>MapHeaderLegalAuthenticator<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">)</span> <i>\"legalAuthenticator\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA documentationOf.serviceEvent -&gt; FHIR Composition.event</span>#xD;\n  cda<b> then </b>MapHeaderDocumentationOf<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">)</span> <i>\"documentationOf\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA componentOf.encompassingEncounter -&gt; création et alimentation Encounter / Location / Organization si présent</span>#xD;\n  cda<b> then </b>MapHeaderEncounterContext<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"encounterContext\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA informant.relatedEntity classCode=ECON -&gt; création RelatedPerson personne à prévenir</span>#xD;\n  cda<b> then </b>MapHeaderEmergencyContact<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"emergencyContact\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA informant.relatedEntity classCode=NOK -&gt; création RelatedPerson personne de confiance</span>#xD;\n  cda<b> then </b>MapHeaderTrustedPerson<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"trustedPerson\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA recordTarget.patientRole.patient.guardian -&gt; création RelatedPerson guardian</span>#xD;\n  cda<b> then </b>MapHeaderGuardian<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">bundle</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"guardian\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedDocument -&gt; FHIR Composition.relatesTo</span>#xD;\n  cda<b> then </b>MapHeaderRelatedDocument<span style=\"color: navy\">(</span><span style=\"color: maroon\">cda</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">composition</span><span style=\"color: navy\">)</span> <i>\"relatedDocument\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">groupe qui traite l'identité du document CDA -&gt; métadonnées Bundle / Composition FHIR</span>#xD;\n<b>group </b>MapHeaderDocumentIdentity<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument -&gt; FHIR Bundle.id</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>bundle.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span> <i>\"bundleId\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument -&gt; FHIR Bundle.type</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>bundle.type = <span style=\"color: blue\">'document'</span> <i>\"bundleType\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA versionNumber/effectiveTime -&gt; FHIR Bundle.meta</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>bundle.meta<b> as </b><span style=\"color: maroon\">bundleMeta</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA versionNumber.value -&gt; FHIR Bundle.meta.versionId</span>#xD;\n    src.versionNumber<b> as </b><span style=\"color: maroon\">versionNumber</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      versionNumber.value<b> as </b><span style=\"color: maroon\">version</span><span style=\"color: navy\"><b> -&gt; </b></span>bundleMeta.versionId = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">version</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"bundleMetaVersionId\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"bundleVersionNumber\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA effectiveTime -&gt; FHIR Bundle.meta.lastUpdated</span>#xD;\n    src.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\"><b> -&gt; </b></span>bundleMeta.lastUpdated = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'instant'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">lastUpdated</span><b> then </b>TSInstant<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">lastUpdated</span><span style=\"color: navy\">)</span> <i>\"bundleMetaLastUpdated\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"bundleMeta\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument.id -&gt; FHIR Bundle.identifier</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">cdaId</span><span style=\"color: navy\"><b> -&gt; </b></span>bundle.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA id.root + id.extension -&gt; FHIR Identifier.system/value</span>#xD;\n    cdaId.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>cdaId.extension.exists()<span style=\"color: navy\"><b> -&gt; </b></span>identifier.system = <b>append</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'urn:oid:'</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">root</span><span style=\"color: navy\">)</span> <i>\"bundleIdentifierSystemWithExtension\"</i><span style=\"color: navy\">;</span>#xD;\n    cdaId.extension<b> as </b><span style=\"color: maroon\">extension</span><span style=\"color: navy\"><b> -&gt; </b></span>identifier.value = <span style=\"color: maroon\">extension</span> <i>\"bundleIdentifierValueWithExtension\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA id.root sans extension -&gt; FHIR Identifier.system/value</span>#xD;\n    cdaId.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>cdaId.extension.empty()<span style=\"color: navy\"><b> -&gt; </b></span>identifier.system = <span style=\"color: blue\">'urn:ietf:rfc:3986'</span> <i>\"bundleIdentifierSystemOid\"</i><span style=\"color: navy\">;</span>#xD;\n    cdaId.root<b> as </b><span style=\"color: maroon\">root</span><b> where </b>cdaId.extension.empty()<span style=\"color: navy\"><b> -&gt; </b></span>identifier.value = <b>append</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'urn:oid:'</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">root</span><span style=\"color: navy\">)</span> <i>\"bundleIdentifierValueOid\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"bundleIdentifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA effectiveTime -&gt; FHIR Bundle.timestamp</span>#xD;\n  src.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\"><b> -&gt; </b></span>bundle.timestamp = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'instant'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">timestamp</span><b> then </b>TSInstant<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">timestamp</span><span style=\"color: navy\">)</span> <i>\"bundleTimestamp\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA setId -&gt; FHIR Composition.identifier</span>#xD;\n  src.setId<b> as </b><span style=\"color: maroon\">setId</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">setId</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"compositionSetIdentifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA id -&gt; FHIR Composition.identifier si setId absent</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><b> where </b>src.setId.empty()<span style=\"color: navy\"><b> -&gt; </b></span>composition.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"compositionIdentifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA ClinicalDocument -&gt; FHIR Composition.status</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>composition.status = <span style=\"color: blue\">'final'</span> <i>\"compositionStatus\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA versionNumber/effectiveTime -&gt; FHIR Composition.meta</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>composition.meta<b> as </b><span style=\"color: maroon\">compositionMeta</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA versionNumber.value -&gt; FHIR Composition.meta.versionId</span>#xD;\n    src.versionNumber<b> as </b><span style=\"color: maroon\">versionNumber</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      versionNumber.value<b> as </b><span style=\"color: maroon\">version</span><span style=\"color: navy\"><b> -&gt; </b></span>compositionMeta.versionId = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">version</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"compositionMetaVersionId\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"compositionVersionNumber\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA effectiveTime -&gt; FHIR Composition.meta.lastUpdated</span>#xD;\n    src.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\"><b> -&gt; </b></span>compositionMeta.lastUpdated = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'instant'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">lastUpdated</span><b> then </b>TSInstant<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">lastUpdated</span><span style=\"color: navy\">)</span> <i>\"compositionMetaLastUpdated\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"compositionMeta\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">groupe qui traite la description du document CDA -&gt; FHIR Composition</span>#xD;\n<b>group </b>MapHeaderDocumentDescription<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA languageCode -&gt; FHIR Composition.language</span>#xD;\n  src.languageCode<b> as </b><span style=\"color: maroon\">languageCode</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.language = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">code</span><b> then </b>CSCode<span style=\"color: navy\">(</span><span style=\"color: maroon\">languageCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">code</span><span style=\"color: navy\">)</span> <i>\"language\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA code -&gt; FHIR Composition.type</span>#xD;\n  src.code<b> as </b><span style=\"color: maroon\">srcCode</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.type = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">cc</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">srcCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">cc</span><span style=\"color: navy\">)</span> <i>\"type\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA title -&gt; FHIR Composition.title</span>#xD;\n  src.title<b> as </b><span style=\"color: maroon\">title</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.title = <span style=\"color: navy\">(</span>title.xmlText<span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA recordTarget -&gt; FHIR Composition.subject</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span> composition.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA effectiveTime -&gt; FHIR Composition.date</span>#xD;\n  src.effectiveTime<b> as </b><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.date = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">date</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">effectiveTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">date</span><span style=\"color: navy\">)</span> <i>\"date\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA confidentialityCode -&gt; FHIR Composition.confidentiality</span>#xD;\n  src.confidentialityCode<b> as </b><span style=\"color: maroon\">confCode</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.confidentiality = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">code</span><b> then </b>CSCode<span style=\"color: navy\">(</span><span style=\"color: maroon\">confCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">code</span><span style=\"color: navy\">)</span> <i>\"confidentiality\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">groupe qui traite: CDA recordTarget.patientRole -&gt; FHIR Patient</span>#xD;\n<b>group </b>MapHeaderRecordTarget<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.recordTarget<b> as </b><span style=\"color: maroon\">recordTarget</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    recordTarget.patientRole<b> as </b><span style=\"color: maroon\">patientRole</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole.addr -&gt; FHIR Patient.address</span>#xD;\n      patientRole.addr<b> as </b><span style=\"color: maroon\">srcAddr</span><span style=\"color: navy\"><b> -&gt; </b></span>patient.address = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Address'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">address</span><b> then </b>ADAddress<span style=\"color: navy\">(</span><span style=\"color: maroon\">srcAddr</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">address</span><span style=\"color: navy\">)</span> <i>\"address\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA patientRole.telecom -&gt; FHIR Patient.telecom</span>#xD;\n      patientRole.telecom<b> as </b><span style=\"color: maroon\">srcTelecom</span><span style=\"color: navy\"><b> -&gt; </b></span>patient.telecom = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'ContactPoint'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">contactPoint</span><b> then </b>TELContactPoint<span style=\"color: navy\">(</span><span style=\"color: maroon\">srcTelecom</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">contactPoint</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n      patientRole.patient<b> as </b><span style=\"color: maroon\">patientCda</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        <span style=\"color: navy\">// </span><span style=\"color: green\">CDA administrativeGenderCode -&gt; FHIR Patient.gender</span>#xD;\n        patientCda.administrativeGenderCode<b> as </b><span style=\"color: maroon\">gender</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          gender.code<b> as </b><span style=\"color: maroon\">v</span><span style=\"color: navy\"><b> -&gt; </b></span>patient.gender = <b>translate</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">v</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'https://interop.esante.gouv.fr/ig/fhir/mappingcdafhir/ConceptMap/cm-v3-administrative-gender'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"gender\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"gender\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">// </span><span style=\"color: green\">CDA birthTime -&gt; FHIR Patient.birthDate</span>#xD;\n        patientCda.birthTime<b> as </b><span style=\"color: maroon\">birthTime</span><span style=\"color: navy\"><b> -&gt; </b></span>patient.birthDate = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'date'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">date</span><b> then </b>TSDate<span style=\"color: navy\">(</span><span style=\"color: maroon\">birthTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">date</span><span style=\"color: navy\">)</span> <i>\"birthDate\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">// </span><span style=\"color: green\">CDA deceasedInd -&gt; FHIR Patient.deceasedBoolean</span>#xD;\n        patientCda.deceasedInd<b> as </b><span style=\"color: maroon\">indicator</span><b> where </b>patientCda.deceasedTime.empty()<span style=\"color: navy\"><b> -&gt; </b></span>patient.deceased = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'boolean'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">bool</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          indicator.value<b> as </b><span style=\"color: maroon\">v</span><span style=\"color: navy\"><b> -&gt; </b></span>bool.value = <span style=\"color: maroon\">v</span><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"deceasedBoolean\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">// </span><span style=\"color: green\">CDA deceasedTime -&gt; FHIR Patient.deceasedDateTime</span>#xD;\n        patientCda.deceasedTime<b> as </b><span style=\"color: maroon\">dTime</span><span style=\"color: navy\"><b> -&gt; </b></span>patient.deceased = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">dt</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">dTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">dt</span><span style=\"color: navy\">)</span> <i>\"deceasedDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"patientData\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">groupe qui traite custodian  (l'organisation)</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">L’Organization est créée uniquement si le bloc custodian existe dans le CDA.</span>#xD;\n<b>group </b>MapHeaderCustodian<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.custodian<b> as </b><span style=\"color: maroon\">custodian</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    custodian.assignedCustodian<b> as </b><span style=\"color: maroon\">assignedCustodian</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      assignedCustodian.representedCustodianOrganization<b> as </b><span style=\"color: maroon\">representedOrg</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">custodianOrgEntry</span><span style=\"color: navy\">, </span> custodianOrgEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">custodianOrganization</span><span style=\"color: navy\">, </span> custodianOrganization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> custodianOrgEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %custodianOrganization.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        representedOrg<b> then </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrg</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">custodianOrganization</span><span style=\"color: navy\">)</span> <i>\"custodianOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n        representedOrg<span style=\"color: navy\"><b> -&gt; </b></span> composition.custodian = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">custodianRef</span><span style=\"color: navy\">, </span> custodianRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %custodianOrganization.id<span style=\"color: navy\">)</span> <i>\"custodianRef\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"custodianOrganizationResource\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DE L’AUTEUR DU DOCUMENT CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite le bloc author de l’en-tête CDA.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si le bloc author existe, il crée un Practitioner pour représenter l’auteur.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si author.assignedAuthor.representedOrganization est présent, il crée aussi</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   une Organization et un PractitionerRole afin de représenter l’auteur dans son</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   organisation.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   La Composition référence ensuite le PractitionerRole si l’organisation existe,</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   sinon elle référence directement le Practitioner.</span>#xD;\n<b>group </b>MapHeaderAuthor<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.author<b> as </b><span style=\"color: maroon\">author</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    author.assignedAuthor<b> as </b><span style=\"color: maroon\">assignedAuthor</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">practitionerEntry</span><span style=\"color: navy\">, </span> practitionerEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Practitioner'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">authorPractitioner</span><span style=\"color: navy\">, </span> authorPractitioner.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> practitionerEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorPractitioner.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedAuthor -&gt; FHIR Practitioner</span>#xD;\n      assignedAuthor<b> then </b>MapCDAAssignedEntityToPractitioner<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedAuthor</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorPractitioner</span><span style=\"color: navy\">)</span> <i>\"authorPractitioner\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA representedOrganization présent -&gt; FHIR Organization + PractitionerRole</span>#xD;\n      assignedAuthor.representedOrganization<b> as </b><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">organizationEntry</span><span style=\"color: navy\">, </span> organizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">authorOrganization</span><span style=\"color: navy\">, </span> authorOrganization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> organizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorOrganization.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">roleEntry</span><span style=\"color: navy\">, </span> roleEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'PractitionerRole'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">authorRole</span><span style=\"color: navy\">, </span> authorRole.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> roleEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorRole.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        representedOrganization<b> then </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorOrganization</span><span style=\"color: navy\">)</span> <i>\"authorOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n        assignedAuthor<b> then </b>MapCDAAssignedEntityToPractitionerRole<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedAuthor</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorPractitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">authorOrganization</span><span style=\"color: navy\">)</span> <i>\"authorRole\"</i><span style=\"color: navy\">;</span>#xD;\n        assignedAuthor<span style=\"color: navy\"><b> -&gt; </b></span> composition.author<b> as </b><span style=\"color: maroon\">authorRef</span><span style=\"color: navy\">, </span> authorRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorRole.id<span style=\"color: navy\">)</span> <i>\"compositionAuthorRoleRef\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"authorWithOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA author sans representedOrganization -&gt; référence directe au Practitioner</span>#xD;\n      assignedAuthor<b> where </b>assignedAuthor.representedOrganization.empty()<span style=\"color: navy\"><b> -&gt; </b></span> composition.author<b> as </b><span style=\"color: maroon\">authorRef</span><span style=\"color: navy\">, </span> authorRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %authorPractitioner.id<span style=\"color: navy\">)</span> <i>\"compositionAuthorPractitionerRef\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"authorPractitionerResource\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DU SIGNATAIRE LÉGAL CDA</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite le bloc legalAuthenticator de l’en-tête CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si le bloc legalAuthenticator existe, il crée un Practitioner pour représenter</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   le signataire légal. Si legalAuthenticator.assignedEntity.representedOrganization</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   est présent, il crée aussi une Organization et un PractitionerRole.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   La Composition est alimentée via Composition.attester. La partie attester.party</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   référence le PractitionerRole si l’organisation existe, sinon elle référence</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   directement le Practitioner.</span>#xD;\n<b>group </b>MapHeaderLegalAuthenticator<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.legalAuthenticator<b> as </b><span style=\"color: maroon\">legalAuthenticator</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    legalAuthenticator.assignedEntity<b> as </b><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">practitionerEntry</span><span style=\"color: navy\">, </span> practitionerEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Practitioner'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">legalPractitioner</span><span style=\"color: navy\">, </span> legalPractitioner.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> practitionerEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalPractitioner.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity -&gt; FHIR Practitioner</span>#xD;\n      assignedEntity<b> then </b>MapCDAAssignedEntityToPractitioner<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalPractitioner</span><span style=\"color: navy\">)</span> <i>\"legalPractitioner\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA legalAuthenticator -&gt; FHIR Composition.attester</span>#xD;\n      legalAuthenticator<span style=\"color: navy\"><b> -&gt; </b></span>composition.attester<b> as </b><span style=\"color: maroon\">attester</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        legalAuthenticator<span style=\"color: navy\"><b> -&gt; </b></span>attester.mode = <span style=\"color: blue\">'legal'</span> <i>\"mode\"</i><span style=\"color: navy\">;</span>#xD;\n        legalAuthenticator.time<b> as </b><span style=\"color: maroon\">time</span><span style=\"color: navy\"><b> -&gt; </b></span>attester.time = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'dateTime'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">dt</span><b> then </b>TSDateTime<span style=\"color: navy\">(</span><span style=\"color: maroon\">time</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">dt</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">// </span><span style=\"color: green\">CDA representedOrganization présent -&gt; Organization + PractitionerRole + attester.party</span>#xD;\n        assignedEntity.representedOrganization<b> as </b><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">organizationEntry</span><span style=\"color: navy\">, </span> organizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">legalOrganization</span><span style=\"color: navy\">, </span> legalOrganization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> organizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalOrganization.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">roleEntry</span><span style=\"color: navy\">, </span> roleEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'PractitionerRole'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">legalRole</span><span style=\"color: navy\">, </span> legalRole.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> roleEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalRole.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          representedOrganization<b> then </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">representedOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalOrganization</span><span style=\"color: navy\">)</span> <i>\"legalOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n          assignedEntity<b> then </b>MapCDAAssignedEntityToPractitionerRole<span style=\"color: navy\">(</span><span style=\"color: maroon\">assignedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalRole</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalPractitioner</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">legalOrganization</span><span style=\"color: navy\">)</span> <i>\"legalRole\"</i><span style=\"color: navy\">;</span>#xD;\n          assignedEntity<span style=\"color: navy\"><b> -&gt; </b></span> attester.party = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">partyRef</span><span style=\"color: navy\">, </span> partyRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalRole.id<span style=\"color: navy\">)</span> <i>\"partyRole\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"legalWithOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">// </span><span style=\"color: green\">CDA legalAuthenticator sans representedOrganization -&gt; attester.party référence le Practitioner</span>#xD;\n        assignedEntity<b> where </b>assignedEntity.representedOrganization.empty()<span style=\"color: navy\"><b> -&gt; </b></span> attester.party = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">partyRef</span><span style=\"color: navy\">, </span> partyRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %legalPractitioner.id<span style=\"color: navy\">)</span> <i>\"partyPractitioner\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"attester\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"legalPractitionerResource\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DE L’ÉVÉNEMENT DOCUMENTÉ CDA</span>#xD;\n<b>group </b>MapHeaderDocumentationOf<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.documentationOf<b> as </b><span style=\"color: maroon\">documentationOf</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    documentationOf.serviceEvent<b> as </b><span style=\"color: maroon\">serviceEvent</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.event<b> as </b><span style=\"color: maroon\">event</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA serviceEvent.code -&gt; FHIR Composition.event.code</span>#xD;\n      serviceEvent.code<b> as </b><span style=\"color: maroon\">eventCode</span><span style=\"color: navy\"><b> -&gt; </b></span>event.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">cc</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">eventCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">cc</span><span style=\"color: navy\">)</span> <i>\"eventCode\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA serviceEvent.effectiveTime -&gt; FHIR Composition.event.period</span>#xD;\n      serviceEvent.effectiveTime<b> as </b><span style=\"color: maroon\">eff</span><span style=\"color: navy\"><b> -&gt; </b></span>event.period = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">period</span><b> then </b>IVLTSPeriod<span style=\"color: navy\">(</span><span style=\"color: maroon\">eff</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">period</span><span style=\"color: navy\">)</span> <i>\"eventPeriod\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"event\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DU CONTEXTE DE PRISE EN CHARGE CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite le bloc componentOf.encompassingEncounter de l’en-tête CDA.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si encompassingEncounter existe, il crée une ressource Encounter et l’associe</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   à la Composition.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Le remplissage générique de l’Encounter est délégué au groupe commun :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   MapCDAEncompassingEncounterToEncounter.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si encompassingEncounter.location.healthCareFacility est également présent,</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   il crée une Location et une Organization pour représenter le lieu et la</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   structure de prise en charge, puis appelle :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   MapCDAHealthCareFacilityToLocationContext.</span>#xD;\n<b>group </b>MapHeaderEncounterContext<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.componentOf<b> as </b><span style=\"color: maroon\">componentOf</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    componentOf.encompassingEncounter<b> as </b><span style=\"color: maroon\">encompassingEncounter</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">encounterEntry</span><span style=\"color: navy\">, </span> encounterEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Encounter'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">encounter</span><span style=\"color: navy\">, </span> encounter.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> encounterEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %encounter.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter -&gt; FHIR Composition.encounter</span>#xD;\n      encompassingEncounter<span style=\"color: navy\"><b> -&gt; </b></span> composition.encounter = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">encRef</span><span style=\"color: navy\">, </span> encRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %encounter.id<span style=\"color: navy\">)</span> <i>\"compositionEncounterRef\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter -&gt; FHIR Encounter générique</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">Ce groupe commun alimente identifier, subject, status, class et period.</span>#xD;\n      encompassingEncounter<b> then </b>MapCDAEncompassingEncounterToEncounter<span style=\"color: navy\">(</span><span style=\"color: maroon\">encompassingEncounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">encounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"encounterBase\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility présent -&gt; FHIR Location + Organization</span>#xD;\n      encompassingEncounter.location<b> as </b><span style=\"color: maroon\">srcLocation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        srcLocation.healthCareFacility<b> as </b><span style=\"color: maroon\">facility</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">locationEntry</span><span style=\"color: navy\">, </span> locationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Location'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">location</span><span style=\"color: navy\">, </span> location.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> locationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %location.id<span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> bundle.entry<b> as </b><span style=\"color: maroon\">facilityOrganizationEntry</span><span style=\"color: navy\">, </span> facilityOrganizationEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Organization'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">facilityOrganization</span><span style=\"color: navy\">, </span> facilityOrganization.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> facilityOrganizationEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %facilityOrganization.id<span style=\"color: navy\">)</span><b> then </b>MapCDAHealthCareFacilityToLocationContext<span style=\"color: navy\">(</span><span style=\"color: maroon\">facility</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">encounter</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">location</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">facilityOrganization</span><span style=\"color: navy\">)</span> <i>\"facilityContext\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"encounterResource\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE COMMUN — ENCOMPASSINGENCOUNTER CDA VERS ENCOUNTER FHIR</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe transforme les informations génériques du bloc CDA</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   componentOf.encompassingEncounter vers une ressource FHIR Encounter déjà créée</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   par le groupe appelant.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Il alimente :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Encounter.identifier ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Encounter.subject ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Encounter.status ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Encounter.class ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Encounter.period.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si le code CDA de l’encompassingEncounter est absent, Encounter.class est</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   créé avec l’extension data-absent-reason afin de respecter l’obligation FHIR</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   sans inventer une information absente du CDA</span>#xD;\n<b>group </b>MapCDAEncompassingEncounterToEncounter<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">encompassingEncounter</span><span style=\"color: navy\"> : </span>EncompassingEncounter, <b>target</b> <span style=\"color: maroon\">encounter</span><span style=\"color: navy\"> : </span>Encounter, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter.id -&gt; FHIR Encounter.identifier</span>#xD;\n  encompassingEncounter.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>encounter.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    id<span style=\"color: navy\"><b> -&gt; </b></span>identifier<b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"baseIdentifier\"</i><span style=\"color: navy\">;</span>#xD;\n    id<span style=\"color: navy\"><b> -&gt; </b></span>identifier.type = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">idType</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      id<span style=\"color: navy\"><b> -&gt; </b></span>idType.coding = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        id<span style=\"color: navy\"><b> -&gt; </b></span>coding.system = <span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/v2-0203'</span> <i>\"system\"</i><span style=\"color: navy\">;</span>#xD;\n        id<span style=\"color: navy\"><b> -&gt; </b></span>coding.code = <span style=\"color: blue\">'VN'</span> <i>\"code\"</i><span style=\"color: navy\">;</span>#xD;\n        id<span style=\"color: navy\"><b> -&gt; </b></span>coding.display = <span style=\"color: blue\">'Visit number'</span> <i>\"display\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"coding\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"type\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter -&gt; FHIR Encounter.subject</span>#xD;\n  encompassingEncounter<span style=\"color: navy\"><b> -&gt; </b></span> encounter.subject = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">subjectRef</span><span style=\"color: navy\">, </span> subjectRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"subject\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter -&gt; FHIR Encounter.status</span>#xD;\n  encompassingEncounter<span style=\"color: navy\"><b> -&gt; </b></span>encounter.status = <span style=\"color: blue\">'finished'</span> <i>\"status\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter.code -&gt; FHIR Encounter.class</span>#xD;\n  encompassingEncounter.code<b> as </b><span style=\"color: maroon\">srcCode</span><span style=\"color: navy\"><b> -&gt; </b></span>encounter.class = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then </b>CDCoding<span style=\"color: navy\">(</span><span style=\"color: maroon\">srcCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">coding</span><span style=\"color: navy\">)</span> <i>\"class\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter.code absent -&gt; FHIR Encounter.class avec data-absent-reason</span>#xD;\n  encompassingEncounter<b> where </b>encompassingEncounter.code.empty()<span style=\"color: navy\"><b> -&gt; </b></span>encounter.class = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Coding'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">coding</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    encompassingEncounter<span style=\"color: navy\"><b> -&gt; </b></span>coding.extension = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Extension'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">absentReason</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      encompassingEncounter<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.url = <span style=\"color: blue\">'http://hl7.org/fhir/StructureDefinition/data-absent-reason'</span> <i>\"url\"</i><span style=\"color: navy\">;</span>#xD;\n      encompassingEncounter<span style=\"color: navy\"><b> -&gt; </b></span>absentReason.value = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'unknown'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'code'</span><span style=\"color: navy\">)</span> <i>\"valueCode\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"dataAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"classAbsentReason\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA encompassingEncounter.effectiveTime -&gt; FHIR Encounter.period</span>#xD;\n  encompassingEncounter.effectiveTime<b> as </b><span style=\"color: maroon\">effTime</span><b> where </b>effTime.value.exists() or effTime.low.exists() or effTime.high.exists()<span style=\"color: navy\"><b> -&gt; </b></span>encounter.period = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Period'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">period</span><b> then </b>IVLTSPeriod<span style=\"color: navy\">(</span><span style=\"color: maroon\">effTime</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">period</span><span style=\"color: navy\">)</span> <i>\"period\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DE LA PERSONNE À PRÉVENIR CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite les blocs informant.relatedEntity dont classCode = ECON.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si un informant ECON est présent dans le CDA, il crée une RelatedPerson pour</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   représenter la personne à prévenir en cas d’urgence, puis l’associe au Patient.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   La ressource RelatedPerson est donc créée uniquement si ce bloc CDA existe</span>#xD;\n<b>group </b>MapHeaderEmergencyContact<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.informant<b> as </b><span style=\"color: maroon\">informant</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    informant.relatedEntity<b> as </b><span style=\"color: maroon\">relatedEntity</span><b> where </b>relatedEntity.classCode = 'ECON'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">relatedPersonEntry</span><span style=\"color: navy\">, </span> relatedPersonEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'RelatedPerson'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">emergencyContactRelatedPerson</span><span style=\"color: navy\">, </span> emergencyContactRelatedPerson.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> relatedPersonEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %emergencyContactRelatedPerson.id<span style=\"color: navy\">)</span><b> then </b>MapCDARelatedEntityToRelatedPerson<span style=\"color: navy\">(</span><span style=\"color: maroon\">relatedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">emergencyContactRelatedPerson</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"relatedPersonECON\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DE LA PERSONNE DE CONFIANCE CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite les blocs informant.relatedEntity dont classCode = NOK.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si un informant NOK est présent dans le CDA, il crée une RelatedPerson pour</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   représenter la personne de confiance, puis l’associe au Patient.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   La ressource RelatedPerson est donc créée uniquement si ce bloc CDA existe.</span>#xD;\n<b>group </b>MapHeaderTrustedPerson<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.informant<b> as </b><span style=\"color: maroon\">informant</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    informant.relatedEntity<b> as </b><span style=\"color: maroon\">relatedEntity</span><b> where </b>relatedEntity.classCode = 'NOK'<span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">relatedPersonEntry</span><span style=\"color: navy\">, </span> relatedPersonEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'RelatedPerson'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">trustedPersonRelatedPerson</span><span style=\"color: navy\">, </span> trustedPersonRelatedPerson.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> relatedPersonEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %trustedPersonRelatedPerson.id<span style=\"color: navy\">)</span><b> then </b>MapCDARelatedEntityToRelatedPerson<span style=\"color: navy\">(</span><span style=\"color: maroon\">relatedEntity</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">trustedPersonRelatedPerson</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">patient</span><span style=\"color: navy\">)</span> <i>\"relatedPersonNOK\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DU GUARDIAN CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite le bloc recordTarget.patientRole.patient.guardian.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si un guardian est présent dans le CDA, il crée une RelatedPerson pour</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   représenter le représentant légal ou responsable du patient.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   La ressource RelatedPerson est donc créée uniquement si le bloc guardian existe</span>#xD;\n<b>group </b>MapHeaderGuardian<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.recordTarget<b> as </b><span style=\"color: maroon\">recordTarget</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    recordTarget.patientRole<b> as </b><span style=\"color: maroon\">patientRole</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      patientRole.patient<b> as </b><span style=\"color: maroon\">patientCda</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        patientCda.guardian<b> as </b><span style=\"color: maroon\">guardian</span><span style=\"color: navy\"><b> -&gt; </b></span> bundle.entry<b> as </b><span style=\"color: maroon\">guardianEntry</span><span style=\"color: navy\">, </span> guardianEntry.resource = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'RelatedPerson'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">guardianRelatedPerson</span><span style=\"color: navy\">, </span> guardianRelatedPerson.id = <b>uuid</b><span style=\"color: navy\">(</span><span style=\"color: navy\">)</span><span style=\"color: navy\">, </span> guardianEntry.fullUrl = <span style=\"color: navy\">(</span>'urn:uuid:' + %guardianRelatedPerson.id<span style=\"color: navy\">)</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          guardian<span style=\"color: navy\"><b> -&gt; </b></span> guardianRelatedPerson.patient = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patientRef</span><span style=\"color: navy\">, </span> patientRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"patientRef\"</i><span style=\"color: navy\">;</span>#xD;\n          guardian.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>guardianRelatedPerson.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n          guardian.addr<b> as </b><span style=\"color: maroon\">addr</span><span style=\"color: navy\"><b> -&gt; </b></span>guardianRelatedPerson.address = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Address'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">address</span><b> then </b>ADAddress<span style=\"color: navy\">(</span><span style=\"color: maroon\">addr</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">address</span><span style=\"color: navy\">)</span> <i>\"address\"</i><span style=\"color: navy\">;</span>#xD;\n          guardian.telecom<b> as </b><span style=\"color: maroon\">telecom</span><span style=\"color: navy\"><b> -&gt; </b></span>guardianRelatedPerson.telecom = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'ContactPoint'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">contactPoint</span><b> then </b>TELContactPoint<span style=\"color: navy\">(</span><span style=\"color: maroon\">telecom</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">contactPoint</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n          guardian.guardianPerson<b> as </b><span style=\"color: maroon\">guardianPerson</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>            guardianPerson.name<b> as </b><span style=\"color: maroon\">name</span><span style=\"color: navy\"><b> -&gt; </b></span>guardianRelatedPerson.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'HumanName'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">humanName</span><b> then </b>ENHumanName<span style=\"color: navy\">(</span><span style=\"color: maroon\">name</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">humanName</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n          <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"guardianResource\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE — TRAITEMENT DU DOCUMENT LIÉ CDA</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite le bloc relatedDocument du CDA.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Si relatedDocument est présent, il alimente Composition.relatesTo afin de</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   représenter le lien avec un document antérieur, par exemple un document</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   remplacé.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe ne crée pas de ressource FHIR indépendante. Il complète uniquement</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   la Composition déjà initialisée</span>#xD;\n<b>group </b>MapHeaderRelatedDocument<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.relatedDocument<b> as </b><span style=\"color: maroon\">relatedDoc</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.relatesTo<b> as </b><span style=\"color: maroon\">relatesTo</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedDocument.typeCode=RPLC -&gt; FHIR Composition.relatesTo.code</span>#xD;\n    relatedDoc.typeCode<b> as </b><span style=\"color: maroon\">typeCode</span><b> where </b>typeCode = 'RPLC'<span style=\"color: navy\"><b> -&gt; </b></span>relatesTo.code = <span style=\"color: blue\">'replaces'</span> <i>\"replaces\"</i><span style=\"color: navy\">;</span>#xD;\n    relatedDoc.parentDocument<b> as </b><span style=\"color: maroon\">parentDoc</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedDocument.parentDocument.id -&gt; FHIR Composition.relatesTo.targetIdentifier</span>#xD;\n      parentDoc.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>relatesTo.target = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"targetIdentifier\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE COMMUN — ORGANISATION CDA VERS ORGANIZATION FHIR</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe transforme un élément CDA de type organisation vers une ressource</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   FHIR Organization déjà créée par le groupe appelant.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Il alimente les informations génériques de l’organisation :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   identifier, name, telecom et address</span>#xD;\n<b>group </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">organization</span><span style=\"color: navy\"> : </span>Organization<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA organization.id -&gt; FHIR Organization.identifier</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>organization.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA organization.name -&gt; FHIR Organization.name</span>#xD;\n  src.name<b> as </b><span style=\"color: maroon\">orgName</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    orgName.item<b> as </b><span style=\"color: maroon\">item</span><span style=\"color: navy\"><b> -&gt; </b></span>organization.name = <span style=\"color: navy\">(</span>item.xmlText<span style=\"color: navy\">)</span> <i>\"name\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"orgName\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA organization.telecom -&gt; FHIR Organization.telecom</span>#xD;\n  src.telecom<b> as </b><span style=\"color: maroon\">srcTelecom</span><span style=\"color: navy\"><b> -&gt; </b></span>organization.telecom = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'ContactPoint'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">contactPoint</span><b> then </b>TELContactPoint<span style=\"color: navy\">(</span><span style=\"color: maroon\">srcTelecom</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">contactPoint</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA organization.addr -&gt; FHIR Organization.address</span>#xD;\n  src.addr<b> as </b><span style=\"color: maroon\">srcAddr</span><span style=\"color: navy\"><b> -&gt; </b></span>organization.address = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Address'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">address</span><b> then </b>ADAddress<span style=\"color: navy\">(</span><span style=\"color: maroon\">srcAddr</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">address</span><span style=\"color: navy\">)</span> <i>\"address\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE COMMUN — ASSIGNEDENTITY CDA VERS PRACTITIONER FHIR</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe transforme un élément CDA de type assignedEntity vers une ressource</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   FHIR Practitioner déjà créée par le groupe appelant.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Il alimente les informations génériques du professionnel :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   identifier, address, telecom et name</span>#xD;\n<b>group </b>MapCDAAssignedEntityToPractitioner<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">practitioner</span><span style=\"color: navy\"> : </span>Practitioner<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity.id -&gt; FHIR Practitioner.identifier</span>#xD;\n  src.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>practitioner.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity.addr -&gt; FHIR Practitioner.address</span>#xD;\n  src.addr<b> as </b><span style=\"color: maroon\">addr</span><span style=\"color: navy\"><b> -&gt; </b></span>practitioner.address = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Address'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">address</span><b> then </b>ADAddress<span style=\"color: navy\">(</span><span style=\"color: maroon\">addr</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">address</span><span style=\"color: navy\">)</span> <i>\"address\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity.telecom -&gt; FHIR Practitioner.telecom</span>#xD;\n  src.telecom<b> as </b><span style=\"color: maroon\">telecom</span><span style=\"color: navy\"><b> -&gt; </b></span>practitioner.telecom = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'ContactPoint'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">contactPoint</span><b> then </b>TELContactPoint<span style=\"color: navy\">(</span><span style=\"color: maroon\">telecom</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">contactPoint</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  src.assignedPerson<b> as </b><span style=\"color: maroon\">person</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedPerson.name -&gt; FHIR Practitioner.name</span>#xD;\n    person.name<b> as </b><span style=\"color: maroon\">pName</span><span style=\"color: navy\"><b> -&gt; </b></span>practitioner.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'HumanName'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">humanName</span><b> then </b>ENHumanName<span style=\"color: navy\">(</span><span style=\"color: maroon\">pName</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">humanName</span><span style=\"color: navy\">)</span> <i>\"assignedName\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE COMMUN — ASSIGNEDENTITY CDA VERS PRACTITIONERROLE FHIR</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe transforme le lien fonctionnel porté par un assignedEntity CDA vers</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   une ressource FHIR PractitionerRole déjà créée par le groupe appelant.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Il alimente les références PractitionerRole.practitioner et</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   PractitionerRole.organization à partir des ressources Practitioner et</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Organization déjà créées</span>#xD;\n<b>group </b>MapCDAAssignedEntityToPractitionerRole<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">role</span><span style=\"color: navy\"> : </span>PractitionerRole, <b>target</b> <span style=\"color: maroon\">practitioner</span><span style=\"color: navy\"> : </span>Practitioner, <b>target</b> <span style=\"color: maroon\">organization</span><span style=\"color: navy\"> : </span>Organization<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA assignedEntity -&gt; FHIR PractitionerRole.practitioner</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span> role.practitioner = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">refPractitioner</span><span style=\"color: navy\">, </span> refPractitioner.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %practitioner.id<span style=\"color: navy\">)</span> <i>\"practitionerRef\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA representedOrganization -&gt; FHIR PractitionerRole.organization</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span> role.organization = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">refOrganization</span><span style=\"color: navy\">, </span> refOrganization.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %organization.id<span style=\"color: navy\">)</span> <i>\"organizationRef\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE COMMUN — RELATEDENTITY CDA VERS RELATEDPERSON FHIR</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe transforme un relatedEntity CDA vers une ressource FHIR RelatedPerson</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   déjà créée par le groupe appelant.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Il alimente le lien avec le Patient ainsi que les informations génériques :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   identifier, address, telecom et name.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Le champ relationship n’est pas alimenté dans cette étape afin d’éviter un</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   double mapping. Il est enrichi ensuite dans l’étape française avec le système</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   NOS approprié</span>#xD;\n<b>group </b>MapCDARelatedEntityToRelatedPerson<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">relatedEntity</span><span style=\"color: navy\"> : </span>RelatedEntity, <b>target</b> <span style=\"color: maroon\">relatedPerson</span><span style=\"color: navy\"> : </span>RelatedPerson, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedEntity -&gt; FHIR RelatedPerson.patient</span>#xD;\n  relatedEntity<span style=\"color: navy\"><b> -&gt; </b></span> relatedPerson.patient = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">patientRef</span><span style=\"color: navy\">, </span> patientRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %patient.id<span style=\"color: navy\">)</span> <i>\"patientRef\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedEntity.id -&gt; FHIR RelatedPerson.identifier</span>#xD;\n  relatedEntity.id<b> as </b><span style=\"color: maroon\">id</span><span style=\"color: navy\"><b> -&gt; </b></span>relatedPerson.identifier = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Identifier'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">identifier</span><b> then </b>II<span style=\"color: navy\">(</span><span style=\"color: maroon\">id</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">identifier</span><span style=\"color: navy\">)</span> <i>\"identifier\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedEntity.code -&gt; non mappé en étape 2</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Le lien métier de parenté est enrichi en étape 3 pour éviter un double RelatedPerson.relationship.</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedEntity.addr -&gt; FHIR RelatedPerson.address</span>#xD;\n  relatedEntity.addr<b> as </b><span style=\"color: maroon\">addr</span><span style=\"color: navy\"><b> -&gt; </b></span>relatedPerson.address = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Address'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">address</span><b> then </b>ADAddress<span style=\"color: navy\">(</span><span style=\"color: maroon\">addr</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">address</span><span style=\"color: navy\">)</span> <i>\"address\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedEntity.telecom -&gt; FHIR RelatedPerson.telecom</span>#xD;\n  relatedEntity.telecom<b> as </b><span style=\"color: maroon\">telecom</span><span style=\"color: navy\"><b> -&gt; </b></span>relatedPerson.telecom = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'ContactPoint'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">contactPoint</span><b> then </b>TELContactPoint<span style=\"color: navy\">(</span><span style=\"color: maroon\">telecom</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">contactPoint</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  relatedEntity.relatedPerson<b> as </b><span style=\"color: maroon\">person</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA relatedPerson.name -&gt; FHIR RelatedPerson.name</span>#xD;\n    person.name<b> as </b><span style=\"color: maroon\">name</span><span style=\"color: navy\"><b> -&gt; </b></span>relatedPerson.name = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'HumanName'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">humanName</span><b> then </b>ENHumanName<span style=\"color: navy\">(</span><span style=\"color: maroon\">name</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">humanName</span><span style=\"color: navy\">)</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">GROUPE COMMUN — HEALTHCAREFACILITY CDA VERS CONTEXTE DE LIEU FHIR</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Ce groupe traite le bloc healthCareFacility du CDA.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Il complète les ressources Encounter, Location et Organization déjà créées</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   par le groupe appelant lorsque le bloc healthCareFacility existe.</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Il alimente notamment :</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Encounter.location ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Encounter.serviceProvider ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Location.managingOrganization ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Location.name ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Location.type ;</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   - Organization représentant la structure de prise en charge.</span>#xD;\n<b>group </b>MapCDAHealthCareFacilityToLocationContext<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">facility</span><span style=\"color: navy\"> : </span>HealthCareFacility, <b>target</b> <span style=\"color: maroon\">encounter</span><span style=\"color: navy\"> : </span>Encounter, <b>target</b> <span style=\"color: maroon\">location</span><span style=\"color: navy\"> : </span>Location, <b>target</b> <span style=\"color: maroon\">facilityOrganization</span><span style=\"color: navy\"> : </span>Organization<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility -&gt; FHIR Encounter.location.location</span>#xD;\n  facility<span style=\"color: navy\"><b> -&gt; </b></span>encounter.location<b> as </b><span style=\"color: maroon\">encLocation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    facility<span style=\"color: navy\"><b> -&gt; </b></span> encLocation.location = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">locRef</span><span style=\"color: navy\">, </span> locRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %location.id<span style=\"color: navy\">)</span> <i>\"locationRef\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"encounterLocation\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility -&gt; FHIR Encounter.serviceProvider</span>#xD;\n  facility<span style=\"color: navy\"><b> -&gt; </b></span> encounter.serviceProvider = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">orgRef</span><span style=\"color: navy\">, </span> orgRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %facilityOrganization.id<span style=\"color: navy\">)</span> <i>\"serviceProvider\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility -&gt; FHIR Location.managingOrganization</span>#xD;\n  facility<span style=\"color: navy\"><b> -&gt; </b></span> location.managingOrganization = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Reference'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">managingOrgRef</span><span style=\"color: navy\">, </span> managingOrgRef.reference = <span style=\"color: navy\">(</span>'urn:uuid:' + %facilityOrganization.id<span style=\"color: navy\">)</span> <i>\"managingOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n  facility.location<b> as </b><span style=\"color: maroon\">facilityLocation</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility.location.name -&gt; FHIR Location.name</span>#xD;\n    facilityLocation.name<b> as </b><span style=\"color: maroon\">locName</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      locName.item<b> as </b><span style=\"color: maroon\">item</span><span style=\"color: navy\"><b> -&gt; </b></span>location.name = <span style=\"color: navy\">(</span>item.xmlText<span style=\"color: navy\">)</span> <i>\"locationName\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"locationName\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"facilityLocation\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA healthCareFacility.code -&gt; FHIR Location.type</span>#xD;\n  facility.code<b> as </b><span style=\"color: maroon\">facilityCode</span><span style=\"color: navy\"><b> -&gt; </b></span>location.type = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">cc</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">facilityCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">cc</span><span style=\"color: navy\">)</span> <i>\"locationType\"</i><span style=\"color: navy\">;</span>#xD;\n  facility.serviceProviderOrganization<b> as </b><span style=\"color: maroon\">serviceProviderOrganization</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA serviceProviderOrganization -&gt; FHIR Organization</span>#xD;\n    serviceProviderOrganization<b> then </b>MapCDAOrganizationToOrganization<span style=\"color: navy\">(</span><span style=\"color: maroon\">serviceProviderOrganization</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">facilityOrganization</span><span style=\"color: navy\">)</span> <i>\"facilityOrganization\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CORPS CDA -&gt; SECTIONS FHIR</span>#xD;\n#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Cette partie transforme uniquement le squelette du structuredBody CDA.</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">   Les entries métier ne sont pas transformées dans l’étape 2</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">CDA component.structuredBody -&gt; FHIR Composition.section</span>#xD;\n<b>group </b>MapClinicalDocumentBody<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>ClinicalDocument, <b>target</b> <span style=\"color: maroon\">composition</span><span style=\"color: navy\"> : </span>Composition, <b>target</b> <span style=\"color: maroon\">bundle</span><span style=\"color: navy\"> : </span>Bundle, <b>target</b> <span style=\"color: maroon\">patient</span><span style=\"color: navy\"> : </span>Patient<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src.component<b> as </b><span style=\"color: maroon\">cdaComponent</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    cdaComponent.structuredBody<b> as </b><span style=\"color: maroon\">structuredBody</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      structuredBody.component<b> as </b><span style=\"color: maroon\">bodyComponent</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        bodyComponent.section<b> as </b><span style=\"color: maroon\">section</span><span style=\"color: navy\"><b> -&gt; </b></span>composition.section<b> as </b><span style=\"color: maroon\">compSection</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section.title/code/text -&gt; FHIR Composition.section</span>#xD;\n          section<b> then </b>MapCDASectionToCompositionSection<span style=\"color: navy\">(</span><span style=\"color: maroon\">section</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">compSection</span><span style=\"color: navy\">)</span> <i>\"sectionBase\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"bodyComponent\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">CDA section -&gt; FHIR Composition.section title/code/text</span>#xD;\n<b>group </b>MapCDASectionToCompositionSection<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">section</span>, <b>target</b> <span style=\"color: maroon\">compSection</span><span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section.title -&gt; FHIR Composition.section.title</span>#xD;\n  section.title<b> as </b><span style=\"color: maroon\">sectionTitle</span><span style=\"color: navy\"><b> -&gt; </b></span>compSection.title = <span style=\"color: navy\">(</span>sectionTitle.xmlText<span style=\"color: navy\">)</span> <i>\"sectionTitle\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section.code -&gt; FHIR Composition.section.code</span>#xD;\n  section.code<b> as </b><span style=\"color: maroon\">sectionCode</span><span style=\"color: navy\"><b> -&gt; </b></span>compSection.code = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'CodeableConcept'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">cc</span><b> then </b>CDCodeableConcept<span style=\"color: navy\">(</span><span style=\"color: maroon\">sectionCode</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">cc</span><span style=\"color: navy\">)</span> <i>\"sectionCode\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section.text -&gt; FHIR Composition.section.text</span>#xD;\n  section.text<b> as </b><span style=\"color: maroon\">sectionText</span><span style=\"color: navy\"><b> -&gt; </b></span>compSection.text = <b>create</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'Narrative'</span><span style=\"color: navy\">)</span><b> as </b><span style=\"color: maroon\">narrative</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section.text -&gt; FHIR Narrative.status</span>#xD;\n    sectionText<span style=\"color: navy\"><b> -&gt; </b></span>narrative.status = <span style=\"color: blue\">'generated'</span> <i>\"narrativeStatus\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">// </span><span style=\"color: green\">CDA section.text -&gt; FHIR Narrative.div</span>#xD;\n    sectionText<span style=\"color: navy\"><b> -&gt; </b></span>narrative.div = <b>cast</b><span style=\"color: navy\">(</span><span style=\"color: maroon\">sectionText</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'string'</span><span style=\"color: navy\">)</span> <i>\"narrativeDiv\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"sectionText\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span></pre></div>"
  ] ;
