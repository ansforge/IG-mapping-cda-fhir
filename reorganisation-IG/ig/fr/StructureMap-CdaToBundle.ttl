     fhir:StructureMap.group.typeMode [ fhir:value "none" ] ;
     fhir:StructureMap.group.documentation [ fhir:value "GROUPE D’ORCHESTRATION — TRAITEMENT DU CLINICALDOCUMENT CDA\n\n   Ce groupe permet de traiter le ClinicalDocument CDA en deux parties :\n   - l’en-tête CDA via l'appel du groupe MapClinicalDocumentHeader ;\n   - le corps CDA via l'appelle du groupe MapClinicalDocumentBody.\n\n   Les ressources initialisées dans le groupe d’entrée, Bundle, Composition et\n   Patient, servent de support de sortie pour le traitement CDA" ] ;
     fhir:StructureMap.group.input [
       fhir:index -1 ;
