       ] ;
       fhir:StructureMap.group.rule.dependent [
         fhir:index -1 ;
         fhir:StructureMap.group.rule.dependent.name [ fhir:value "MapClinicalDocumentBody" ] ;
         fhir:StructureMap.group.rule.dependent.variable [
           fhir:value "cda" ;
           fhir:index -1
         ], [
           fhir:value "composition" ;
           fhir:index -1
