@startuml
!pragma layout smetana

title Vue synthétique de l’architecture du fichier CdaToBundle.fml

hide stereotype

skinparam backgroundColor #F9FBFD
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #3D6D8E
skinparam ArrowThickness 1.5
skinparam roundcorner 18
skinparam nodesep 70
skinparam ranksep 60
skinparam linetype polyline

skinparam rectangle {
BorderColor #5A8FB0
BackgroundColor #DFF1FA
FontColor #16384C
FontStyle bold
}

skinparam folder<<output>> {
BorderColor #A8A8A8
BackgroundColor #F2F2F2
FontColor #333333
FontStyle bold
}

top to bottom direction

rectangle "Groupe TransformClinicalDocumentToFHIRDocument\n\nParamètres d’entrée\n• ClinicalDocument source\n• Bundle cible\n\nCréation interne\n• Composition FHIR\n• Patient FHIR" as Start

rectangle "Groupe OrchestrateClinicalDocumentTransformation\n\nRôle\n• recevoir les paramètres transmis\n• coordonner le mapping en appelant :\n  - MapClinicalDocumentHeader\n  - MapClinicalDocumentBody" as Orchestrate

together {
rectangle "Groupe MapClinicalDocumentHeader\n\nMapping générique de l’en-tête CDA\n\nAppel des groupes spécialisés\n• identité du document\n• description documentaire\n• patient / sujet du document\n• auteur, custodian, signataire\n• contexte de rencontre\n• personnes liées\n• documents liés" as Header

rectangle "Groupe MapClinicalDocumentBody\n\nMapping du squelette du corps CDA\n\nPour chaque section CDA\n• création d’une Composition.section\n• reprise de title, code et text" as Body
}

folder "Bundle FHIR généré\n\nContient :\n• Bundle\n• Composition\n• Patient\n• autres ressources FHIR\n\nRessources identifiées par uuid\net reliées par références internes" as Output <<output>>

Start--> Orchestrate : Paramètres transmis\nClinicalDocument\nPatient\nComposition\nBundle

Orchestrate--> Header
Orchestrate--> Body

Header--> Output
Body--> Output

@enduml
