       ] )
     ] [
       fhir:code [ fhir:v "II.displayable" ] ;
       fhir:display [ fhir:v "II.displayable" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Identifier.extension" ] ;
         fhir:display [ fhir:v "Identifier.extension(displayable)" ] ;
         fhir:equivalence [ fhir:v "relatedto" ] ;
         fhir:comment [ fhir:v "Porté dans une extension FHIR spécifique." ]
       ] )
     ] )
  ] ) . # 

